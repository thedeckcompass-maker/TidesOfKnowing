---
import type { AskLeiliaReadingType } from "../../lib/ask-leilia/readingTypes";

interface Props {
  readingType: AskLeiliaReadingType;
  action?: string;
  submitLabel?: string;
  questionPlaceholder?: string;
  contextPlaceholder?: string;
  showTierIntro?: boolean;
  showTierGuidance?: boolean;
}

const {
  readingType,
  action = "/api/ask-leilia/checkout",
  submitLabel = "Continue to Payment",
  questionPlaceholder = "Share the single question you would like explored through the cards.",
  contextPlaceholder,
  showTierIntro = true,
  showTierGuidance = true,
} = Astro.props;

const PERSONAL_GUIDANCE_LIFE_AREAS = [
  "Relationships",
  "Family",
  "Career",
  "Business",
  "Finances",
  "Health",
  "Personal Growth",
  "Spiritual Direction",
  "Other",
] as const;

const PERSONAL_GUIDANCE_LIFE_AREAS_STANDARD = PERSONAL_GUIDANCE_LIFE_AREAS.filter(
  (area) => area !== "Other",
);

const tierGuidance: Record<AskLeiliaReadingType, string> = {
  "one-question":
    "If you find yourself trying to ask several questions at once, the In-Depth Reading will usually provide a more satisfying result.",
  "in-depth":
    "If the questions that matter most feel larger than a connected situation — including what you may not yet know to ask — the Personal Guidance Reading may be the better choice.",
  "personal-guidance":
    "This comprehensive reading uses Leilia’s signature Waka Spread to explore the wider patterns shaping your path. You receive a written PDF with photographs of the spread.",
};
---

<form class="ask-request-form" method="post" action={action} enctype="multipart/form-data" data-ask-leilia-checkout>
  <input type="hidden" name="readingType" value={readingType} />

  {
    showTierIntro && readingType === "one-question" ? (
      <div class="ask-request-form__intro">
        <h3>One clear question often leads to the clearest answer.</h3>
        <p>
          Bring one clearly defined question and enough context for me to understand what is happening
          and what you most need clarity about. I will choose the spread and draw as many cards as the
          question requires. If you realise you are untangling several connected issues, the In-Depth
          Reading or Personal Guidance Reading will usually serve you better.
        </p>
      </div>
    ) : null
  }

  {
    showTierIntro && readingType === "in-depth" ? (
      <div class="ask-request-form__intro">
        <h3>Some situations need more than one contained answer.</h3>
        <p>
          Use this reading for a complex situation, a major decision, or connected concerns with more
          than one layer. You may follow several related questions, and different areas of life can be
          explored where they belong to the same situation. It is not limited to two areas, and it is
          not an unlimited list of unrelated questions.
        </p>
      </div>
    ) : null
  }

  {
    showTierIntro && readingType === "personal-guidance" ? (
      <div class="ask-request-form__intro">
        <h3>Bring what matters most — and leave room for what you have not yet asked.</h3>
        <p>
          This Personal Guidance Reading includes my signature Waka Spread, structured around the
          metaphor and mechanics of a vessel in motion. Share the questions, concerns, or areas of
          life that matter most; the reading is not confined to them. Drawing on my intuitive,
          journalistic, and business experience, I follow the wider patterns that emerge and help
          you see where you can make a meaningful choice.
        </p>
      </div>
    ) : null
  }

  <fieldset>
    <legend>Your details</legend>

    <label>
      Name (Required)
      <input name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required />
    </label>

    <label>
      Email (Required)
      <input name="email" type="email" autocomplete="email" maxlength="320" required />
    </label>
  </fieldset>

  {
    readingType === "one-question" ? (
      <>
        <fieldset>
          <legend>Your question</legend>

          <label>
            Your Question (Required, at least 10 characters)
            <textarea
              name="question"
              rows="6"
              maxlength="2000"
              minlength="10"
              required
              placeholder={questionPlaceholder}
            />
          </label>

          <label>
            Background (Optional)
            <textarea name="context" rows="5" maxlength="5000" placeholder={contextPlaceholder} />
            <span class="ask-request-form__helper">
              Include only the background that helps me understand your question. A few sentences are
              usually enough.
            </span>
          </label>
        </fieldset>

        <fieldset class="ask-request-form__fieldset--compact">
          <legend>Card preference (Required)</legend>

          <label class="ask-request-form__radio">
            <input type="radio" name="cardPreference" value="pull_for_me" required />
            <span>Please pull the cards for me</span>
          </label>

          <label class="ask-request-form__radio">
            <input type="radio" name="cardPreference" value="own_cards_attached" required />
            <span>I have attached my own cards</span>
          </label>

          <label class="ask-request-form__upload">
            Upload image of cards
            <input name="cardImage" type="file" accept="image/png,image/jpeg,image/webp" />
            <span class="ask-request-form__helper">
              If you're asking me to interpret cards you've already drawn, upload a clear photograph
              here. Otherwise, simply leave this blank and I'll draw the cards for you.
            </span>
          </label>
        </fieldset>
      </>
    ) : null
  }

  {
    readingType === "in-depth" ? (
      <>
        <fieldset>
          <legend>Your reading request</legend>

          <label>
            Primary Question (Required, at least 10 characters)
            <textarea
              name="primaryQuestion"
              rows="6"
              maxlength="2000"
              minlength="10"
              required
              placeholder="Share the primary question you would like explored through the cards."
            />
          </label>

          <label>
            Tell me what has brought you to this point.
            <textarea
              name="background"
              rows="6"
              maxlength="5000"
              placeholder="Describe the background, history, or circumstances surrounding your question."
            />
          </label>

          <label>
            What outcome or understanding are you hoping this reading will help you reach? (Required, at least 10 characters)
            <textarea
              name="outcome"
              rows="5"
              maxlength="2000"
              minlength="10"
              required
              placeholder="Describe what you hope this reading will clarify or help you move toward."
            />
          </label>

          <label>
            Is there anything you feel I should know before I begin? (Optional)
            <textarea
              name="beforeBegin"
              rows="4"
              maxlength="5000"
              placeholder="Share anything that would help me prepare before I begin your reading."
            />
          </label>
        </fieldset>
      </>
    ) : null
  }

  {
    readingType === "personal-guidance" ? (
      <>
        <fieldset>
          <legend class="ask-request-form__section-legend">Life areas</legend>

          <p class="ask-request-form__section-note">
            Select at least one area of life to focus on for this Personal Guidance Reading. I may
            also follow other themes that emerge through the reading.
          </p>

          <div class="ask-request-form__life-areas">
            <div class="ask-request-form__checkbox-grid" role="group" aria-label="Life areas">
              {
                PERSONAL_GUIDANCE_LIFE_AREAS_STANDARD.map((area) => (
                  <label class="ask-request-form__checkbox">
                    <input type="checkbox" name="lifeAreas" value={area} />
                    <span class="ask-request-form__checkbox-label">{area}</span>
                  </label>
                ))
              }
            </div>

            <div class="ask-request-form__checkbox-other">
              <label class="ask-request-form__checkbox">
                <input
                  type="checkbox"
                  name="lifeAreas"
                  value="Other"
                  data-life-area-other-toggle
                />
                <span class="ask-request-form__checkbox-label">Other</span>
              </label>
              <div class="ask-request-form__other-field" data-life-area-other-field hidden>
                <label>
                  Name the other life area (Required if Other is selected)
                  <input
                    type="text"
                    name="lifeAreaOther"
                    maxlength="100"
                    placeholder="Please specify..."
                    autocomplete="off"
                    disabled
                    data-life-area-other-input
                  />
                </label>
              </div>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="ask-request-form__section-legend">Questions</legend>

          <label>
            Questions or themes (Required unless you choose the option below; at least 10 characters if you write here)
            <textarea
              name="questions"
              rows="6"
              maxlength="2000"
              minlength="10"
              required
              placeholder="Share the questions, themes, or tensions you would like this reading to address."
            />
          </label>
          <label class="ask-request-form__checkbox ask-request-form__open-reading">
            <input type="checkbox" name="openGuidance" value="yes" data-open-guidance-toggle />
            <span class="ask-request-form__checkbox-label">
              I don't have a specific question. Please focus on the life area or areas I've selected.
            </span>
          </label>
          <p class="ask-request-form__section-note">
            Choose this if you would like the selected life area or areas to guide the reading.
            You can leave the questions box blank.
          </p>
        </fieldset>

        <fieldset>
          <legend class="ask-request-form__section-legend">Current circumstances</legend>

          <label>
            What is happening in your life at the moment that provides important context for this
            reading? (Optional)
            <textarea
              name="circumstances"
              rows="6"
              maxlength="5000"
              placeholder="Describe what is unfolding in your life right now and why it matters to this reading."
            />
          </label>
        </fieldset>

        <fieldset>
          <legend class="ask-request-form__section-legend">Looking ahead</legend>

          <label>
            Is there a particular decision, opportunity or change approaching that you'd like this
            reading to help illuminate? (Optional)
            <textarea
              name="lookingAhead"
              rows="5"
              maxlength="2000"
              placeholder="Describe any decision, transition, or opportunity you would like guidance on."
            />
          </label>
        </fieldset>

        <fieldset>
          <legend class="ask-request-form__section-legend">Anything else</legend>

          <label>
            Is there anything you definitely want me to address, or anything you feel would help me
            prepare before I begin? (Optional)
            <textarea
              name="important"
              rows="4"
              maxlength="5000"
              placeholder="Share anything else that would help me understand your situation before I begin."
            />
          </label>
        </fieldset>
      </>
    ) : null
  }

  {
    showTierGuidance ? (
      <aside class="ask-request-form__guidance" aria-label="Reading tier guidance">
        <p>{tierGuidance[readingType]}</p>
      </aside>
    ) : null
  }

  <div class="ask-request-form__error" role="alert" tabindex="-1" hidden data-checkout-error>
    <p data-checkout-error-message></p>
    <p data-checkout-support>If the problem continues, email <a href="mailto:hello@tidesofknowing.com">hello@tidesofknowing.com</a> and I will help you book.</p>
  </div>
  <button type="submit">{submitLabel}</button>
</form>

<script>
  let fieldErrorId = 0;

  function initAskLeiliaCheckout() {
    document.querySelectorAll<HTMLFormElement>("[data-ask-leilia-checkout]").forEach((form) => {
      if (form.dataset.checkoutBound === "true") return;
      form.dataset.checkoutBound = "true";

      const errorBox = form.querySelector<HTMLElement>("[data-checkout-error]");
      const errorMessage = form.querySelector<HTMLElement>("[data-checkout-error-message]");
      const supportMessage = form.querySelector<HTMLElement>("[data-checkout-support]");
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!errorBox || !errorMessage || !supportMessage || !submitButton) return;

      // Once the handler is ready, show our actionable messages instead of a browser tooltip.
      form.noValidate = true;

      const originalLabel = submitButton.textContent ?? "Continue to Payment";
      const showError = (message: string) => {
        errorMessage.textContent = message;
        supportMessage.hidden = false;
        errorBox.hidden = false;
        errorBox.focus();
      };

      const fieldContainer = (control: HTMLInputElement | HTMLTextAreaElement) =>
        control.name === "lifeAreas" || control.name === "cardPreference"
          ? control.closest("fieldset")
          : control.closest("label");

      const clearFieldError = (control: HTMLInputElement | HTMLTextAreaElement) => {
        const container = fieldContainer(control);
        container?.querySelector(":scope > .ask-request-form__field-error")?.remove();
        if (container?.getAttribute("aria-describedby")?.startsWith("ask-field-error-")) {
          container.removeAttribute("aria-describedby");
        }
        if (control.getAttribute("aria-describedby")?.startsWith("ask-field-error-")) {
          control.removeAttribute("aria-describedby");
        }
        control.removeAttribute("aria-invalid");
        if (control.name === "lifeAreas" || control.name === "cardPreference") {
          form.querySelectorAll<HTMLInputElement>(`input[name="${control.name}"]`).forEach((input) => {
            input.removeAttribute("aria-invalid");
            if (input.getAttribute("aria-describedby")?.startsWith("ask-field-error-")) {
              input.removeAttribute("aria-describedby");
            }
          });
        }
      };

      const markField = (control: HTMLInputElement | HTMLTextAreaElement, message: string) => {
        const container = fieldContainer(control);
        if (!container) return;
        clearFieldError(control);
        const error = document.createElement("span");
        error.className = "ask-request-form__field-error";
        error.id = `ask-field-error-${++fieldErrorId}`;
        error.textContent = message;
        if (control.name === "cardPreference") {
          const radios = container.querySelectorAll(".ask-request-form__radio");
          radios[radios.length - 1]?.after(error);
        } else if (control.name === "lifeAreas") {
          container.querySelector(".ask-request-form__section-note")?.after(error);
        } else {
          container.append(error);
        }
        control.setAttribute("aria-invalid", "true");
        control.setAttribute("aria-describedby", error.id);
        if (control.name === "lifeAreas" || control.name === "cardPreference") {
          container.setAttribute("aria-describedby", error.id);
        }
      };

      const validateFields = () => {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[aria-invalid="true"]').forEach(clearFieldError);
        const invalid: Array<HTMLInputElement | HTMLTextAreaElement> = [];
        const field = (name: string) =>
          form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
        const requireText = (name: string, label: string, minimum: number) => {
          const control = field(name);
          if (!control) return;
          const length = control.value.trim().length;
          if (length < minimum) {
            const message = length === 0
              ? `Please enter ${label}. Use at least ${minimum} characters.`
              : `Please add more to ${label}: at least ${minimum} characters are needed.`;
            markField(control, message);
            invalid.push(control);
          }
        };

        requireText("name", "your name", 2);
        const email = field("email");
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
          markField(email, "Please enter a valid email address.");
          invalid.push(email);
        }

        const readingType = field("readingType")?.value;
        if (readingType === "one-question") {
          requireText("question", "your question", 10);
          if (!form.querySelector('input[name="cardPreference"]:checked')) {
            const cardPreference = form.querySelector<HTMLInputElement>('input[name="cardPreference"]');
            if (cardPreference) {
              markField(cardPreference, "Please choose a card preference.");
              invalid.push(cardPreference);
            }
          }
        } else if (readingType === "in-depth") {
          requireText("primaryQuestion", "your primary question", 10);
          requireText("outcome", "the outcome or understanding you are hoping for", 10);
        } else if (readingType === "personal-guidance") {
          if (!form.querySelector('input[name="lifeAreas"]:checked')) {
            const lifeArea = form.querySelector<HTMLInputElement>('input[name="lifeAreas"]');
            if (lifeArea) {
              markField(lifeArea, "Please select at least one life area.");
              invalid.push(lifeArea);
            }
          }
          const other = form.querySelector<HTMLInputElement>('[data-life-area-other-input]');
          if (form.querySelector<HTMLInputElement>('[data-life-area-other-toggle]')?.checked && other && !other.value.trim()) {
            markField(other, "Please name the other life area you selected.");
            invalid.push(other);
          }
          const questions = field("questions");
          const openGuidance = form.querySelector<HTMLInputElement>('[data-open-guidance-toggle]')?.checked;
          if (questions && (!openGuidance || questions.value.trim().length > 0)) {
            if (!openGuidance && !questions.value.trim()) {
              markField(questions, "Please write at least 10 characters about your questions or choose the focus option below.");
              invalid.push(questions);
            } else {
              requireText("questions", "your questions or themes", 10);
            }
          }
        }

        if (invalid.length > 0) {
          errorMessage.textContent = "Please correct the highlighted fields before continuing to payment.";
          supportMessage.hidden = true;
          errorBox.hidden = false;
          invalid[0].focus();
          return false;
        }
        return true;
      };

      form.addEventListener("input", (event) => {
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
          clearFieldError(event.target);
          errorBox.hidden = true;
        }
      });
      form.addEventListener("change", (event) => {
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
          clearFieldError(event.target);
          errorBox.hidden = true;
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitButton.disabled) return;
        errorBox.hidden = true;
        if (!validateFields()) return;

        submitButton.disabled = true;
        submitButton.textContent = "Saving your request…";
        let redirecting = false;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          const result = await response.json() as {
            ok?: boolean;
            error?: string;
            paymentUrl?: string;
          };

          if (!response.ok || !result.ok) {
            showError(result.error || "Your request could not be saved. Please try again.");
            return;
          }

          const paymentUrl = new URL(result.paymentUrl ?? "");
          if (paymentUrl.protocol !== "https:" || paymentUrl.hostname !== "buy.stripe.com") {
            throw new Error("Unexpected payment destination");
          }
          redirecting = true;
          submitButton.textContent = "Opening secure payment…";
          window.location.assign(paymentUrl.href);
        } catch {
          showError("We could not connect to the booking service. Your answers are still here. Please try again.");
        } finally {
          if (!redirecting) {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        }
      });
    });
  }

  function initPersonalGuidanceLifeAreas() {
    const toggle = document.querySelector("[data-life-area-other-toggle]");
    const field = document.querySelector("[data-life-area-other-field]");
    const input = document.querySelector("[data-life-area-other-input]");

    if (
      !(toggle instanceof HTMLInputElement) ||
      !(field instanceof HTMLElement) ||
      !(input instanceof HTMLInputElement)
    ) {
      return;
    }

    const syncOtherField = () => {
      const isOtherSelected = toggle.checked;

      if (isOtherSelected) {
        field.hidden = false;
        field.classList.add("is-visible");
        input.disabled = false;
        input.required = true;
      } else {
        field.classList.remove("is-visible");
        input.required = false;
        input.disabled = true;
        input.value = "";
        window.setTimeout(() => {
          if (!toggle.checked) {
            field.hidden = true;
          }
        }, 200);
      }
    };

    if (toggle.dataset.bound !== "true") {
      toggle.dataset.bound = "true";
      toggle.addEventListener("change", syncOtherField);
    }

    syncOtherField();
  }

  function initOpenGuidanceChoice() {
    document.querySelectorAll<HTMLInputElement>("[data-open-guidance-toggle]").forEach((toggle) => {
      const questions = toggle.closest("fieldset")?.querySelector<HTMLTextAreaElement>('textarea[name="questions"]');
      if (!questions) return;
      const syncChoice = () => { questions.required = !toggle.checked; };
      if (toggle.dataset.bound !== "true") {
        toggle.dataset.bound = "true";
        toggle.addEventListener("change", syncChoice);
      }
      syncChoice();
    });
  }

  initPersonalGuidanceLifeAreas();
  initOpenGuidanceChoice();
  initAskLeiliaCheckout();
  document.addEventListener("astro:page-load", () => {
    initPersonalGuidanceLifeAreas();
    initOpenGuidanceChoice();
    initAskLeiliaCheckout();
  });
</script>
