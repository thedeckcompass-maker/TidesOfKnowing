---
interface Props {
  username?: string | null;
  imageUrl?: string | null;
  size?: number;
}

const {
  username = 'Community member',
  imageUrl = null,
  size = 40
} = Astro.props;

const safeSize = Math.min(96, Math.max(24, size));
const name = username?.trim() || 'Community member';

const initials = name
  .split(/\s+/)
  .slice(0, 2)
  .map(part => part.charAt(0).toLocaleUpperCase())
  .join('');

const safeImageUrl =
  imageUrl &&
  (imageUrl.startsWith('/') && !imageUrl.startsWith('//'))
    ? imageUrl
    : null;
---

<span
  class="community-member-avatar"
  role="img"
  aria-label={`${name}'s avatar`}
  style={`--avatar-size:${safeSize}px`}
>
  <span class="community-member-avatar__initials" aria-hidden="true">
    {initials}
  </span>
  {safeImageUrl && (
    <img
      src={safeImageUrl}
      alt=""
      width={safeSize}
      height={safeSize}
      loading="lazy"
      decoding="async"
    />
  )}
</span>

<style>
.community-member-avatar {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: var(--avatar-size);
  height: var(--avatar-size);
  overflow: hidden;
  border-radius: 50%;
  background: #dce8df;
  color: #315348;
  border: 1px solid #c4d5c8;
  vertical-align: middle;
}

.community-member-avatar__initials {
  font-family: inherit;
  font-size: calc(var(--avatar-size) * .34);
  font-weight: 650;
  line-height: 1;
  user-select: none;
}

.community-member-avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: inherit;
}
</style>
