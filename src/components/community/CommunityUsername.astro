---
interface Props { username: string | null; studioContext?: boolean; action?: string; draft?: string; error?: string; success?: boolean; compact?:boolean; }
const {username,studioContext=false,action=studioContext?'/community/account/?workspace=studio':'/community/account/',draft='',error='',success=false,compact=false}=Astro.props;
---
<section id="community-username-settings" class="community-username-settings" aria-labelledby="username-heading">
<h3 id="username-heading">Public community username</h3>
<p>{compact?'Shown with your community posts and replies. Your name and email remain private.':'Your community posts and replies use this name. Your private full name and email stay private. This is not a separate login and does not control your Studio or administrator access.'}</p>
{success && username ? <p class="studio-notice" role="status" tabindex="-1" data-username-confirmation>Username saved successfully: <strong>{username}</strong>.</p> : null}
{success && !username && !error ? <p role="alert">The save was confirmed, but your username could not be loaded on this page. <a href={action}>Refresh your account</a> before trying again. Your account and access are unchanged.</p> : null}
{username ? <p>Saved username: <strong>{username}</strong></p> : success && !error ? null : <form method="post" action={action} data-username-form novalidate>
 <input type="hidden" name="intent" value="choose-username" />
 <label for="community-username">Choose your public community username</label>
 <input id="community-username" name="username" type="text" value={draft} minlength="3" maxlength="24" pattern="[A-Za-z][A-Za-z0-9]{2,23}" autocomplete="username" required aria-describedby="username-help username-feedback" aria-invalid={Boolean(error)}/>
 <p id="username-help">{compact?'3–24 letters and numbers; start with a letter. Names must be unique regardless of capitals. Staff, system and owner names are reserved.':'Use 3-24 letters and numbers, starting with a letter. Capitals are kept for display; names are unique regardless of capitals. Staff, system and protected owner names are reserved. Existing usernames remain unchanged.'}</p>
 <p id="username-feedback" role="alert" tabindex="-1" data-username-feedback hidden={!error}>{error}</p>
 <button type="submit">Save community username</button>
 <p data-username-progress role="status" hidden>Saving your username…</p>
 </form>}
</section>
<script>
import {usernameError} from "../../lib/community/usernameRules";
document.querySelector<HTMLElement>('[data-username-confirmation]')?.focus();
for(const form of document.querySelectorAll<HTMLFormElement>('[data-username-form]')){
 const feedback=form.querySelector<HTMLElement>('[data-username-feedback]');
 const input=form.querySelector<HTMLInputElement>('[name=username]');
 const button=form.querySelector<HTMLButtonElement>('button[type=submit]');
 const progress=form.querySelector<HTMLElement>('[data-username-progress]');let saving=false;
 if(!feedback||!input||!button||!progress)continue;
 form.addEventListener('submit',async event=>{
  event.preventDefault();if(saving)return;const invalid=usernameError(input.value);if(invalid){feedback.textContent=invalid;feedback.hidden=false;input.setAttribute('aria-invalid','true');feedback.focus();return;}saving=true;button.disabled=true;form.setAttribute('aria-busy','true');feedback.hidden=true;progress.hidden=false;
  try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),credentials:'same-origin',headers:{Accept:'application/json'}});const result=await response.json();
   if(!response.ok||!result.ok)throw new Error(result.error||'Your username was not saved. Your entry is still here.');
   const destination=new URL(result.redirectTo,location.origin);if(destination.origin!==location.origin||!['/studio/account/','/community/account/'].includes(destination.pathname))throw new Error('Save confirmed, but navigation failed. Refresh your account to see your username.');
   form.dispatchEvent(new Event("account-form-saved",{bubbles:true}));location.assign(destination.href);
  }catch(error){feedback.textContent=error instanceof Error?error.message:'Your username was not saved. Your entry is still here.';feedback.hidden=false;input.setAttribute('aria-invalid','true');feedback.focus();}
  finally{saving=false;button.disabled=false;form.removeAttribute('aria-busy');progress.hidden=true;}
 });
}
</script>
<style>
.community-username-settings{margin-block:1.5rem;max-width:44rem}.community-username-settings form{display:grid;gap:1rem}.community-username-settings label{display:block;margin-top:.5rem;font-weight:700}.community-username-settings input{box-sizing:border-box;width:100%;min-height:3rem;padding:.8rem;font:inherit}.community-username-settings button{min-height:3rem;padding:.8rem 1.2rem;font:inherit;justify-self:start}.community-username-settings [role=alert]{padding:1rem;border-left:4px solid currentColor}.community-username-settings [hidden]{display:none}
</style>
