---
import DcsPublicLayout from '../layouts/DcsPublicLayout.astro';
import '../styles/dcs-auth.css';
const {mode,next,error='',message=''}=Astro.props;
const heading=mode==='confirm'?'Confirm your email':mode==='forgot'?'Set or reset your password':mode==='update'?'Choose your password':'Sign in';
const link='/auth/register/?mode=sign-in&method=link&redirectTo='+encodeURIComponent(mode!=='signin'?'/auth/password-update/':next);
---
<DcsPublicLayout page="checkout" title={heading+' | Tides of Knowing'} description="One account for Tides of Knowing." metaRobots="noindex, nofollow">
<div class="page-inner dcs-auth"><section class="password-card" aria-labelledby="password-heading">
<p class="auth-kicker">Tides of Knowing · Deck Creator Studio</p><h1 id="password-heading">{heading}</h1>
{error&&<div class="password-notice password-notice--error" role="alert" tabindex="-1" data-password-notice><strong>{mode==='update'?'Password not saved':'Please check your details'}</strong><p>{error}</p></div>}{message&&<div class="password-notice" role="status" tabindex="-1" data-password-notice><strong>{message}</strong>{mode==='update'&&<p><a href={next}>Continue to your account</a> or <a href="/studio/">open Deck Creator Studio</a>.</p>}</div>}
{mode==='forgot'&&<p>Previously used email links? Set your first password using the same email address. Your account and access stay the same.</p>}
{mode==='confirm'&&<p>Already started registration? Request a fresh confirmation email for that same account. This does not create a new account or change your access.</p>}
{!message&&<form method="post" data-password-form>
{mode!=='update'&&<label>Email address<input name="email" type="email" autocomplete="username" required maxlength="254"/></label>}
{!['forgot','confirm'].includes(mode)&&<div class="password-field"><label for="account-password">{mode==='update'?'New password':'Password'}</label><div class="password-entry"><input id="account-password" name="password" type="password" autocomplete={mode==='update'?'new-password':'current-password'} required minlength={mode==='update'?12:undefined} maxlength="128"/><button class="password-toggle" type="button" data-password-toggle="account-password" data-password-label={mode==='update'?'new password':'password'} aria-controls="account-password" aria-pressed="false" aria-label={mode==='update'?'Show new password':'Show password'} hidden>Show password</button></div></div>}
{mode==='update'&&<><p>Use a unique password of 12-128 characters.</p><div class="password-field"><label for="account-password-confirm">Confirm password</label><div class="password-entry"><input id="account-password-confirm" name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/><button class="password-toggle" type="button" data-password-toggle="account-password-confirm" data-password-label="confirmation password" aria-controls="account-password-confirm" aria-pressed="false" aria-label="Show confirmation password" hidden>Show password</button></div></div></>}
{mode!=='update'&&<label class="remember-choice"><input type="checkbox" name="rememberMe"/> Keep me signed in on this browser</label>}
<button type="submit">{mode==='confirm'?'Send confirmation email':mode==='forgot'?'Send password setup / reset email':mode==='update'?'Save password':'Sign in'}</button>
<p role="status" data-password-progress hidden>Please wait.</p></form>}
{mode==='signin'?<nav class="signin-help" aria-label="Sign-in help"><div class="signin-help__main"><a href="/auth/forgot-password/">Forgot password?</a><a href="/auth/confirm-email/">Confirm your email</a><a href={"/auth/register/?redirectTo="+encodeURIComponent(next)}>Create an account</a></div><div class="signin-help__alternatives"><p>Never set a password? <a href="/auth/forgot-password/">Set your first password</a></p><a href={link}>Email me a secure sign-in link instead</a></div></nav>:<><p><a href={link}>Email me a secure sign-in link instead</a></p><p><a href="/auth/login/">Back to sign in</a></p></>}
</section></div></DcsPublicLayout>
<style>
.password-card{max-width:32rem;margin:clamp(2rem,6vw,5rem) auto;padding:clamp(1.25rem,4vw,2.5rem);border:1px solid #d9d4ca;border-radius:1rem;background:#17334d;color:#f7f1e7}h1{font-size:clamp(2rem,6vw,3rem);line-height:1.15}form{display:grid;gap:1.2rem;margin:1.5rem 0}label{display:grid;gap:.45rem}input{width:100%;box-sizing:border-box;font:inherit;padding:.8rem;border:1px solid #9da9b4;border-radius:.35rem;background:#0b2037;color:#f7f1e7}button{font:inherit;padding:.85rem 1rem;background:#c7a46a;color:#0b2037;border:0;border-radius:.35rem;cursor:pointer}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid #bd8c43;outline-offset:3px}p{line-height:1.6}
</style>

<script>
document.querySelector<HTMLElement>('[data-password-notice]')?.focus();
for(const form of document.querySelectorAll<HTMLFormElement>('[data-password-form]')){form.addEventListener('submit',event=>{if(form.dataset.submitting==='true'){event.preventDefault();return;}form.dataset.submitting='true';form.setAttribute('aria-busy','true');const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(button){button.disabled=true;button.textContent='Please wait.';}const status=form.querySelector<HTMLElement>('[data-password-progress]');if(status){status.hidden=false;status.textContent='Please wait while your request is processed.';}});}
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]')) {
 const input=document.getElementById(button.dataset.passwordToggle??'');
 if(!(input instanceof HTMLInputElement))continue;
 button.hidden=false;
 button.addEventListener('pointerdown',event=>{if(document.activeElement===input)event.preventDefault();});
 button.addEventListener('click',()=>{
  const start=input.selectionStart,end=input.selectionEnd;
  const visible=input.type==='password';input.type=visible?'text':'password';
  if(start!==null&&end!==null){input.setSelectionRange(start,end);requestAnimationFrame(()=>{if(document.activeElement===input)input.setSelectionRange(start,end);});}
  button.setAttribute('aria-pressed',String(visible));
  button.textContent=visible?'Hide password':'Show password';
  button.setAttribute('aria-label',(visible?'Hide ':'Show ')+(button.dataset.passwordLabel??'password'));
 });
}
</script>
<style>.password-toggle{justify-self:start;background:transparent;color:var(--tok-teal-light,#67C6E0);border:1px solid currentColor;padding:.45rem .7rem;font-size:.9rem}.password-toggle[hidden]{display:none}</style>
<style>.password-field{display:grid;gap:.45rem}.password-entry{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.password-entry input{flex:1 1 12rem;min-width:0}.password-entry .password-toggle{flex:0 0 auto;min-height:2.75rem}</style>

<style>.password-notice{border:2px solid var(--tok-gold,#C6A85A);padding:1rem;margin:1rem 0;background:#0b2037;color:#fff}.password-notice--error{border-color:#f2b7a9}.password-notice p{margin:.5rem 0 0}button:disabled{opacity:.7;cursor:wait}</style>

<style>.remember-choice{display:flex;align-items:center;gap:.6rem}.remember-choice input{width:auto;min-width:1rem}</style>

<style>.signin-help{display:grid;gap:.8rem;margin-top:1rem}.signin-help__main{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.4rem 1.25rem}.signin-help__main a{display:inline-flex;align-items:center;min-height:2.75rem;white-space:nowrap}.signin-help a{text-underline-offset:.2em}.signin-help__alternatives{display:grid;gap:.6rem;padding-top:1rem;border-top:1px solid #627180;font-size:.95rem}.signin-help__alternatives p{margin:0}.signin-help__alternatives>a{justify-self:start;line-height:1.55}.signin-help__alternatives p a{display:inline-block}</style>
