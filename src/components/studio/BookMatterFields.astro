---
import {bookMatter,BOOK_SURFACES,BOOK_FIELDS,resolvedBookFields} from '../../lib/studio/bookMatter';
const {section,sections=[]}=Astro.props;const matter=bookMatter(section),shared=resolvedBookFields(section,sections);
---
<details class="studio-field--full" data-book-matter><summary>Book placement, cover and publication details</summary>
 <p>Use the sections and surfaces your book needs. Shared title and creator details come from the front cover; enter a value here only to override them for this section.</p>
 <div class="studio-form studio-form--two">
 <label class="studio-field">Book surface<select name="book_surface">{Object.entries(BOOK_SURFACES).map(([value,label])=><option value={value} selected={matter.surface===value}>{label}</option>)}</select></label>
 <label class="studio-field">Book placement<select name="book_placement">{['front','body','back'].map(value=><option value={value} selected={matter.placement===value}>{value==='front'?'Front matter':value==='body'?'Main text':'Back matter'}</option>)}</select></label>
 <div class="studio-field--full" data-cover-format>
 <label class="studio-field">Book format<select name="book_format">{['undecided','digital','booklet','paperback','hardback','other'].map(value=><option value={value} selected={matter.format===value}>{value[0].toUpperCase()+value.slice(1)}</option>)}</select></label>
 <label class="studio-check"><input name="book_inside_covers" type="checkbox" checked={matter.insideCovers}/><span>This printed format has usable inside covers</span></label>
 <label class="studio-check"><input name="book_spine_allowed" type="checkbox" checked={matter.spineAllowed}/><span>The chosen binding has a printable spine</span></label>
 <p>Confirm the exact surfaces and templates with your printer. Screen pages do not set print dimensions or bleed.</p>
 </div>
 {(Object.entries(BOOK_FIELDS) as [keyof typeof BOOK_FIELDS,string][]).map(([key,label])=><label class="studio-field" data-book-detail={key}><span>{label}</span><textarea name={'book_'+key} rows={['blurb','credits','permissions'].includes(key)?3:1} maxlength="5000" placeholder={shared[key]?'Shared: '+shared[key]:''}>{matter.fields[key]??''}</textarea></label>)}
 <div class="studio-field--full" data-book-art><label class="studio-field">Cover or biography image<input type="file" accept="image/jpeg,image/png,image/webp" data-book-image-file/></label><input type="hidden" name="book_image" value={matter.image}/><input type="hidden" name="book_image_name" value={matter.imageName}/><img data-book-image-preview src={matter.image||undefined} alt="Current book image" hidden={!matter.image} style="max-width:240px;max-height:220px;object-fit:contain"/><button type="button" class="studio-button studio-button--secondary" data-book-image-remove>Remove current image</button><p data-book-image-status role="status">A working preview is saved with this section. Keep your source image for printing.</p></div>
 </div>
</details>
<script>
document.querySelectorAll<HTMLElement>('[data-book-matter]').forEach(root=>{
 const form=root.closest('form')!,surface=form.elements.namedItem('book_surface') as HTMLSelectElement;
 const refresh=()=>{const kind=surface.value,keys=kind==='copyright'?['textHolder','textYear','artHolder','artYear','edition','publisher','credits','permissions','isbn','identifier']:kind==='credits'?['credits']:kind==='back-cover'?['blurb','author','website','isbn','identifier']:kind==='author-bio'?['author','website']:kind==='artist-bio'?['artist','website']:['front-cover','title-page','spine'].includes(kind)?['bookTitle','subtitle','author','artist','imprint']:[];root.querySelectorAll<HTMLElement>('[data-book-detail]').forEach(e=>e.hidden=!keys.includes(e.dataset.bookDetail!));root.querySelector<HTMLElement>('[data-cover-format]')!.hidden=kind!=='front-cover';root.querySelector<HTMLElement>('[data-book-art]')!.hidden=!['front-cover','back-cover','inside-front','inside-back','author-bio','artist-bio'].includes(kind);};surface.addEventListener('change',refresh);refresh();
 let preparing=false;form.addEventListener('submit',e=>{if(preparing){e.preventDefault();status.textContent='Please wait for the image preview before saving this section.';}});
 const image=form.elements.namedItem('book_image') as HTMLInputElement,name=form.elements.namedItem('book_image_name') as HTMLInputElement,preview=root.querySelector<HTMLImageElement>('[data-book-image-preview]')!,status=root.querySelector<HTMLElement>('[data-book-image-status]')!;
 root.querySelector<HTMLInputElement>('[data-book-image-file]')!.addEventListener('change',async e=>{const chooser=e.target as HTMLInputElement,file=chooser.files?.[0];if(!file)return;if(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>20*1024*1024){status.textContent='Choose a JPEG, PNG or WebP image below 20 MB. The current image is unchanged.';return}preparing=true;chooser.disabled=true;status.textContent='Preparing image preview…';try{const bitmap=await createImageBitmap(file),canvas=document.createElement('canvas'),scale=Math.min(1,1200/Math.max(bitmap.width,bitmap.height));canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=canvas.getContext('2d')!;ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close();let quality=.82,result=canvas.toDataURL('image/jpeg',quality);while(result.length>600000&&quality>.25){quality-=.1;result=canvas.toDataURL('image/jpeg',quality)}if(result.length>600000)throw Error();image.value=result;name.value=file.name;preview.src=result;preview.hidden=false;image.dispatchEvent(new Event('input',{bubbles:true}));status.textContent='Image preview ready. Save this section to keep it.';}catch{status.textContent='The image preview could not be prepared. The current image is unchanged.'}finally{preparing=false;chooser.disabled=false}});
 root.querySelector('[data-book-image-remove]')!.addEventListener('click',()=>{image.value='';name.value='';preview.hidden=true;image.dispatchEvent(new Event('input',{bubbles:true}));status.textContent='Image removed from this draft. Saved versions keep earlier images.'});
});
</script>
<style>[data-book-matter] [hidden]{display:none!important}</style>
