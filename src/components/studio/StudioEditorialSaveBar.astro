---
interface Props {
  formId: string;
  savedLabel: string;
  saveLabel: string;
  error?: boolean;
}
const { formId, savedLabel, saveLabel, error = false } = Astro.props;
---

<aside class="studio-editorial-save" data-editorial-save data-form-id={formId} aria-label="Writing save controls">
  <div class="studio-editorial-save__message">
    <strong data-save-state aria-live="polite">{error ? "Last save failed. Check your work." : savedLabel}</strong>
    <span data-save-reminder hidden>Five minutes of unsaved work. Save when you are ready.</span>
  </div>
  <div class="studio-editorial-save__actions">
    <label class="studio-editorial-save__preference"><input type="checkbox" data-save-reminders checked /> <span>Five-minute reminders</span></label>
    <button class="studio-button" type="submit" form={formId} data-save-button>{saveLabel}</button>
  </div>
</aside>

<script>
  const bar = document.querySelector<HTMLElement>("[data-editorial-save]");
  const form = bar ? document.getElementById(bar.dataset.formId ?? "") as HTMLFormElement | null : null;
  const state = bar?.querySelector<HTMLElement>("[data-save-state]");
  const reminder = bar?.querySelector<HTMLElement>("[data-save-reminder]");
  const preference = bar?.querySelector<HTMLInputElement>("[data-save-reminders]");
  const saveButton = bar?.querySelector<HTMLButtonElement>("[data-save-button]");
  if (bar && form && state && reminder && preference && saveButton) {
    const preferenceKey = "studio-five-minute-save-reminders";
    try { preference.checked = localStorage.getItem(preferenceKey) !== "off"; } catch { /* Browser storage is optional. */ }

    const values = () => JSON.stringify(Array.from(new FormData(form).entries()));
    const original = values();
    const initialState = state.textContent ?? "No unsaved changes";
    let dirty = false;
    let dirtySince = 0;
    let saving = false;
    let navigating = false;
    let saveFailure = "";

    const updateState = () => {
      if (saving) return;
      const changed = values() !== original;
      if (changed && !dirty) dirtySince = Date.now();
      if (!changed) dirtySince = 0;
      dirty = changed;
      state.textContent = saveFailure || (dirty ? "Unsaved changes" : initialState);
      reminder.hidden = !dirty || !preference.checked || Date.now() - dirtySince < 300000;
    };

    form.addEventListener("input", () => { saveFailure = ""; updateState(); });
    form.addEventListener("change", () => { saveFailure = ""; updateState(); });
    window.addEventListener("pageshow", updateState);
    preference.addEventListener("change", () => {
      try { localStorage.setItem(preferenceKey, preference.checked ? "on" : "off"); } catch { /* Still works for this visit. */ }
      updateState();
    });
    window.setInterval(updateState, 15000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) updateState(); });
    window.addEventListener("beforeunload", (event) => {
      if (dirty && !saving && !navigating) event.preventDefault();
    });
    document.addEventListener("keydown", (event) => {
      const focus = document.activeElement;
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s"
        && (form.contains(focus) || bar.contains(focus))) {
        event.preventDefault();
        if (!saving) form.requestSubmit();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (saving) return;
      saving = true;
      state.textContent = "Saving…";
      reminder.hidden = true;
      saveButton.disabled = true;
      const body = new FormData(form);
      form.inert = true;
      form.setAttribute("aria-busy", "true");
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body,
          credentials: "same-origin",
          cache: "no-store",
        });
        const destination = new URL(response.url);
        if (response.ok && destination.origin === window.location.origin
          && destination.pathname === window.location.pathname
          && destination.searchParams.get("saved")) {
          navigating = true;
          window.location.assign(destination.href);
          return;
        }
        const message = destination.origin === window.location.origin
          ? destination.searchParams.get("error")
          : null;
        throw new Error(message || "Save not confirmed. Your text is still here; check your connection before retrying.");
      } catch (error) {
        navigating = false;
        saveFailure = error instanceof Error ? error.message : "Your work was not saved. Try again.";
        state.textContent = saveFailure;
      } finally {
        saving = false;
        form.inert = false;
        form.removeAttribute("aria-busy");
        saveButton.disabled = false;
      }
    });
  }
</script>
