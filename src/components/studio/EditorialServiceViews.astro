---
import EditorialRequestForm from './EditorialRequestForm.astro';
import EditorialReviewRequest from './EditorialReviewRequest.astro';
import {editorialHref as baseEditorialHref} from '../../lib/studio/editorialPartnership';
const {view,state,data,sources=[],requestedItem,context=null}=Astro.props;
const editorialHref=(view:any='overview',entry?:string,item?:string)=>baseEditorialHref(view,entry,item,context?.returnTo);
const {entry,active,consultations,reviews}=state;
const date=(s:string)=>new Date(s).toLocaleString('en-GB',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'UTC'});
const services=[{view:'groups',title:'Group sessions',caption:'Bring a question and explore your deck with other creators.',quantity:entry?.groupsRemaining??0},{view:'consultations',title:'Private consultations',caption:'A focused conversation about your deck and the decisions ahead.',quantity:consultations?.requestable??0},{view:'reviews',title:'Written reviews',caption:'A considered editorial response to selected saved writing.',quantity:reviews?.requestable??0}];
const record=entry&&(requestedItem?entry.reviews.find((r:any)=>r.id===requestedItem):entry.reviews.find((r:any)=>r.status==='requested'));
const selectedInvalid=!!requestedItem&&!record;
const invitations=entry?(data.groups??[]).flatMap((g:any)=>(g.invitations??[]).filter((i:any)=>i.enrolmentId===entry.id).map((i:any)=>({group:g,invitation:i}))):[];
---
{view==='included'&&<section class="ep-service"><p class="ep-kicker">Included in your programme</p><h1>Choose your next editorial step</h1><p>Choose the support that fits the work you are doing. Existing requests and delivered work remain in your partnership history.</p>
<div class="ep-service-choices">{services.map(s=><a class="ep-service-choice" href={editorialHref(s.view as any,entry?.id)}><span class="ep-choice-count">{active?s.quantity:0}</span><strong>{s.title}</strong><span>{s.caption}</span><small>{active?'Available to request':'View your recorded support'}</small></a>)}</div>
{!active&&<p class="ep-notice">New included requests are not currently available. You can still review your recorded support or enquire about separate work.</p>}</section>}
{view==='groups'&&entry&&<section class="ep-service"><p class="ep-kicker">Included support</p><h1>Group sessions</h1><p>Bring a question about your concept, writing or next creative decision. Ask for the next session, then respond to an invitation when a date is arranged.</p>
<div class="ep-service-summary"><strong>{entry.groupsRemaining} remaining</strong><span>{entry.promise.benefits.groups} included · {entry.groupsAttended} attended</span></div><p class="ep-hint">Requesting a session or accepting an invitation does not use an allowance. Only recorded attendance counts.</p>
{entry.nextGroupRequested?<p class="ep-notice" role="status">Your request for the next group session is recorded. A date has not been promised by this request.</p>:active&&entry.groupsRemaining>0&&<EditorialRequestForm action="request-group" entry={entry}><button type="submit" class="ep-primary">Request the next group session</button></EditorialRequestForm>}
<h3>Your invitations and attendance</h3>{!invitations.length?<p class="ep-empty">No group date has been arranged yet. An invitation will appear here when a session is scheduled.</p>:<ul class="ep-record-list">{invitations.map(({group:g,invitation:i}:any)=><li><strong>{g.title}</strong><p>{date(g.at)} UTC · {entry.promise.groupMinutes} minutes</p><span class="ep-status">{i.attended?'Attended':i.rsvp==='yes'?'Attending':i.rsvp==='no'?'Declined':'Awaiting your response'}</span>{active&&!i.attended&&!(entry.promise.programme==='explore-pass'&&i.rsvp==='invited')&&<EditorialRequestForm action="rsvp" entry={entry} groupId={g.id}><label>Your response<select name="choice"><option value="yes">I will attend</option><option value="no">I cannot attend</option></select></label><button type="submit" class="ep-secondary">Save response</button></EditorialRequestForm>}</li>)}</ul>}</section>}
{view==='consultations'&&entry&&<section class="ep-service"><p class="ep-kicker">A focused conversation</p><h1>Your private consultation</h1><p>Work with Leilia on the essentials of your deck, strengthen your editorial voice and find a clear direction for the next stage.</p>
<div class="ep-service-summary"><strong>{consultations.requestable} available to request</strong><span>{consultations.included} included · {consultations.pending} pending · {consultations.completed} completed</span></div>
<div class="ep-preparation"><h3>Before we meet</h3><p>We recommend bringing one completed card draft. Together, you can check its clarity, strengthen the guidance and identify an approach for the remaining cards.</p><p>Your consultation is {entry.promise.privateMinutes} minutes. Requesting it starts the scheduling process; it does not confirm a date or mark a consultation as completed.</p></div>
{active&&consultations.requestable>0?<EditorialRequestForm action="consultation-request" entry={entry}><p>Your existing account and programme identify this request. No additional project or personal details are needed at this step.</p><button type="submit" class="ep-primary">Request a private consultation</button></EditorialRequestForm>:<p class="ep-notice">No further included consultation is currently requestable. Your recorded consultations remain below.</p>}
<h3>Your consultations</h3>{!entry.consultations.length?<p class="ep-empty">You have not requested a consultation yet.</p>:<ul class="ep-record-list">{entry.consultations.map((c:any)=><li><strong>Private consultation</strong><span class="ep-status">{c.status==='completed'?'Completed':c.status==='scheduled'?'Scheduled':'Awaiting scheduling'}</span>{c.date&&<p>{date(c.date)} UTC</p>}{c.status==='requested'&&<p>Your request is recorded. A time has not been arranged yet.</p>}{data.demonstration&&c.demonstrationNotes&&<p class="ep-demo-notes">{c.demonstrationNotes}</p>}</li>)}</ul>}</section>}
{view==='reviews'&&entry&&<section class="ep-service">
{selectedInvalid?<p class="ep-notice" role="status">This review is not available in your programme. <a href={editorialHref('reviews',entry.id)}>Return to your written reviews</a>.</p>:record?.status==='requested'&&active?<EditorialReviewRequest entry={entry} review={record} sources={sources}/>:<><p class="ep-kicker">A considered response to your writing</p><h1>Written reviews</h1><p>A focused assessment of selected saved card or guidebook writing, guided by your question. Broader editing and proofreading are separate professional services.</p><div class="ep-service-summary"><strong>{reviews.requestable} available to request</strong><span>{reviews.included} included · {reviews.pending} pending · {reviews.completed} delivered</span></div>
{active&&reviews.requestable>0&&<EditorialRequestForm action="review-request" entry={entry}><p>Start by reserving an included review. You will then choose your saved material, explain your question and check the exact request before sending.</p><button type="submit" class="ep-primary">Start a written review</button></EditorialRequestForm>}
{!active&&<p class="ep-notice">New review submissions are not currently available. Your recorded reviews remain accessible.</p>}
</>}
{!selectedInvalid&&<section class="ep-review-history"><h3>Your written reviews</h3>{!entry.reviews.length?<p class="ep-empty">No written review has been requested yet.</p>:<ul class="ep-record-list">{entry.reviews.map((r:any)=><li><a href={editorialHref('reviews',entry.id,r.id)}>{r.submission?.title??'Written review'}</a><span class="ep-status">{({requested:'Ready for your material',submitted:'Submitted',in_review:'With your editor',delivered:'Delivered'} as any)[r.status]}</span></li>)}</ul>}</section>}
{record?.submission&&<section class="ep-delivered"><h3>{record.submission.title}</h3><p><strong>Your question</strong></p><p class="ep-passage">{record.submission.question}</p><p><strong>Selected material</strong></p><p class="ep-passage">{record.submission.selected_text}</p>{record.submission.constraints&&<p class="ep-passage">{record.submission.constraints}</p>}{record.submission.replies?.map((reply:any)=><section><h4>Your editorial response</h4><p class="ep-passage">{reply.body}</p></section>)}</section>}
</section>}
{view==='additional'&&<section class="ep-service"><p class="ep-kicker">Separate professional services</p><h1>Enquire about additional work</h1><p>Tell Leilia what you would like to achieve. This may include proofreading, manuscript editing, brand review, or editorial style and voice work.</p><p>Leilia will agree the scope and price with you by correspondence. An enquiry does not allocate benefits, accept a quotation or authorise a payment.</p>
<EditorialRequestForm action="request-quote"><fieldset><legend>Your enquiry</legend><label>Type of work<select name="category" required><option value="proofreading">Manuscript proofreading</option><option value="brand-review">Brand review</option><option value="style-voice">Editorial style and voice</option><option value="other">Other additional editorial work</option></select></label><label>Project or working title<input name="project" maxlength="200" required/></label><label>Work requested and the outcome you want<textarea name="outcome" rows="5" minlength="10" maxlength="4000" required placeholder="Describe the work, your aims and the kind of assistance you are looking for."></textarea></label></fieldset><button type="submit" class="ep-primary">Send an additional-work enquiry</button><p class="ep-hint">No purchase or payment is initiated. Keep original quotation correspondence for any later agreement.</p></EditorialRequestForm>
{data.quotes?.length>0&&<section><h3>Your previous enquiries</h3><ul class="ep-record-list">{data.quotes.map((q:any)=><li><strong>{q.project}</strong><p>{q.outcome}</p><span class="ep-status">Enquiry recorded</span><p>{date(q.createdAt)} UTC</p></li>)}</ul></section>}</section>}
