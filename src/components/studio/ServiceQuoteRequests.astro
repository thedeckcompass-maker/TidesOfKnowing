---
const {data,admin=false,available=true}=Astro.props;
const quotes=data.quotes??[];
const labels={'proofreading':'Manuscript proofreading','brand-review':'Brand review','style-voice':'Editorial style and voice','other':'Other additional editorial work'};
---
<section class="quote-requests" aria-labelledby="quote-title"><h3 id="quote-title">Additional work enquiries</h3>
{!admin&&<details id="request-additional-quote"><summary>Request a quote for additional work</summary><p>Tell Leilia what you need and the outcome you want. She will propose the scope and price for your approval before any extra work or charge.</p>{available?<form method="post" action="/api/studio/service-records" data-service-form><input type="hidden" name="action" value="request-quote"/><input type="hidden" name="key" value={crypto.randomUUID()}/><label>Type of work<select name="category" required>{Object.entries(labels).map(([value,label])=><option value={value}>{label}</option>)}</select></label><label>Project or working title<input name="project" maxlength="200" required/></label><label>Work requested and the outcome you want<textarea name="outcome" rows="4" minlength="10" maxlength="4000" required/></label><button>Request a quote</button><p data-result role="status"></p></form>:<p role="status">The enquiry connection is currently unavailable. You can review the support information here, but no enquiry can be submitted or saved until the connection returns. Please try again later.</p>}</details>}
{quotes.map((q:any)=><article id={'service-quote-'+encodeURIComponent(q.id)}><h4>{labels[q.category as keyof typeof labels]} — {q.project}</h4>{admin&&<p>Requested by {data.entries.find((e:any)=>e.ownerId===q.ownerId)?.name??('account '+q.ownerId)}</p>}{admin&&<p><a href={'?view=quotes&quote='+encodeURIComponent(q.id)}>Open quotation record and correspondence</a></p>}<p class="quote-copy">{q.outcome}</p><p>Enquiry recorded · {new Date(q.createdAt).toLocaleDateString('en-GB',{timeZone:'UTC'})}</p><p>Submitting an enquiry does not authorise charges or allocate services. Quotations and written acceptance are handled by email.</p></article>)}
{admin&&!quotes.length&&<p>No additional-work enquiries are awaiting review.</p>}
</section>
<script>for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-open-quote]'))link.addEventListener('click',()=>{const panel=document.querySelector<HTMLDetailsElement>('#request-additional-quote');if(panel)panel.open=true;});</script>
<style>.quote-requests{margin-top:1.2rem}.quote-requests h3{font-size:1.1rem}.quote-requests textarea{width:100%;max-width:36rem;box-sizing:border-box;padding:.7rem;font:inherit}.quote-copy{white-space:pre-wrap}.quote-requests article{padding:1rem 0;border-top:1px solid #c6bcae}.quote-requests summary{cursor:pointer}</style>
