---
import {foundingPresentation} from '../../lib/studio/foundingPresentation';
const {record}=Astro.props;
// Trusted server composition only; query strings never establish participation or status.
const allowed=record&&Astro.locals.user?.id===record.userId&&Astro.locals.profile?.status==='active';
const view=allowed?foundingPresentation({viewerId:record.userId,...record}):null;
const receipt=record?.receipt;
const date=(value:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'long',timeZone:record.timeZone||'UTC'}).format(new Date(value));
---
{allowed&&view&&<section class="founding-workspace" aria-labelledby="founding-heading">
 <header><p class="studio-eyebrow">FOUNDING CREATOR COLLABORATION</p><h2 id="founding-heading">{view.heading}</h2><p>{view.copy}</p></header>
 <div class="founding-columns"><div class="studio-panel">
 {view.state==='intro'?<><h3>Welcome to Deck Creator Studio</h3><p>Whether you're starting with a new idea or bringing an established deck into the Studio, our first two sessions will help you explore the tools and establish a clear direction for your work.</p><a class="studio-button" href="/studio/welcome/">Explore the Studio</a></>:<><h3>Your collaboration at a glance</h3>{receipt&&view.state!=='unavailable'&&<dl><dt>{view.state==='scheduled'?'Starts':'Agreed collaboration start'}</dt><dd>{date(receipt.collaborationStarts)}</dd><dt>Personal editorial support ends</dt><dd>{date(receipt.supportEnds)}</dd><dt>Founding platform period ends</dt><dd>{date(receipt.platformEnds)}</dd></dl>}<p><a class="studio-button" href="/studio/?orientation=skip">Open my project</a></p></>}
 <nav aria-label="Founding workspace tools"><a href="/studio/creators-desk/">Creator's Desk</a><a href="/studio/?orientation=skip&amp;view=workbook">Project Workbook</a><a href="/studio/journey-map/">Journey map</a></nav>
 </div><aside class="studio-panel"><h3>Your first two sessions</h3><h4>Find your bearings</h4><p>Explore Deck Creator Studio, find your bearings and become familiar with the creative workspace.</p><h4>Shape your deck's direction</h4><p>Work with Leilia on your deck's purpose, audience, vision, distinctive perspective, brand voice and preliminary card-writing structure.</p><p><a href="/studio/?orientation=skip">Choose your project for personal setup</a></p></aside></div>
 {view.state==='intro'&&<details class="studio-panel"><summary>Continue developing your deck with Leilia</summary><p><strong>US$495</strong> if you decide to proceed after the two no-obligation introductory sessions.</p><p>Twelve months of Studio access and two months of personal editorial support begin on the same explicitly agreed collaboration start date. Further sessions and individual support are arranged around agreed project needs and priorities.</p><p>Written assessments help clarify and strengthen selected material. They are not a commitment to edit an entire manuscript.</p><a class="studio-button studio-button--secondary" href="mailto:hello@tidesofknowing.com">Discuss continuing with Leilia</a><p>This opens your email application. It does not confirm payment, agreement or commencement.</p></details>}
 </section>}
<style>.founding-workspace{margin-block:1.5rem}.founding-workspace header>p{max-width:70ch}.founding-columns{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);gap:1.5rem;align-items:start}.founding-workspace .studio-panel{padding:1.5rem;min-width:0}.founding-workspace p{max-width:70ch;line-height:1.7}.founding-workspace nav{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem}.founding-workspace details{margin-top:1.5rem}.founding-workspace summary{cursor:pointer;font-weight:600}.founding-workspace dt{font-weight:600;margin-top:.7rem}.founding-workspace dd{margin-left:0}.founding-workspace h4{margin-bottom:.5rem}@media(max-width:760px){.founding-columns{grid-template-columns:1fr}}</style>
