---
import {projectBookView} from '../../lib/studio/projectBookView';
const {project,cards=[],sections=[],production=null,exportsOnly=false,readOnly=false}=Astro.props;
const initial=projectBookView(project,cards,sections,production);
---
<section id="project-book" class="studio-project-book" data-project-book data-read-only={String(readOnly)} data-book-standalone data-exports-only={exportsOnly} data-project={project.id}><div class="project-book-header"><p><span role="status" data-book-drafts></span></p></div><script type="application/json" data-project-book-initial set:html={JSON.stringify(initial).replaceAll('<','\\u003c')}/><div data-project-book-contents hidden={exportsOnly}/><p role="status" data-project-book-status></p><button type="button" class="studio-button studio-button--secondary" data-project-book-retry hidden>Try loading saved work again</button><section id="exports" data-book-exports hidden={!exportsOnly}><h2>Choose what to export</h2><p>Choose a copy for reading, sharing your plans or keeping a restorable backup.</p><section class="book-export-group"><h3 id="manuscript-exports">Manuscript</h3><p>Your reader-facing text and working images, in book order. This readable HTML copy is for reviewing your writing; it is separate from a printer's finished files. Empty and set-aside sections are left out.</p><button type="button" class="studio-button" data-book-download>Download readable manuscript</button><details><summary>Saved text formats</summary><p>Markdown text for further editing. The working copy includes saved writing; the final copy requires current creator approval and your final card selection.</p><p><a href={`/api/studio/projects/${project.id}/companion-export?mode=draft`}>Working manuscript text</a></p><p><a href={`/api/studio/projects/${project.id}/companion-export?mode=final`}>Final creator-approved text</a></p></details><details><summary>Cover surfaces</summary><p>Download the chosen cover text and working images separately from the interior. Use your printer's template when preparing production files.</p><div data-cover-exports/></details></section><section class="book-export-group"><h3>Project reference</h3><p>Your creative concept and production or publishing plans, kept separate from the reader-facing manuscript.</p><div data-reference-exports/><details><summary>Other working documents</summary><p>Keep a text copy of your saved project writing and plans for editing in another application.</p><p><a href={`/api/studio/projects/${project.id}/export/md`}>Download project writing (.md)</a></p></details></section><section class="book-export-group"><h3>Private journal</h3><p>Choose all journal entries or a selection, with their stored photographs, in creation order. Journal writing is kept out of your manuscript.</p>{readOnly?<a href={`/api/studio/projects/${project.id}/journal/export?scope=all`}>Download my private journal</a>:<a href={`/studio/projects/${project.id}/exports/#private-exports`}>Choose journal entries to export</a>}</section><section class="book-export-group"><h3>Complete project backup</h3><p>A ZIP archive of project records, saved versions and included media for restoring a separate project. Keep originals stored in an external artwork folder alongside this backup; the archive cannot collect files it cannot access.</p><a href={`/api/studio/projects/${project.id}/export/zip`}>Download restorable project backup</a></section></section></section>
<script>import '../../scripts/projectBookOverview';</script>
<style>:global(.book-reference-sections){margin:1rem 0}:global(.book-reference-sections)>details{padding:.7rem 0;border-top:1px solid #cec9c1}:global(.book-reference-sections) summary{cursor:pointer;font-weight:600}:global(.book-reference-sections) button{margin:.7rem 0}.project-book-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-top:.7rem}.project-book-header p{margin:0;max-width:62ch}.project-book-header button{flex:0 0 auto}.project-book-header button:focus-visible{outline:3px solid #065e73;outline-offset:3px}@media(max-width:760px){.project-book-header{flex-direction:column}.project-book-header button{align-self:flex-end;max-width:100%;white-space:normal}}.studio-project-book{margin:0 0 1.2rem;padding:.9rem 1.1rem!important;background:#e8e3db;border:1px solid #cec9c1!important;border-radius:4px}.studio-project-book>summary{font:500 1.25rem/1.5 'Playfair Display',Georgia,serif;cursor:pointer}.studio-project-book>summary span{font:400 .85rem/1.5 Inter,system-ui,sans-serif;margin-inline-start:.7rem}.studio-project-book :global(.project-book-chapter){padding:.85rem 0;border-top:1px solid #cec9c1}.studio-project-book :global(.project-book-chapter>summary){font-weight:600;cursor:pointer}.studio-project-book :global(.project-book-writing){max-height:26rem;overflow:auto;padding:.8rem;background:#faf8f3;line-height:1.7;overflow-wrap:anywhere}.studio-project-book :global(.project-book-writing h3){font:500 1.3rem/1.3 'Playfair Display',Georgia,serif}.studio-project-book :global(.project-book-writing img){display:none}.studio-project-book :global(.project-book-edit){display:inline-block;margin:.6rem 0}.studio-project-book button:focus-visible,.studio-project-book summary:focus-visible{outline:3px solid #065e73;outline-offset:3px}@media(max-width:760px){.studio-project-book>summary span{display:block;margin-inline-start:0}}</style>


<style is:global>.project-book-document{background:#fffdf7;color:#253638;max-width:1000px;margin:1rem auto;padding:clamp(1rem,4vw,3rem);font:17px/1.75 Georgia,serif;overflow-wrap:anywhere}.book-title-page{text-align:center;padding:5rem 0;border-bottom:1px solid #b8a77b;margin-bottom:3rem}.book-title-page h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.2}.project-book-document nav{display:flex;flex-direction:column;padding-bottom:2rem;border-bottom:1px solid #b8a77b}.book-chapter{padding:3rem 0;border-bottom:1px solid #cfc5ae;scroll-margin-top:3rem}.book-chapter h2{font-size:2.2rem;font-weight:400;line-height:1.25}.book-entry{margin:2.5rem 0}.book-entry h3{font-size:1.55rem;font-weight:400}.book-card-columns{display:grid;grid-template-columns:minmax(150px,1fr) minmax(0,2fr);gap:2rem}.book-card-columns:not(:has(img)){display:block}.book-card-columns img{width:100%;height:auto;max-height:500px;object-fit:contain}.book-edit{display:inline-block;font:14px/1.5 system-ui,sans-serif;margin-top:1rem;color:#21596a}.book-writing{white-space:normal}@media(max-width:650px){.book-card-columns{grid-template-columns:1fr}.book-card-columns img{max-height:360px}.book-title-page{padding:2rem 0}}@media print{.book-title-page{break-after:page}.book-chapter{break-before:page}.book-edit{display:none}.project-book-document{padding:0}nav a{color:inherit}}</style>
<script type="text/plain" data-book-print-style set:html={".book-qr{width:8rem;max-width:100%;background:white}.book-qr svg{width:100%;height:auto}.project-book-document{background:#fffdf7;color:#253638;max-width:1000px;margin:1rem auto;padding:clamp(1rem,4vw,3rem);font:17px/1.75 Georgia,serif;overflow-wrap:anywhere}.book-title-page{text-align:center;padding:5rem 0;border-bottom:1px solid #b8a77b;margin-bottom:3rem}.book-title-page h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.2}.project-book-document nav{display:flex;flex-direction:column;padding-bottom:2rem;border-bottom:1px solid #b8a77b}.book-chapter{padding:3rem 0;border-bottom:1px solid #cfc5ae;scroll-margin-top:3rem}.book-chapter h2{font-size:2.2rem;font-weight:400;line-height:1.25}.book-entry{margin:2.5rem 0}.book-entry h3{font-size:1.55rem;font-weight:400}.book-card-columns{display:grid;grid-template-columns:minmax(150px,1fr) minmax(0,2fr);gap:2rem}.book-card-columns:not(:has(img)){display:block}.book-card-columns img{width:100%;height:auto;max-height:500px;object-fit:contain}.book-edit{display:inline-block;font:14px/1.5 system-ui,sans-serif;margin-top:1rem;color:#21596a}.book-writing{white-space:normal}@media(max-width:650px){.book-card-columns{grid-template-columns:1fr}.book-card-columns img{max-height:360px}.book-title-page{padding:2rem 0}}@media print{.book-title-page{break-after:page}.book-chapter{break-before:page}.book-edit{display:none}.project-book-document{padding:0}nav a{color:inherit}}"}/>

<style is:global>.book-reader{margin:1rem 0;background:#fffdf7;border:1px solid #cfc5ae;padding:.8rem}.book-reader-controls{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.6rem;font:14px/1.5 system-ui,sans-serif}.book-reader-controls button{min-width:44px;min-height:44px;border:1px solid #9b8965;background:#faf7ed;font-size:1.4rem}.book-reader-controls button:focus-visible,.book-reader-viewport:focus-visible{outline:3px solid #065e73;outline-offset:3px}.book-reader-viewport{overflow-x:hidden;overflow-y:hidden;width:100%;margin-inline:auto;scroll-behavior:auto}.project-book-document.book-reader-pages{box-sizing:border-box;max-width:none;width:100%;margin:0;padding:0;height:var(--reader-height,600px);column-width:var(--reader-page-width,500px);column-gap:24px;column-fill:auto;font-size:16px;line-height:1.6;overflow-wrap:anywhere}.book-reader-pages .book-title-page{box-sizing:border-box;padding:4rem 1.5rem 1rem;margin:0;height:var(--reader-height,600px);break-after:column;border:0;text-align:center}.book-reader-pages .book-title-page h1{font-size:clamp(1.8rem,4vw,2.8rem)}.book-reader-pages nav{display:block;break-after:column;padding:0 1rem 1rem;border:0}.book-reader-pages nav a{display:block;margin:.35rem 0}.book-reader-pages .book-entry{margin:0;padding:0 1rem 1rem}.book-reader-pages .book-entry h2,.book-reader-pages h3{break-after:avoid;font-size:1.5rem;line-height:1.3}.book-reader-pages p{orphans:3;widows:3}.book-reader-pages .book-card-columns{display:block}.book-reader-pages .book-card-columns img{display:block;width:auto;max-width:100%;height:auto;max-height:240px;object-fit:contain;margin:0 auto 1rem;break-inside:avoid}.book-reader-pages pre{white-space:pre-wrap}.book-reader-pages table{max-width:100%;overflow-wrap:anywhere}.book-reader-pages .book-edit{break-inside:avoid}</style>

<style is:global>.book-contents-row{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;break-inside:avoid;padding:.25rem 0}.book-empty-label{color:#62645e}.book-add-content{flex-shrink:0;font:14px/1.5 system-ui,sans-serif;text-decoration:underline}.book-contents-row a:focus-visible{outline:3px solid #065e73;outline-offset:2px}@media(max-width:450px){.book-contents-row{gap:.6rem}.book-add-content{max-width:6rem}}</style>

<style>.book-export-group{padding:1rem 0;border-top:1px solid #cec9c1}.book-export-group h3{margin:.2rem 0}.book-export-group button{margin:.4rem .6rem .4rem 0}</style>

<style is:global>.project-book-choices{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0 1.5rem}.project-book-choices a{padding:.8rem 1rem;border-bottom:3px solid transparent;color:#254d53;text-decoration:underline;min-height:44px}.project-book-choices a[aria-current]{border-color:#8a6a1f;background:#faf8f2;font-weight:600}.project-book-choices a:focus-visible{outline:3px solid #065e73;outline-offset:3px}[data-book-panel][hidden]{display:none!important}.project-book-return{padding:.6rem 1rem;background:#f4efe4;display:block}</style>

<style is:global>[data-project-book] [hidden]{display:none!important}.book-export-group .studio-button{margin:0}.book-export-group [data-reference-exports],.book-export-group [data-cover-exports]{display:flex;flex-wrap:wrap;gap:.75rem;margin:.75rem 0}</style>
