---
const {enabled=false}=Astro.props;
---
<aside class="studio-card"><h3>Add portfolio images</h3><p>Select several images at once, or add a portfolio link in an example below. Keep your original files.</p><select data-portfolio-slot hidden aria-label="Selected example">{Array.from({length:8},(_,i)=><option value={i+1}>{i+1}</option>)}</select><input type="file" data-portfolio-image accept="image/jpeg,image/png,image/webp" multiple hidden disabled={!enabled}/><button type="button" data-portfolio-add class="studio-button studio-button--secondary" disabled={!enabled}>Choose images</button><button type="button" data-portfolio-retry class="studio-text-button" hidden>Retry remaining uploads</button><button type="button" data-portfolio-cancel class="studio-text-button" hidden>Cancel remaining uploads</button><p data-portfolio-status role="status" aria-live="polite"/></aside>
<script>
import {prepareArtworkPreview} from '../../lib/studio/originalArtworkClient';
const input=document.querySelector<HTMLInputElement>('[data-portfolio-image]'),status=document.querySelector<HTMLElement>('[data-portfolio-status]'),retry=document.querySelector<HTMLButtonElement>('[data-portfolio-retry]'),cancel=document.querySelector<HTMLButtonElement>('[data-portfolio-cancel]'),add=document.querySelector<HTMLButtonElement>('[data-portfolio-add]');let queue:any[]=[],busy=false;
const form=input?.closest('form');
const controls=()=>{if(input)input.disabled=busy;if(add)add.disabled=busy||queue.length>0;retry!.hidden=!queue.length||busy;cancel!.hidden=!queue.length||busy;if(form){form.dataset.portfolioUploading=String(busy);form.dataset.portfolioPending=String(queue.length>0)}};
async function send(){if(busy||!queue.length||!status)return;busy=true;controls();try{while(queue.length){const item=queue[0];status.textContent='Uploading image '+item.slot+'…';if(!item.preview)item.preview=(await prepareArtworkPreview(item.file)).preview;const data=new FormData();data.set('image',item.preview,'portfolio-preview.jpg');data.set('request_id',item.id);data.set('slot',item.slot);data.set('expected_head',item.expectedHead);const response=await fetch('/api/artists/portfolio/',{method:'POST',body:data}),result=await response.json();if(!response.ok)throw Error(result.error);const target=form?.elements.namedItem('portfolio_url_'+item.slot) as HTMLInputElement|null;if(target){target.value=result.url;target.dispatchEvent(new Event('input',{bubbles:true}));}const heads=form?.elements.namedItem('media_heads') as HTMLInputElement|null;if(heads&&result.id){const value=JSON.parse(heads.value||'{}');value[String(item.slot)]=result.id;heads.value=JSON.stringify(value)}queue.shift();}status.textContent='Images added. Open each example to add its title, then continue.';}catch(e){status.textContent='Some uploads are not confirmed. Images already added are kept. Retry the remaining uploads or cancel them. '+(e as Error).message;}finally{busy=false;controls()}}
add?.addEventListener('click',()=>{if(!input||busy||queue.length)return;delete input.dataset.replaceSlot;input.multiple=true;input.value='';input.click()});
input?.addEventListener('change',async()=>{const files=Array.from(input.files??[]),replace=input.dataset.replaceSlot;delete input.dataset.replaceSlot;input.multiple=true;if(!files.length)return;if(busy||queue.length){status!.textContent='Retry or cancel the remaining uploads first.';return}const slots=replace?[Number(replace)]:Array.from({length:8},(_,i)=>i+1).filter(n=>!(form?.elements.namedItem('portfolio_url_'+n) as HTMLInputElement)?.value);if(files.length>slots.length){status!.textContent=replace?'Choose one image to replace this example.':'There are '+slots.length+' empty spaces. Select no more than '+slots.length+' images.';input.value='';return}const heads=JSON.parse((form?.elements.namedItem('media_heads') as HTMLInputElement)?.value||'{}');queue=files.map((file,i)=>({file,id:crypto.randomUUID(),slot:String(slots[i]),expectedHead:heads[String(slots[i])]??''}));await send()});retry?.addEventListener('click',send);cancel?.addEventListener('click',()=>{if(busy)return;queue=[];input!.value='';status!.textContent='Remaining uploads cancelled. Images already added are kept.';controls()});
</script>
