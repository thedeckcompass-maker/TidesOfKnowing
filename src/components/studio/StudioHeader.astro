---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  projectId?: string;
}

const { eyebrow = "Deck Creator Studio", title, lede, projectId } = Astro.props;
---

<header class="studio-header">
  <div>
    <p class="studio-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede ? <p class="studio-lede">{lede}</p> : null}
  </div>
  <nav class="studio-nav" aria-label="Deck Creator Studio">
    <a href="/studio/">Projects</a>
    {projectId ? <a href={`/studio/projects/${projectId}/`}>Project dashboard</a> : null}
    {projectId ? <a href={`/studio/projects/${projectId}/journal/`}>Journal</a> : null}
    {projectId ? <a href={`/studio/projects/${projectId}/programme/`}>Programme</a> : null}
    {projectId ? <a href={`/studio/projects/${projectId}/pulse/`}>Project Pulse</a> : null}
    <a href="/studio/account/">Plan and access</a>
    <a href="/community/account/">Account</a>
  </nav>
</header>
