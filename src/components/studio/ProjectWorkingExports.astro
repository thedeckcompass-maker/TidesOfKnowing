---
const {project,cards=[],entries=[],updates=[],loadError=false}=Astro.props;
const initial=JSON.stringify({project,cards}).replaceAll('<',()=>String.fromCharCode(92)+'u003c');
---
<section id="working-exports" class="studio-panel" data-working-exports><h2>Project reference and working data</h2><p>These copies use saved work. Unsaved recovery stays in its editor. None is a printer-ready file or a production database backup.</p>
<script type="application/json" data-working-export-state set:html={initial}/>
<p><a href={`/api/studio/projects/${project.id}/export/json`}>Download project records (.json)</a></p>
<p><a href={`/api/studio/projects/${project.id}/visual-direction?format=md`}>Download saved visual direction and connections</a></p>
<div class="studio-actions"><button type="button" data-working-file="production">Download saved Production Book (.md)</button><button type="button" data-working-file="publication">Download saved Publication and Launch Book (.md)</button><button type="button" data-working-file="story">Download saved story draft (.md)</button><button type="button" data-working-file="visual">Download saved visual layout and previews (.zip)</button></div>
<div data-saved-qr/><p role="status" data-working-export-status/>
<section id="private-exports"><h2>Private journal and selected material</h2>{loadError?<p role="alert">Journal entries or prepared updates could not be listed. Reload before choosing a selection. Nothing was changed.</p>:<><form method="get" action={`/api/studio/projects/${project.id}/journal/export`}><label class="studio-field">Journal entries<select name="scope"><option value="all">All entries</option><option value="selected">Selected entries</option></select></label><fieldset><legend>Select entries when using Selected entries</legend>{entries.map((entry:any)=><label class="studio-check"><input type="checkbox" name="entry" value={entry.id}/>{entry.title}</label>)}</fieldset><button type="submit" disabled={!entries.length}>Download journal with stored photographs (.zip)</button></form><h3>Prepared journey updates</h3>{updates.length?<ul>{updates.map((u:any)=><li><a href={`/api/studio/journal/excerpts/${u.id}/export/md`}>Download update text: {u.title}</a>{u.photo_id&&<span> — photograph is separate; <a href={`/studio/projects/${project.id}/journal/${u.journal_entry_id}/#journal-photographs`}>open source photographs</a>.</span>}</li>)}</ul>:<p>No prepared updates. <a href={`/studio/projects/${project.id}/crowd-funding/`}>Prepare a private journey update</a>.</p>}</>}
<p>Original quotation correspondence remains in its authorised service record. <a href="/studio/account/">Open my support and services</a>. Recipient restrictions still apply.</p></section></section>
<script>import '../../scripts/workingExports';</script>
