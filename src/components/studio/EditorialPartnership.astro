---
import EditorialServiceViews from './EditorialServiceViews.astro';
import {INITIAL_UNLOCK_DEVELOP_VERSION} from '../../lib/studio/serviceOffers';
import {editorialView,editorialHref as baseEditorialHref,partnershipState,editorialActivity,editorialExcerpt} from '../../lib/studio/editorialPartnership';
import '../../styles/editorialPartnership.css';
const {data,sources={},error='',context=null}=Astro.props;
const editorialHref=(view:any='overview',entry?:string,item?:string)=>baseEditorialHref(view,entry,item,context?.returnTo);
const actor=Astro.locals.user?.id??'',view=editorialView(Astro.url.searchParams.get('view'));
const state=partnershipState(data,actor,Astro.url.searchParams.get('entry'));
const {entry,active,consultations,reviews}=state;
const partnership=entry&&['collaborate','develop'].includes(entry.promise.programme);
const date=(value:string)=>new Date(value).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const history=editorialActivity(entry,data.groups??[]);
const demonstration=data.demonstration?.kind==='lexicon-develop-activity-v1';
const status=!entry?'':Date.now()<Date.parse(entry.promise.start)?'Not yet started':Date.now()>=Date.parse(entry.promise.editorialEnds)?'Editorial period ended':active?(demonstration?'Illustrative programme':'Active partnership'):'Requests currently restricted';
---
<div class="editorial-partnership" data-editorial-view={view}>
{entry?.promise.version===INITIAL_UNLOCK_DEVELOP_VERSION&&<p class="ep-notice">Your included consultations and written reviews were released after the first confirmed payment. Any remaining fixed installments are still due; current payment and program access rules continue to apply.</p>}
{view!=='overview'&&<nav class="ep-breadcrumb" aria-label="Editorial navigation"><a href={editorialHref('overview',entry?.id)}>Your Editorial Partnership</a><span aria-hidden="true">/</span><span>{({included:'Included support',groups:'Group sessions',consultations:'Private consultation',reviews:'Written review',additional:'Additional work'} as any)[view]}</span></nav>}
{error?<section class="ep-header"><p class="ep-kicker">Editorial Support</p><h1>Your support information is unavailable</h1><p role="status">{error}</p><p>Your records have not been changed. Return later to review your programme.</p></section>:state.foreignEntry?<section class="ep-header"><h1>Editorial Support</h1><p role="status">This programme is not available to your account.</p><a href={editorialHref()}>Return to your support</a></section>:<>
{view==='overview'?<>
<header class="ep-header"><p class="ep-kicker">Deck Creator Studio · Editorial Support</p><h1>{partnership?'Your Editorial Partnership':'Editorial Support'}</h1>
{entry?<><div class="ep-membership"><strong>{entry.promise.benefits.name}</strong><span class="ep-status" data-active={String(active)}>{status}</span></div><p class="ep-period">{date(entry.promise.start)} to {date(entry.promise.editorialEnds)}</p><p class="ep-intro">{partnership?'A professional space to develop your deck with Leilia, through focused conversations and considered feedback.':'Your recorded group-session support and invitations are available here.'}</p>{entry.promise.createEnds&&<p class="ep-platform">{demonstration?'Illustrative Create period ends':'Your Studio workspace is separate and remains available until'} {date(entry.paymentAvailability?.createEndsAt??entry.promise.createEnds)}.</p>}</>:<p class="ep-intro">Explore the editorial assistance available for your deck. Your current membership does not include a recorded editorial programme. You can enquire about separate work without changing your membership.</p>}
</header>
<nav class="ep-actions" aria-label="Your next editorial step">{entry?<a class="ep-action" href={editorialHref('included',entry.id)}><span class="ep-action-icon" aria-hidden="true">↗</span><strong>{demonstration?'Explore included support':'Book included support'}</strong><span>Choose from the sessions and reviews available in your programme.</span></a>:<div class="ep-action ep-action-unavailable"><strong>Included editorial support</strong><span>No included programme is recorded for this account.</span></div>}<a class="ep-action" href={editorialHref('additional',entry?.id)}><span class="ep-action-icon" aria-hidden="true">＋</span><strong>Enquire about additional work</strong><span>Discuss a separate piece of professional editorial or publishing work.</span></a></nav>
{entry&&<><section aria-label="Your available editorial support" class="ep-balances"><div><h2>Group sessions</h2><strong>{entry.groupsRemaining}</strong><p>remaining</p><small>{entry.promise.benefits.groups} included · {entry.groupsAttended} attended</small>{entry.nextGroupRequested&&<span class="ep-balance-note">Next session requested</span>}</div><div><h2>Private consultations</h2><strong>{consultations.requestable}</strong><p>requestable</p><small>{consultations.included} included · {consultations.pending} pending · {consultations.completed} completed</small></div><div><h2>Written reviews</h2><strong>{reviews.requestable}</strong><p>requestable</p><small>{reviews.included} included · {reviews.pending} pending · {reviews.completed} delivered</small></div></section>
<section class="ep-activity" aria-labelledby="ep-activity-title"><div class="ep-section-heading"><h2 id="ep-activity-title">Your editorial activity</h2><span>{history.length?history.length+' recorded '+(history.length===1?'item':'items'):'A fresh chapter'}</span></div>{!history.length?<p class="ep-empty">No requests yet. Your first editorial step starts with the support you choose above.</p>:<ul>{history.map((r:any)=><li><div><a href={editorialHref(r.view,entry.id,r.view==='reviews'?r.id:undefined)} class="ep-activity-title">{r.subject||r.type}</a>{r.subject&&<p class="ep-activity-type">{r.type}</p>}{r.purpose&&<p>{editorialExcerpt(r.purpose)}</p>}{r.projectId&&<a class="ep-material-link" href={'/studio/projects/'+r.projectId+'/?view=project'}>View associated project</a>}{r.date&&<time datetime={r.date}>{date(r.date)}{r.view!=='reviews'&&<> · {r.date.slice(11,16)} UTC</>}</time>}{r.outcome&&<p class="ep-outcome">{editorialExcerpt(r.outcome,240)}</p>}</div><div class="ep-activity-state"><span class="ep-status">{r.status}</span>{r.consumed&&<small>{demonstration?'Illustrative allocation used':'Included service used'}</small>}</div></li>)}</ul>}</section></>}
{state.entries.filter((e:any)=>e.id!==entry?.id&&['collaborate','develop','explore-pass'].includes(e.promise.programme)).length>0&&<nav class="ep-previous" aria-label="Other recorded programmes"><h2>Other recorded programmes</h2>{state.entries.filter((e:any)=>e.id!==entry?.id&&['collaborate','develop','explore-pass'].includes(e.promise.programme)).map((e:any)=><a href={editorialHref('overview',e.id)}>{e.promise.benefits.name} · {date(e.promise.start)}</a>)}</nav>}
<footer class="ep-guidance"><p>Community discussions and @Leilia mentions are shared conversations. Editorial submissions use the private, selected-material process.</p><a href="/studio/community/">Return to Community</a>{context&&<a href={context.returnTo}>Return to {context.label}</a>}<a href={context?.projectId?'/studio/projects/'+context.projectId+'/editorial/':'/studio/?orientation=skip&task=editorial&select=project'}>Confidential project feedback</a><a href="/studio/creators-desk/">Creator’s Desk</a></footer>
</>:entry||view==='additional'?<EditorialServiceViews view={view} state={state} data={data} sources={entry?sources[entry.id]??[]:[]} requestedItem={Astro.url.searchParams.get('item')} context={context}/>:<section class="ep-service"><h1>Editorial Support</h1><p>No included programme is available for this account.</p><a href={editorialHref('additional')}>Enquire about additional work</a></section>}
</>}
</div>
