---
import {pendingPassInvitations} from '../../lib/studio/serviceTaskSummary';
const actor=Astro.locals.user?.id,store=(Astro.locals as any).studioServiceRecords;
let pending:any[]=[];if(actor&&store)try{pending=pendingPassInvitations(await store.read(actor,false));}catch{}
---
{pending.length>0&&<section class="pass-attention" aria-labelledby="pass-attention-title" id="group-invitations"><p class="kicker">Response needed</p><h2 id="pass-attention-title">Your group invitation{pending.length>1?'s':''}</h2><p>Please let Leilia know whether you can attend.</p>{pending.map(({entry,group})=><section><h3>{group.title}</h3><p>{new Date(group.at).toLocaleString('en-GB',{dateStyle:'full',timeStyle:'short',timeZone:'UTC'})} UTC · 30 minutes</p><form action="/api/studio/service-records" method="post" data-service-form><input type="hidden" name="action" value="rsvp"/><input type="hidden" name="key" value={crypto.randomUUID()}/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="groupId" value={group.id}/><input type="hidden" name="revision" value={entry.revision}/><label>Your response<select name="choice"><option value="yes">I will attend</option><option value="no">I cannot attend</option></select></label><button>Save RSVP</button><p data-result role="status"></p></form></section>)}</section>}
<style>.pass-attention{background:#e8dfc8;color:#173f46;border:2px solid #a18348;border-radius:.6rem;padding:1.5rem;margin:1rem 0 2rem}.pass-attention :is(h2,h3,p,label){color:#173f46}.kicker{font-weight:700;letter-spacing:.05em}.pass-attention form{display:flex;align-items:end;flex-wrap:wrap;gap:1rem}.pass-attention label{display:block}.pass-attention select{display:block;min-height:2.8rem;font:inherit;padding:.5rem .8rem;background:#fffaf0;color:#173f46}.pass-attention button{background:#173f46;color:#fffaf0;border:1px solid #173f46;border-radius:.3rem;padding:.8rem 1.1rem;font:inherit}.pass-attention :is(button,select):focus-visible{outline:3px solid #173f46;outline-offset:4px}.pass-attention [data-result]{flex-basis:100%}</style>
