---
import {studioArtistProcessLabel} from '../../lib/studio/types';
const {artist,origin=Astro.url.origin,preview=false}=Astro.props;
const list=(key:string)=>Array.isArray(artist[key])?artist[key].join(', '):'';
const practice=[['Mediums',list('mediums')],['Techniques',list('techniques')],['Styles',list('styles')],['Subjects',list('subjects')]];
const together=[['Experience',artist.publishing_experience],['Availability',artist.availability],['Budget approach',artist.budget_approach],['Licensing preferences',artist.licensing_preferences],['Collaboration models',list('collaboration_models')]];
---
<article class="artist-full" data-profile-preview={preview}><header><h2>{artist.professional_name}</h2><p>{[artist.location,artist.time_zone,list('languages')].filter(Boolean).join(' · ')}</p></header><section><h3>About the artist</h3>{artist.biography&&<p>{artist.biography}</p>}{artist.artistic_statement&&<p>{artist.artistic_statement}</p>}</section><section><h3>Artistic practice</h3><dl>{practice.filter(([,v])=>v).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>{artist.process_disclosure&&<><h4>Creative process</h4><p>{studioArtistProcessLabel[artist.process_disclosure as keyof typeof studioArtistProcessLabel]??artist.process_disclosure}</p></>}</section><section><h3>Portfolio</h3><div class="artist-full-examples">{(artist.portfolio_examples??[]).map((example:any)=><figure>{new URL(example.url,origin).origin===origin&&new URL(example.url,origin).pathname.startsWith('/api/artists/portfolio/')?<img src={example.url} alt={example.title} loading="lazy"/>:<a href={example.url} target="_blank" rel="noopener noreferrer">{example.title}</a>}<figcaption><strong>{example.title}</strong>{example.description&&<p>{example.description}</p>}</figcaption></figure>)}</div></section><section><h3>Working together</h3><dl>{together.filter(([,v])=>v).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section>{preview?<p><button type="button" class="studio-button" disabled>Contact this artist</button><br/>Available to eligible creators only after approval.</p>:artist.directory_contact_email&&<section><a class="studio-link-button" href={'mailto:'+encodeURIComponent(artist.directory_contact_email)}>Contact this artist</a><p>Contact this artist directly to discuss your project. You are responsible for your correspondence and any collaboration agreement.</p></section>}</article>
<style>.artist-full p,.artist-full dd{max-width:70ch;white-space:pre-wrap;overflow-wrap:anywhere}.artist-full section{margin-top:24px}.artist-full dl{display:grid;gap:1rem}.artist-full dt{font-weight:600}.artist-full dd{margin:.35rem 0 0}.artist-full-examples{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.artist-full figure{margin:0}.artist-full img{max-width:100%;height:auto;max-height:360px;object-fit:contain}@media(max-width:600px){.artist-full-examples{grid-template-columns:1fr}}</style>
