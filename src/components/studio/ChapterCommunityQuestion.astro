---
import CommunityMentionHelp from './CommunityMentionHelp.astro';
import '../../styles/communityExperience.css';
import {supportCapabilities} from '../../lib/studio/supportCapabilities';
import {CREATIVE_CHAPTERS} from '../../lib/studio/creatorJourney';
import {supportStore} from '../../lib/studio/supportProvider';
const channels=await supportCapabilities(Astro.locals),fixture=!!supportStore(Astro.locals);
---
<section id="chapter-support" class="chapter-community-question" data-chapter-question data-local={String(fixture)}>
<p class="studio-eyebrow">Think it through together</p><details><summary>Explore a question with support</summary><p data-question-help></p>

<div class="support-channels">{channels.map(c=><article data-support-capability={c.capability} data-eligible={String(c.eligible)}><h3>{c.title}</h3><p>{c.description}</p><p><strong>Audience:</strong> {c.audience}.</p><p id={`support-${c.capability}`}>{c.available?'Choose a conversation or share a question with other creators.':c.reason}</p>{c.capability==='general_community'&&c.available?<a class="studio-button studio-button--secondary" href="/studio/community/">Join the Community conversation</a>:c.capability==='editorial'&&fixture&&c.eligible?<a class="studio-button studio-button--secondary" data-editorial-link href={`/studio/projects/${Astro.params.id}/editorial/`}>Editorial feedback required</a>:<button type="button" data-choose-support={c.capability} disabled={!fixture||!c.eligible} aria-describedby={`support-${c.capability}`}>{c.capability==='editorial'?'Editorial feedback required':'Prepare a question'}</button>}</article>)}</div>
<form data-support-form hidden method="post" action="/api/studio/contextual-support">
<p data-selected-audience></p><label>Section discussion<select name="community_chapter" required>{CREATIVE_CHAPTERS.map(c=><option value={c.id}>{c.name}</option>)}</select></label><label>My question <button type="button" data-help="question" aria-label="Help with my question" aria-expanded="false" aria-controls="support-question-help">?</button><textarea data-studio-help-attached="true" name="question" rows="4" maxlength="6000" required minlength="20"/></label>
<div class="studio-field-wisdom-panel" id="support-question-help" hidden><h4>Personal</h4><p>Which choice feels difficult to settle, and what matters to you about it? You do not need to disclose personal experiences.</p><h4>Practical</h4><p>Describe one decision and the kind of response that would help. Include only what you want the audience shown above to read.</p></div>
<details><summary>Add an excerpt I choose (optional)</summary><label>Only the words I want to share <button type="button" data-help="excerpt" aria-label="Help with selected excerpt" aria-expanded="false" aria-controls="support-excerpt-help">?</button><textarea data-studio-help-attached="true" name="selected_text" rows="3" maxlength="4000"/></label><div class="studio-field-wisdom-panel" id="support-excerpt-help" hidden><h4>Personal</h4><p>Which passage would help others understand the decision you are considering?</p><h4>Practical</h4><p>Paste only the words you want this audience to see. Nothing is copied automatically from your project or private journal.</p></div></details>
<CommunityMentionHelp/><p>Studio Community contributions are shared with eligible members; they are not private messages.</p><button type="button" data-support-review>Review my question</button><section data-support-preview hidden><h3>Exactly what this audience will see</h3><p data-preview-audience></p><p data-preview-chapter></p><p data-preview-question></p><p data-preview-excerpt></p><label class="support-confirm"><input type="checkbox" name="reviewed"/> I have reviewed this question, selected excerpt and audience.</label><button type="submit">Save question</button></section>
</form><p data-question-status role="status" aria-live="polite"></p><div data-support-records></div></details></section>
<script>import '../../scripts/contextualSupport';</script>
<style>
.chapter-community-question{margin:1.5rem 0 0;padding:1rem 1.15rem;background:#e4eadf;border-left:2px solid #6c8069;border-radius:3px}.chapter-community-question p{font-size:.9rem;line-height:1.6;overflow-wrap:anywhere}.chapter-community-question label{display:block;margin:.8rem 0;font-size:.9rem}.chapter-community-question select{display:block;max-width:100%;width:100%;padding:.65rem;font:inherit}.chapter-community-question textarea{display:block;width:100%;box-sizing:border-box;padding:.65rem;font:inherit;background:#fff;border:1px solid #9d9e94;resize:vertical;margin-top:.5rem}.chapter-community-question button{padding:.55rem .8rem;font:inherit;border:1px solid #7b826f;background:#faf8f2;border-radius:3px;min-height:2.75rem;cursor:pointer}.chapter-community-question button:disabled{background:#deded9;color:#4b5563;border-color:#8d918a;cursor:not-allowed;opacity:1}.chapter-community-question summary{cursor:pointer;font-weight:600}.chapter-community-question [hidden]{display:none!important}.support-channels{display:grid;gap:.7rem;margin:1rem 0}.support-channels article,[data-support-records] article{border-top:1px solid #b9c1b4;padding:.7rem 0}.support-channels h3{font:500 1.15rem/1.3 'Playfair Display',Georgia,serif;margin:.25rem 0}.support-channels p{margin:.4rem 0}.chapter-community-question [data-help]{min-height:1.8rem;min-width:1.8rem;border-radius:50%;padding:.1rem .3rem;margin-left:.4rem}.support-confirm{display:flex!important;align-items:flex-start;gap:.5rem}.support-confirm input{margin-top:.25rem;flex-shrink:0}[data-support-preview] p{white-space:pre-wrap}button:focus-visible,summary:focus-visible{outline:2px solid #315e67;outline-offset:3px}
.chapter-community-question :global([data-support-records] article){border-top:1px solid #b9c1b4;padding:.7rem 0}.chapter-community-question :global([data-support-records] button){padding:.55rem .8rem;min-height:2.75rem;font:inherit;border:1px solid #7b826f;background:#faf8f2;border-radius:3px;cursor:pointer}.chapter-community-question :global([data-support-records] p){font-size:.9rem;line-height:1.6;overflow-wrap:anywhere}.chapter-community-question :global([data-support-records] h4){font:500 1.1rem/1.4 'Playfair Display',Georgia,serif}.chapter-community-question :global([data-support-records] button:focus-visible){outline:2px solid #315e67;outline-offset:3px}</style>


