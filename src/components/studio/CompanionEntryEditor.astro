---
import {companionFingerprint} from '../../lib/studio/companion';
import {isLegacyBirdManuscript} from '../../lib/studio/readingText';
const {project,section=null,cards=[],sections=[],canWrite=true}=Astro.props;
const clientSection=section?{id:section.id,title:section.title,section_type:section.section_type,sort_order:section.sort_order,body_markdown:section.body_markdown,card_id:section.card_id,version_number:section.version_number,metadata:{studio_companion_v1:section.metadata?.studio_companion_v1,studio_book_v1:section.metadata?.studio_book_v1}}:null;
const initial={bookSections:sections.filter((s:any)=>s.metadata?.studio_book_v1?.surface==='front-cover').map((s:any)=>({metadata:{studio_book_v1:s.metadata.studio_book_v1}})),bookFingerprint:section?await companionFingerprint(section,sections):null,projectId:project.id,ownerId:project.owner_id,section:clientSection,legacyProse:section?isLegacyBirdManuscript(section):false,cards:cards.map((c:any)=>({id:c.id,title:c.title,number:c.card_number,version:c.version_number,content:Object.fromEntries(['meaning','shadow_meaning','symbolism','prompts','keywords'].map(key=>[key,typeof c.content?.[key]==='string'?c.content[key]:'']))})),art:project.settings?.visual_design_v1?.cards??{},canWrite};
---
<div data-companion-editor>
<script type="application/json" data-companion-initial set:html={JSON.stringify(initial).replaceAll('<','\\u003c')}/>
<div class="companion-entry-grid"><section class="studio-panel"><p class="studio-eyebrow">The Companion · reader-facing writing</p><h2>Give your reader a way in.</h2><p>This is a private manuscript draft. Editing or approving it does not publish anything or change the source card.</p><p data-companion-state role="status"></p><form data-companion-form><label class="studio-field">Entry title<input name="title" maxlength="160" required/></label><div class="entry-controls"><label class="studio-field">Kind of section<select name="type"><option value="card_entry">Card interpretation</option><option value="front_matter">Introduction or welcome</option><option value="instructions">How to use the deck</option><option value="chapter">Chapter</option><option value="closing">Closing reflections</option><option value="other">Other</option></select></label><div><label class="studio-field"><span>Manuscript position</span><input name="order" type="number" min="0" max="999" required aria-describedby="companion-order-help"/></label><p id="companion-order-help" class="small-note">Reading order, not card number. It does not reorder your deck.</p></div></div><label class="studio-field">Your reader-facing manuscript<textarea name="body" rows="18"/></label><details><summary>Read as your reader</summary><p class="small-note">An editorial reading preview, not exact typesetting or pagination. Private source notes are not included.</p><div data-reader-preview class="studio-readable-prose"/></details><div class="companion-actions"><button class="studio-button" type="submit" disabled={!canWrite}>Save companion entry</button><details class="studio-local-recovery"><summary>Recover unsaved work</summary><p>Keep a local copy of current editor state. Normal saved outputs are in Exports.</p><button type="button" class="studio-link-button" data-download-companion-draft>Recover this companion draft</button></details></div></form><details class="approval-panel"><summary>Creator approval</summary><p>Approval records your decision about this text. It is separate from Leilia's editorial review and from print-production readiness.</p><label class="approval-check"><input type="checkbox" data-confirm-approval/><span>I have reviewed this reader-facing text and the current source card, if linked.</span></label><button type="button" class="studio-button" data-approve-companion disabled={!canWrite}>Approve this reader-facing text</button></details><p data-companion-status role="status" aria-live="polite">Nothing is published by this editor.</p><a href={`/studio/projects/${project.id}/journey/?chapter=companion`}>Return to my Companion Manuscript</a>{section?<p><a href={`/studio/projects/${project.id}/guidebook/${section.id}/`}>Open this same section in the original guidebook editor</a></p>:null}</section>
<aside class="studio-panel"><p class="studio-eyebrow">Source and context</p><h2>Adapt, rather than start again.</h2><label class="studio-field">Card this entry belongs to<select data-source-card><option value="">General section — no card</option>{cards.map((c:any)=><option value={c.id}>{c.title}</option>)}</select></label><p data-source-version></p><img data-source-art hidden alt="Working artwork for the linked source card"/><p class="small-note">Artwork here is context only; it is not automatically included or approved in the manuscript.</p><fieldset><legend>Choose source material</legend>{[['meaning','Core meaning'],['shadow_meaning','Alternative or cautionary meaning'],['symbolism','Symbolism'],['prompts','Questions'],['keywords','Keywords']].map(([key,label])=><label class="approval-check"><input type="checkbox" data-source-field={key} checked={key==='meaning'}/><span>{label}</span></label>)}</fieldset><div data-source-preview/><div class="companion-actions"><button type="button" class="studio-link-button" data-copy-source disabled={!canWrite}>Use selected source as a new draft</button><button type="button" class="studio-link-button" data-record-source disabled={!canWrite}>Record this source version; keep my wording</button></div><p class="small-note">Copying is explicit. Private research, journals and other project content are not selected automatically. Source changes will ask for review, never replace your adaptation.</p><details><summary>Recorded source versions</summary><div data-recorded-sources/></details></aside></div>
</div>
<script>import {initCompanionEditor} from '../../scripts/companionEditor';document.querySelectorAll<HTMLElement>('[data-companion-editor]').forEach(initCompanionEditor);</script>
<style>.companion-entry-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:1.5rem;align-items:start}.companion-entry-grid>.studio-panel{grid-column:auto;min-width:0}.companion-entry-grid aside{position:sticky;top:1rem}.companion-entry-grid h2{font:clamp(1.8rem,3vw,2.5rem)/1.2 'Playfair Display',Georgia,serif}.companion-entry-grid p{line-height:1.7}.companion-entry-grid .studio-field{display:grid;gap:.5rem;margin:1.1rem 0;font-weight:600}.companion-entry-grid :is(input:not([type=checkbox]),select,textarea){width:100%;box-sizing:border-box;font:400 1rem/1.65 Inter,system-ui,sans-serif;padding:.8rem;border:1px solid #9d9e94;border-radius:4px;background:white;color:#242b2b}.companion-entry-grid textarea{resize:vertical}.entry-controls{display:grid;grid-template-columns:1.3fr 1fr;gap:1rem;align-items:start}.companion-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.5rem 0}.companion-entry-grid :is(.studio-button,.studio-link-button){min-height:3rem;box-sizing:border-box;padding:.7rem 1rem;font:600 .95rem/1.35 Inter,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center}.companion-entry-grid details{padding:1rem 0;border-top:1px solid #cec9c1}.companion-entry-grid summary{cursor:pointer;font-weight:600}.companion-entry-grid small,.small-note{font-size:.85rem;font-weight:400;color:#58605d}.approval-check{display:grid;grid-template-columns:1.1rem 1fr;gap:.65rem;margin:.8rem 0;line-height:1.5}.approval-check input{width:1.1rem;height:1.1rem;margin:.2rem 0 0}.companion-entry-grid fieldset{padding:1rem;border:1px solid #cec9c1}.companion-entry-grid img{width:100%;max-height:240px;object-fit:contain}.companion-entry-grid :global([data-source-preview] p){white-space:pre-wrap;overflow-wrap:anywhere}.companion-entry-grid :is(button,summary,a):focus-visible{outline:3px solid #065e73;outline-offset:3px}[data-companion-state]{padding:.8rem;background:#e4eadf}[data-companion-status]{padding:.8rem;border-left:3px solid #8a6a1f}@media(max-width:760px){.companion-entry-grid{grid-template-columns:1fr}.companion-entry-grid aside{position:static}.entry-controls{grid-template-columns:1fr}.companion-actions>*{width:100%}}</style>
