---
import {serviceTasks} from '../../lib/studio/serviceTaskSummary';
const {data}=Astro.props;const taskHref=(t:any)=>t.href==='#service-group-schedule'?'?view=schedule'+t.href:t.href.startsWith('#service-quote-')?'?view=quotes'+t.href:'?view=record&entry='+encodeURIComponent(t.entryId)+t.href;const groups=serviceTasks(data);const labels={requests:'Requests awaiting action',scheduling:'Sessions to arrange',sessions:'Sessions due or attendance to record',assessments:'Assessments awaiting delivery',deadlines:'Programme deadlines'};
---
<section class="task-summary" aria-labelledby="service-tasks-title"><h2 id="service-tasks-title">What needs attention</h2><p>Select a category, then open the action you need.</p><div class="task-categories">{Object.entries(groups).map(([key,tasks])=><button type="button" data-task-category={key} aria-expanded="false" aria-controls={'task-list-'+key}><strong data-task-count={key}>{tasks.length}</strong><span>{labels[key as keyof typeof labels]}</span></button>)}</div>{Object.entries(groups).map(([key,tasks])=><section id={'task-list-'+key} data-task-list hidden tabindex="-1"><h3>{labels[key as keyof typeof labels]}</h3>{tasks.length?<ul class="task-cards">{tasks.map(t=><li><p class="task-person">{t.member}</p><h4>{t.title}</h4><p class="task-state">{t.status??'Awaiting action'}{t.due&&<> · {t.dateLabel??'Due'} {new Date(t.due).toLocaleString('en-GB',{timeZone:'UTC'})} UTC</>}</p><a class="task-primary" href={taskHref(t)}>{t.action??'Open record'}</a></li>)}</ul>:<p>No outstanding items in this category.</p>}</section>)}<details class="task-context"><summary>About these task lists</summary><p>Session dates cover the next seven days and attendance still to record. Programme deadlines cover the next 30 days. Requests and invitations do not use an allocation.</p></details></section>
<script>import {initServiceTaskNavigation} from '../../scripts/serviceTaskNavigation';initServiceTaskNavigation();</script>
<style>.task-summary{padding:1.5rem;background:#f4eddf;color:#173f46;border:1px solid #b99d65;border-radius:.5rem;margin:1.5rem 0 2rem}.task-summary :is(h2,h3,p,a){color:#173f46}.task-categories{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.8rem}.task-categories button{display:flex;align-items:center;gap:.8rem;text-align:left;border:1px solid #8b754c;background:#fffaf0;color:#173f46;padding:1rem;font:inherit;border-radius:.35rem}.task-categories strong{font-size:1.6rem}.task-summary button:focus-visible,.task-summary a:focus-visible{outline:3px solid #173f46;outline-offset:3px}.task-summary li{margin:.8rem 0}[data-task-list]{margin-top:1.5rem}</style>
<style>.task-cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));gap:.9rem}.task-cards li{background:#fffdf7;border:1px solid #c6bcae;border-left:4px solid #315e67;padding:1rem;margin:0}.task-person{font-weight:700;margin:0 0 .25rem}.task-cards h4{font:500 1.25rem/1.35 Georgia,serif;margin:.3rem 0}.task-state{font-size:.9rem;margin:.4rem 0 .8rem}.task-primary{display:inline-block;font-weight:600;text-underline-offset:.2rem;padding:.4rem 0;min-height:44px;box-sizing:border-box}.task-context{margin-top:1rem}.task-context summary{cursor:pointer}</style>
