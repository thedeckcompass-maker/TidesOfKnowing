---
import EditorialPartnership from "./EditorialPartnership.astro";
import {editorialView} from "../../lib/studio/editorialPartnership";
import EditorialMemberOverview from "./EditorialMemberOverview.astro";
import EditorialHelp from "./EditorialHelp.astro";
import QuotationEvidenceRecord from "./QuotationEvidenceRecord.astro";
import ServiceQuoteRequests from "./ServiceQuoteRequests.astro";
import ServiceAddons from "./ServiceAddons.astro";
import ServiceTaskSummary from "./ServiceTaskSummary.astro";
import ServiceAssessment from "./ServiceAssessment.astro";
import {INITIAL_UNLOCK_DEVELOP_VERSION} from '../../lib/studio/serviceOffers';
import {serviceAllowancePresentation} from '../../lib/studio/serviceAllowancePresentation';
interface Props {admin?:boolean;editorial?:boolean;editorialContext?:any}
const {admin=false,editorial=false,editorialContext=null}=Astro.props;
const store=(Astro.locals as any).studioServiceRecords,actor=Astro.locals.user?.id;
const demonstration=editorial&&!admin&&(Astro.locals as any).studioEditorialDemonstration?.kind==='lexicon-develop-activity-v1'&&store?.demonstration===true;
const view=admin?(Astro.url.searchParams.get('view')??'overview'):'member';
let data:any={entries:[],groups:[]},error='';
try{if(!store||!actor)throw Error('Service records are not available yet.');data=admin&&view==='quotes'?{entries:[],groups:[],...await store.quotationRead(actor)}:await store.read(actor,admin);}catch(e){error=admin?(e as Error).message:'Your support details could not be loaded. Please try again later.';}
const assessmentSources:Record<string,any[]>={};if(!admin&&store?.assessmentSources&&(!editorial||editorialView(Astro.url.searchParams.get('view'))==='reviews'))for(const e of data.entries){if((!editorial||(!Astro.url.searchParams.get('entry')||Astro.url.searchParams.get('entry')===e.id))&&e.reviews.some((r:any)=>r.status==='requested'))try{assessmentSources[e.id]=await store.assessmentSources(actor,e.id);}catch{assessmentSources[e.id]=[];}}
const date=(value:string)=>new Date(value).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
const key=()=>crypto.randomUUID();
const selectedEntry=Astro.url.searchParams.get('entry');const shownEntries=admin?(view==='record'?data.entries.filter((e:any)=>e.id===selectedEntry):[]):data.entries;
---
<section class:list={["service-records",{"service-admin":admin}]}>
{demonstration&&<aside class="editorial-demo-notice" role="note" data-editorial-demonstration><h2>Private Develop demonstration — synthetic activity</h2><p>All programme activity, notes and dates below are illustrative. No consultation, group session, review, invitation or recording was delivered. No booking or payment can be made here.</p><p>The sample six-month programme and twelve-month Create period illustrate the recorded Develop contract; they do not extend your actual demonstration access, which ends on 17 December 2026 at 13:08 UTC.</p><a href="/studio/projects/04427ded-107d-4f08-8bcf-889770b1526a/">Open the Lexicon demonstration project</a>{data.demonstration?.milestones&&<details><summary>Illustrative programme development</summary><ul>{data.demonstration.milestones.map((item:string)=><li>{item}</li>)}</ul></details>}</aside>}
{editorial&&!admin?demonstration?<fieldset class="editorial-demo-readonly" disabled><legend>Read-only demonstration — navigation works; service actions are disabled</legend><EditorialPartnership data={data} sources={assessmentSources} error={error} context={editorialContext}/></fieldset>:<EditorialPartnership data={data} sources={assessmentSources} error={error} context={editorialContext}/>:<>
{!admin&&!editorial&&<EditorialHelp account={true}/>}
{error?<p role="status">{error}</p>:<>
{admin&&view==='overview'&&<div class="admin-overview"><ServiceTaskSummary data={data}/><aside class="admin-areas"><h2>Manage services</h2><a href="?view=schedule"><strong>Group scheduling</strong><span>Arrange shared sessions and invitations.</span></a><a href="?view=members"><strong>Member records</strong><span>Consultations, assessments, attendance and allocations.</span></a><a href="?view=quotes"><strong>Additional-work quotes</strong><span>Review requested scope and follow up.</span></a></aside></div>}
{admin&&view!=='overview'&&<p><a href="/ask-leilia/admin/studio-services/">← Back to service overview</a></p>}
{admin&&view==='members'&&<section><h2>Member records</h2><div class="admin-member-list">{data.entries.map((e:any)=><a href={'?view=record&entry='+encodeURIComponent(e.id)+'#service-entry-'+encodeURIComponent(e.id)}><strong>{e.name}</strong><span>{e.promise.benefits.name}</span></a>)}</div></section>}
{admin&&view==='record'&&!shownEntries.length&&<p>Select a <a href="?view=members">member record</a> to review its services.</p>}
{!admin&&!editorial&&<p>See your program dates, upcoming sessions and the services still available to you.</p>}


{view!=='quotes'&&!data.entries.length&&<p>You do not currently have an editorial support program listed here.</p>}
{shownEntries.map((entry:any)=>{
const remainingDays=Math.ceil((Date.parse(entry.promise.editorialEnds)-Date.now())/86400000),active=Date.now()>=Date.parse(entry.promise.start)&&remainingDays>0&&(entry.paymentAvailability?.editorial??true);
const consultationSummary=serviceAllowancePresentation(entry.promise.benefits.consultations,entry.consultations,'completed',entry.paymentAvailability?.consultations??entry.promise.benefits.consultations,active);
const reviewSummary=serviceAllowancePresentation(entry.promise.benefits.assessments,entry.reviews,'delivered',entry.paymentAvailability?.reviews??entry.promise.benefits.assessments,active);
const memberEditorial=editorial&&!admin&&['collaborate','develop'].includes(entry.promise.programme);
return <article id={"service-entry-"+encodeURIComponent(entry.id)}>{memberEditorial&&<EditorialMemberOverview entry={entry} groups={data.groups}/>}{!memberEditorial&&<h2>{admin?entry.name+' — ':''}{entry.promise.benefits.name}</h2>}
{memberEditorial?null:entry.promise.programme==='explore'?<p>Free Explore membership.</p>:entry.promise.programme==='explore-pass'?<p>Group sessions only. {entry.audit?.expires?'Expires on '+date(entry.audit.expires)+' (UTC).':'No expiry date.'} Your membership remains Explore.</p>:<p>Support dates: {date(entry.promise.start)} to {date(entry.promise.editorialEnds)}. Studio access until {date(entry.paymentAvailability?.createEndsAt??entry.promise.createEnds)}.</p>}
{entry.audit&&<p>Pass reason: {entry.audit.reason}</p>}
{entry.payment&&<p role="status">Payments received: {entry.payment.paidInvoiceIds.length} of {entry.payment.requiredPayments}. {entry.paymentAvailability?.state==='grace'?'A payment needs attention. Your seven-day grace period is active.':entry.paymentAvailability?.state==='resolution'?'New editorial bookings and deliverables are suspended during the fourteen-day resolution period. Create remains active.':['terminated','refunded'].includes(entry.paymentAvailability?.state)?'This paid entitlement has ended. Your Explore account, work and downloads remain available.':''} {entry.paymentAvailability?.releasePending?'Your individual services will be released under your recorded payment-stage agreement.':''}</p>}
{admin&&entry.payment?.billing==='instalments'&&entry.promise.version!==INITIAL_UNLOCK_DEVELOP_VERSION&&<form method="post" action="/api/studio/service-records" data-service-form><h3>Record the agreed editorial release</h3><p>Enter cumulative allocations for each payment stage. Final payment releases all purchased individual services. Earlier stages must leave some individual support for later payment.</p><input type="hidden" name="action" value="release-plan"/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="revision" value={entry.revision}/><input type="hidden" name="key" value={key()}/><label>Agreement reference<input name="agreementReference" required maxlength="300" value={entry.payment.releaseAgreement?.reference??''}/></label>{Array.from({length:entry.payment.requiredPayments},(_,i)=><fieldset><legend>After payment {i+1}</legend><label>Consultations released in total<input type="number" name={'consultations'+(i+1)} min="0" max={entry.promise.benefits.consultations} required value={entry.payment.releaseAgreement?.stages[i]?.consultations??(i+1===entry.payment.requiredPayments?entry.promise.benefits.consultations:undefined)}/></label><label>Written reviews released in total<input type="number" name={'reviews'+(i+1)} min="0" max={entry.promise.benefits.assessments} required value={entry.payment.releaseAgreement?.stages[i]?.reviews??(i+1===entry.payment.requiredPayments?entry.promise.benefits.assessments:undefined)}/></label></fieldset>)}<button>Save agreed release</button><p data-result role="status"></p></form>}

{admin&&entry.promise.programme==='explore'&&<form method="post" action="/api/studio/service-records" data-service-form><h3>Give a complimentary group pass</h3><input type="hidden" name="action" value="issue-pass"/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="revision" value={entry.revision}/><input type="hidden" name="key" value={key()}/><label>Number of group sessions<input name="quantity" type="number" min="1" step="1" required/></label><label>Expires on (optional, UTC)<input name="expiry" type="date"/></label><label>Reason<input name="reason" maxlength="500" required/></label><button>Issue group pass</button><p data-result role="status"></p></form>}
{entry.promise.programme!=='explore'&&<>{remainingDays<=30&&<p class="deadline">{remainingDays>0?`${remainingDays} days remain to arrange and complete the included services.`:'The editorial period has ended. Your service history remains available.'}</p>}
{!memberEditorial&&<dl><div><dt>Group sessions</dt><dd>{entry.groupsAttended} attended · {entry.groupsRemaining} remaining of {entry.promise.benefits.groups} included</dd></div>{entry.promise.benefits.consultations>0&&<div><dt>Private consultations</dt><dd>{consultationSummary.included} included · {consultationSummary.completed} completed · {consultationSummary.pending} pending · {consultationSummary.requestable} available to request now</dd></div>}{entry.promise.benefits.assessments>0&&<div><dt>Written assessments</dt><dd>{reviewSummary.included} included · {reviewSummary.completed} delivered · {reviewSummary.pending} pending · {reviewSummary.requestable} available to request now</dd></div>}</dl>}
<p>Pending consultations and assessments already have a request or allocation record; do not request them again. Group requests and invitations do not use a session allowance—attendance does.</p>
{entry.nextGroupRequested&&<p class="service-attention-label">Group session requested</p>}
{memberEditorial&&<h3 id={"included-benefits-"+entry.id} tabindex="-1">Use an included editorial benefit</h3>}
{!admin&&active&&<div class="actions">{([...(entry.groupsRemaining>0?[['request-group','Request the next group session']]:[]),...((entry.paymentAvailability?.consultations??entry.promise.benefits.consultations)>entry.consultations.length?[['consultation-request','Request a private consultation']]:[]),...((entry.paymentAvailability?.reviews??entry.promise.benefits.assessments)>entry.reviews.length?[['review-request','Request an assessment']]:[])]).map(([action,label])=><form method="post" action="/api/studio/service-records" data-service-form><input type="hidden" name="action" value={action}/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="revision" value={entry.revision}/><input type="hidden" name="key" value={key()}/><button>{label}</button><p data-result role="status"></p></form>)}</div>}
<div class:list={[{"member-service-grid":!admin}]}><section data-profile-area={!admin?"member-groups":undefined} id={!admin?"member-groups-"+encodeURIComponent(entry.id):undefined}><h3>Group invitations and attendance</h3>
{!data.groups.some((g:any)=>g.invitations.some((i:any)=>i.enrolmentId===entry.id))&&<p>No group date has been arranged yet.</p>}
{data.groups.filter((g:any)=>g.invitations.some((i:any)=>i.enrolmentId===entry.id)).map((g:any)=>{const invitation=g.invitations.find((i:any)=>i.enrolmentId===entry.id);return <section class="item" id={"service-group-"+encodeURIComponent(g.id)+"-"+encodeURIComponent(entry.id)}><h4>{g.title}</h4><p>{date(g.at)} · {g.at.slice(11,16)} UTC · {invitation.attended?'Attended':invitation.rsvp==='yes'?'RSVP: attending':invitation.rsvp==='no'?'RSVP: unable to attend':'Invited — awaiting response'}</p>{active&&!invitation.attended&&!(entry.promise.programme==='explore-pass'&&invitation.rsvp==='invited'&&!admin)&&<form method="post" action="/api/studio/service-records" data-service-form><input type="hidden" name="action" value={admin?'attend':'rsvp'}/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="groupId" value={g.id}/><input type="hidden" name="revision" value={entry.revision}/><input type="hidden" name="key" value={key()}/>{!admin&&<label>Your response<select name="choice"><option value="yes">I will attend</option><option value="no">I cannot attend</option></select></label>}<button>{admin?'Record attendance':'Save RSVP'}</button><p data-result role="status"></p></form>}</section>})}
</section><section data-profile-area={!admin?"member-consultations":undefined} id={!admin?"member-consultations-"+encodeURIComponent(entry.id):undefined}>{entry.promise.benefits.consultations>0&&<><h3>Private consultations</h3>{!admin&&<p>(We recommend bringing one completed card draft to your consultation. Together, we’ll check the essentials, strengthen your own editorial voice and shape the guidance for your intended audience, helping you develop the remaining cards with greater clarity and confidence.)</p>}{!entry.consultations.length&&<p>No consultation requested yet.</p>}{entry.consultations.map((c:any)=><section class="item" id={"service-consultation-"+encodeURIComponent(c.id)}><h4>{admin?entry.name+" · ":""}Private consultation</h4><p>{c.status==='requested'?'Requested':c.status==='scheduled'?'Scheduled':'Completed'}{c.date?' · '+date(c.date)+' · '+c.date.slice(11,16)+' UTC':''}</p>{admin&&active&&c.status!=='completed'&&<form method="post" action="/api/studio/service-records" data-service-form><input type="hidden" name="action" value={c.status==='requested'?'consultation-schedule':'consultation-complete'}/><input type="hidden" name="enrolmentId" value={entry.id}/><input type="hidden" name="itemId" value={c.id}/><input type="hidden" name="revision" value={entry.revision}/><input type="hidden" name="key" value={key()}/>{c.status==='requested'&&<label>Date and time (UTC)<input type="datetime-local" name="at" required/></label>}<button>{c.status==='requested'?'Schedule consultation':'Record completion'}</button><p data-result role="status"></p></form>}</section>)}
</>}{!admin&&entry.promise.benefits.consultations===0&&<><h3>Private consultations</h3><p>No private consultations are included in your current support.</p></>}</section><section data-profile-area={!admin?"member-assessments":undefined} id={!admin?"member-assessments-"+encodeURIComponent(entry.id):undefined}>{entry.promise.benefits.assessments>0&&<><h3>Written assessments</h3>{!admin&&<p>Use an included assessment for focused clarification of selected elements. Full manuscript editing is separate work.</p>}{!entry.reviews.length&&<p>No assessment requested yet.</p>}{entry.reviews.map((review:any)=><ServiceAssessment entry={entry} review={review} admin={admin} sources={assessmentSources[entry.id]??[]}/>) }</>}{!admin&&entry.promise.benefits.assessments===0&&<><h3>Written assessments</h3><p>No written assessments are included in your current support.</p></>}</section></div><p>{entry.promise.programme==='explore-pass'?'Requesting a session or replying to an invitation does not use your pass. A session is used only when attendance is recorded.':'Booking or replying to an invitation does not use an included service. Completed consultations, attended groups and delivered assessments are recorded separately.'}</p></>}
</article>})}
{admin&&view==='schedule'&&<section class="service-scheduling">{<form id="service-group-schedule" method="post" action="/api/studio/service-records" data-service-form><h2>Arrange a shared group session</h2><input type="hidden" name="action" value="schedule"/><input type="hidden" name="key" value={key()}/><label>Session title<input name="title" required maxlength="160"/></label><label>Date and time (UTC)<input name="at" type="datetime-local" required/></label><p>Members with available group sessions during their programme will see this invitation. A session can go ahead with one attendee.</p><button>Save session and invitations</button><p data-result role="status"></p></form>}</section>}
{admin&&view==='quotes'&&<ServiceQuoteRequests data={data} admin={admin}/>}
{admin&&view==='quotes'&&data.quotes?.filter((q:any)=>q.id===Astro.url.searchParams.get('quote')).map((quote:any)=><QuotationEvidenceRecord quote={quote}/>)}
</>}
{!admin&&<>{!editorial&&<ServiceAddons/>}<ServiceQuoteRequests data={error?{quotes:[]}:data} available={!error}/></>}
</>}
</section>
<script>
for(const form of document.querySelectorAll<HTMLFormElement>('[data-service-form]'))form.addEventListener('submit',async e=>{e.preventDefault();const result=form.querySelector<HTMLElement>('[data-result]')!,button=form.querySelector<HTMLButtonElement>('button[type="submit"]')??form.querySelector('button')!;button.disabled=true;try{const response=await fetch(form.getAttribute('action')!,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok)throw Error(data.error||'Could not save. Keep your entries and try again.');form.dispatchEvent(new Event("account-form-saved",{bubbles:true}));location.reload();}catch(error){result.textContent=(error as Error).message;button.disabled=false;}});
</script>
<style>.addon-options{margin:1.5rem 0}.addon-options button:disabled{background:#e9e5df;color:#56524c;border:1px solid #aaa49a;opacity:1;cursor:default}.service-records{max-width:65rem}.service-records article{padding:2rem 0;border-top:1px solid #c6bcae}.service-records form{margin:1rem 0}.service-records label{display:block;margin:.7rem 0}.service-records input,.service-records select{display:block;max-width:100%;width:26rem;box-sizing:border-box;padding:.7rem 1rem;font:inherit}.service-records button{padding:.7rem 1rem;font:inherit}.service-records dl{display:flex;flex-wrap:wrap;gap:1.5rem}.service-records dt{font-weight:bold}.service-records dd{margin:0}.service-records .actions{display:flex;flex-wrap:wrap;gap:1rem}.service-records .item{padding:1rem;border-left:2px solid #bdad91;margin:1rem 0}.deadline{font-weight:bold}h4{margin:.2rem 0}p{overflow-wrap:anywhere}</style>

<style is:global>.service-admin [id^="service-"],.service-admin [data-task-list]{scroll-margin-top:12rem}.service-admin article>h2{margin-top:0}.service-admin .service-attention-label{display:inline-block;padding:.35rem .65rem;background:#e2ece9;color:#173f46;font-weight:600;border-left:3px solid #315e67}.service-admin :focus-visible{outline:3px solid #315e67;outline-offset:4px}.service-admin dl{padding:.9rem;background:#f4f1e9}.service-admin article{margin-top:1rem;padding:1.25rem;border:1px solid #c6bcae;background:#fffdf7}.service-admin .item h4{font-size:1.1rem}.service-admin [tabindex="-1"]:focus{outline:2px solid #315e67;outline-offset:6px}</style>

<style is:global>.admin-overview{display:grid;grid-template-columns:minmax(0,2fr) minmax(15rem,1fr);gap:1.5rem;align-items:start}.admin-overview .task-summary{margin-top:0}.admin-areas{padding:1rem;background:#fffdf7;border:1px solid #c6bcae}.admin-areas h2{font-size:1.35rem;margin:0 0 .8rem}.admin-areas>a,.admin-member-list>a{display:block;padding:1rem 0;border-top:1px solid #d8d0c3;color:#173f46;text-decoration:none}.admin-areas strong,.admin-member-list strong{display:block;text-decoration:underline}.admin-areas span,.admin-member-list span{display:block;margin-top:.25rem;font-size:.95rem}.admin-member-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1.2rem}.service-admin{max-width:none}.admin-overview .task-categories{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:800px){.admin-overview{grid-template-columns:1fr}.admin-overview .task-categories{grid-template-columns:1fr}}
</style>

<style is:global>.service-admin article{color:#173f46}.service-admin article :is(h2,h3,h4,p,dt,dd,label){color:#173f46}.service-admin article a{color:#17566a}.admin-member-list{background:#fffdf7;padding:1rem;border:1px solid #c6bcae}.admin-member-list a{color:#173f46}</style>

<style is:global>.admin-areas h2{color:#173f46}</style>
<style>.editorial-demo-notice{padding:1.2rem;margin-block:1rem;background:#f3eee4;border-left:4px solid #b18b42}.editorial-demo-notice h2{margin-top:0;font-size:1.2rem}.editorial-demo-notice p{max-width:75ch}.editorial-demo-readonly{border:0;padding:0;margin:0;min-width:0}.editorial-demo-readonly legend{padding:.6rem 0;font-weight:600}</style>
