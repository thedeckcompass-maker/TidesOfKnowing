---
import {rightsReadingText} from '../../lib/studio/readingText';
import GuidebookOutline from './GuidebookOutline.astro';
import StudioEditorialSaveBar from './StudioEditorialSaveBar.astro';
import type {StudioCardFamily} from '../../lib/studio/types';
const {project,card,families=[],canWrite=true,error=false}=Astro.props as {project:any;card:any;families:StudioCardFamily[];canWrite?:boolean;error?:boolean};
const projectId=project.id,workspace={families},content=card.content??{};
const contentText=(key:string)=>typeof content[key]==='string'?content[key] as string:'';
---
<GuidebookOutline project={project} cardId={card.id} canWrite={canWrite}/>
<details open={!project.settings?.guidebook_outline_v1?.setupConfirmed}><summary>Card title, number and earlier notes</summary><div data-card-writing data-owner={project.owner_id} data-project={project.id} data-card={card.id}>
<p class="studio-eyebrow">The Expression · Your card writing desk</p><h2>Card details and early notes</h2><p>Keep the card’s title, printed number and earlier ideas here. Your chosen guidebook-entry sections appear above.</p>
<p data-writing-recovery role="status"></p>
      <form data-studio-read-only={!canWrite ? "true" : undefined} id="studio-card-editor" class="studio-form studio-form--two" method="post" action={`/api/studio/cards/${card.id}`}>
<input type="hidden" name="project_id" value={projectId} /><input type="hidden" name="expected_current_version" value={card.version_number} />
<label class="studio-field"><span>Card title</span><input name="title" required maxlength="120" value={card.title} /></label>
<label class="studio-field"><span>Card number or label</span><input name="card_number" maxlength="30" value={card.card_number} /></label>
<label class="studio-field studio-field--full"><span>Core meaning</span><textarea name="meaning">{contentText("meaning")}</textarea></label>
<details class="studio-field--full writing-details"><summary>Explore meanings, symbols and questions</summary><div class="writing-detail-grid"><label class="studio-field studio-field--full"><span>Shadow or cautionary meaning</span><textarea name="shadow_meaning">{contentText("shadow_meaning")}</textarea></label><label class="studio-field"><span>Keywords</span><textarea name="keywords">{contentText("keywords")}</textarea></label><label class="studio-field"><span>Cautions</span><textarea name="cautions">{contentText("cautions")}</textarea></label><label class="studio-field"><span>Symbolism</span><textarea name="symbolism">{contentText("symbolism")}</textarea></label><label class="studio-field"><span>Correspondences</span><textarea name="correspondences">{contentText("correspondences")}</textarea></label><label class="studio-field studio-field--full"><span>Prompts or questions</span><textarea name="prompts">{contentText("prompts")}</textarea></label></div></details>
<details class="studio-field--full writing-details"><summary>Research and artwork direction</summary><div class="writing-detail-grid"><label class="studio-field studio-field--full"><span>Private research notes</span><textarea name="research_notes">{contentText("research_notes")}</textarea></label><label class="studio-field"><span>Sources and attribution</span><textarea name="sources">{contentText("sources")}</textarea></label><label class="studio-field"><span>Cultural context</span><textarea name="cultural_context">{contentText("cultural_context")}</textarea></label><label class="studio-field studio-field--full"><span>Permissions and unresolved rights</span><textarea name="permissions">{contentText("permissions")}</textarea></label><label class="studio-field studio-field--full"><span>Artwork brief</span><textarea name="artwork_brief">{contentText("artwork_brief")}</textarea></label><label class="studio-field"><span>Artwork sourcing and permissions notes</span><small id="artwork-rights-help">Record where artwork comes from and whether permission has been checked. Pending notes do not mean permission is granted.</small><span class="studio-rights-summary">{rightsReadingText(contentText("rights_status")) || "No artwork sourcing or permissions notes yet."}</span><small>Edit these notes when the sourcing or permission changes:</small><textarea name="rights_status" aria-label="Artwork sourcing and permissions notes" aria-describedby="artwork-rights-help">{rightsReadingText(contentText("rights_status"))}</textarea></label><label class="studio-field"><span>Production notes</span><textarea name="production_notes">{contentText("production_notes")}</textarea></label></div></details>
<details class="studio-field--full writing-details"><summary>Collection details</summary><div class="writing-detail-grid"><label class="studio-field"><span>Order</span><input name="sort_order" type="number" min="0" max="999" value={card.sort_order} required /></label><label class="studio-field"><span>Status</span><select name="status"><option value="outline" selected={card.status === "outline"}>Outline</option><option value="draft" selected={card.status === "draft"}>Draft</option><option value="review" selected={card.status === "review"}>Review</option><option value="complete" selected={card.status === "complete"}>Complete</option></select></label><label class="studio-field studio-field--full"><span>Family</span><select name="family_id"><option value="">No family</option>{workspace.families.map((family) => <option value={family.id} selected={card.family_id === family.id}>{family.name}</option>)}</select></label></div></details>
<div class="studio-field--full"><button class="studio-button" type="submit" disabled={!canWrite}>Save card details</button></div>
      </form>
      <details class="studio-local-recovery"><summary>Recover unsaved work</summary><p>Keep a local copy of current editor state. Normal saved outputs are in Exports.</p><button class="studio-link-button" type="button" data-download-writing>Recover this writing draft</button></details><p class="writing-draft-help">Includes the writing currently on this page, even before saving. Artwork, earlier versions and the rest of the deck are not included.</p>
    {canWrite ? <StudioEditorialSaveBar formId="studio-card-editor" savedLabel={`Saved as version ${card.version_number}`} saveLabel="Save card details" error={Boolean(error)} /> : null}
</div>

</details>
<script>import {initWritingRecovery} from '../../lib/studio/cardWritingRecovery';document.querySelectorAll<HTMLElement>('[data-card-writing]').forEach(initWritingRecovery);</script>
<style>[data-card-writing] h2{font:clamp(1.8rem,3vw,2.5rem)/1.2 'Playfair Display',Georgia,serif}[data-card-writing] p{line-height:1.7}[data-card-writing] textarea[name=meaning]{min-height:18rem}[data-card-writing] :global(.studio-field--full){grid-column:1/-1}</style>

<style>.writing-details{border-top:1px solid #cec9c1;padding:1rem 0}.writing-details summary{cursor:pointer;font-weight:600;line-height:1.5}.writing-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}.writing-details :is(input,textarea,select){min-width:0}.writing-details summary:focus-visible{outline:3px solid #065e73;outline-offset:3px}@media(max-width:760px){.writing-detail-grid{grid-template-columns:1fr}}</style>
