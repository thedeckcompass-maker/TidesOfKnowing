---
import {guidebookOutline} from '../../lib/studio/guidebookOutline';
import {creativeInbox} from '../../lib/studio/creativeInbox';
const {project,cards}=Astro.props,outline=guidebookOutline(project.settings),inbox=creativeInbox(project.settings);
const initial=JSON.stringify({entries:inbox.entries,cards:cards.map((c:any)=>({id:c.id,title:c.title})),sections:outline.sections.filter(s=>!s.archived),ready:outline.setupConfirmed}).replace(/</g,'\\u003c');
---
<section class="studio-panel creator-capture" data-creator-capture data-project={project.id} data-owner={project.owner_id} data-stamp={project.updated_at}>
<h2>What would you like to capture?</h2>
<form data-capture-form><div class="capture-columns"><div>
<label class="studio-field">Writing<textarea name="text" rows="5" maxlength="20000" placeholder="A thought, a phrase, an image, a fragment that might become a card."/></label>
<div class="capture-actions"><button class="studio-button" type="submit">Save inspiration</button><p role="status" data-capture-status/></div>
<details class="capture-image"><summary>Add an image</summary><label class="studio-field">Artwork or photograph<input type="file" name="image" accept="image/png,image/jpeg"/></label><img data-capture-preview hidden alt="Your selected image"/><p data-image-note hidden>Your original remains on your device. A working preview and its reference are saved.</p></details>
</div><div><p class="capture-destination-help">Save an idea now. Choose a card later.</p><details><summary>Write directly to a card</summary>{outline.setupConfirmed?<div data-direct-fields><label class="studio-field">Destination<select name="mode"><option value="inspiration">Keep as inspiration</option><option value="card">Save and assign to a card</option></select></label><label class="studio-field" data-direct-card>Card<select name="cardId"><option value="">Choose an existing card</option>{cards.map((c:any)=><option value={c.id}>{c.title}</option>)}</select></label><label class="studio-field" data-capture-title>Working title<input name="title" maxlength="120"/></label><label class="studio-field" data-direct-section>Writing section<select name="sectionId"><option value="">Choose a section</option>{outline.sections.filter(s=>!s.archived).map(s=><option value={s.id}>{s.label}</option>)}</select></label><p class="capture-destination-help" data-direct-note>Your writing will be added to the selected card. Existing writing and artwork are kept.</p></div>:<p><a href={"/studio/projects/"+project.id+"/guidebook-outline/"}>Design your guidebook before assigning writing to cards.</a> You can save inspiration now.</p>}</details></div></div></form>
<section class="capture-recent" aria-labelledby="recent-inspiration-title"><h3 id="recent-inspiration-title">Recent inspiration</h3><p data-capture-empty>Your latest ideas will appear here, ready to revisit.</p><div data-capture-list/></section>
<script type="application/json" data-capture-initial set:html={initial}/>
</section>
<script>import '../../scripts/creatorInspiration';</script>
<style>.creator-capture{margin-block:1.5rem}.creator-capture>p{max-width:65ch}.capture-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(230px,1fr);gap:1.5rem}.capture-columns>div{display:grid;gap:.7rem;align-content:start}.capture-columns .studio-field{margin:0}.capture-columns textarea{width:100%;box-sizing:border-box}.capture-columns img{max-width:180px;max-height:220px;object-fit:contain}.capture-columns button{justify-self:start}.creator-capture [hidden]{display:none!important}@media(max-width:760px){.capture-columns{grid-template-columns:1fr}}</style>

<style>.creator-capture{margin:.5rem 0 0;background:#eee8f1;border-top:4px solid #c6a85a;padding:clamp(.85rem,2vw,1.4rem)}.creator-capture h2{font:400 clamp(1.25rem,2vw,1.65rem)/1.25 'Playfair Display',Georgia,serif;margin:0 0 .8rem}.capture-columns>div:last-child{padding:1rem;background:#edf0e7;border-radius:4px}.capture-actions{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem}.capture-actions p{margin:0;font-size:.9rem}.capture-image summary{cursor:pointer;font-weight:600;min-height:32px}.capture-image[open]{padding-top:.5rem}.capture-destination-help{font-size:.85rem;line-height:1.5;margin:0}.creator-capture :global(.studio-field-help-wrap){margin:0!important}@media(max-width:760px){.creator-capture{padding:.85rem}.capture-columns{gap:.8rem}.creator-capture textarea{height:8rem;min-height:8rem}.capture-columns>div:last-child{padding:.8rem}}</style>
<style>.capture-recent{margin-top:1.5rem}.capture-recent :global(article){padding:1rem;background:#fffaf0;border:1px solid #d8d0c0;margin:.75rem 0}.capture-recent :global(p){max-width:65ch;white-space:pre-wrap;overflow-wrap:anywhere}.capture-recent :global(img){max-width:160px;max-height:180px;object-fit:contain}.capture-recent :global(form){display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.6rem;align-items:end}.capture-recent :global(label){display:grid;gap:.3rem}.capture-recent :global(input),.capture-recent :global(select){width:100%;min-height:40px}.capture-recent :global(button){justify-self:start}.capture-recent :global(details summary){cursor:pointer;min-height:40px}.capture-recent :global([role=status]){grid-column:1/-1}</style>
