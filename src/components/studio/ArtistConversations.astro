---
import {artistConversationStore} from '../../lib/studio/artistDirectory';
const {artist=null,projectId=''}=Astro.props,store=artistConversationStore(Astro.locals),actor=Astro.locals.user?.id;
let canSubmit=false,projectListUnavailable=false,projects:any[]=[];
if(artist&&store&&actor){try{if((await store.canCreator(actor))===true){const r=await Astro.locals.supabase!.from('studio_projects').select('id,name').eq('owner_id',actor);if(r.error)throw Error('Project list unavailable');projects=r.data??[];canSubmit=projects.length>0;}}catch{canSubmit=false;projectListUnavailable=true;}}

---
<section class="artist-conversations" data-artist-conversations data-actor={actor} data-can-submit={String(canSubmit)}>
{!store&&<p role="status">Private shortlists and introductions are currently unavailable. Nothing has been submitted. You can use an artist’s contact link where they have approved sharing it.</p>}
{store&&artist&&<>{projectListUnavailable?<p role="status">Your project list could not be loaded. Refresh before preparing an introduction.</p>:!canSubmit&&<p>Choose an eligible project before saving a shortlist or preparing an introduction. <a href="/studio/?task=visual">Open my creative workspace</a>.</p>}<h3>Keep this artist with a project</h3><p>A shortlist note is private to you. An introduction shares only the brief preview below, with this artist. It never grants access to the project, cards or journal.</p><form method="post" action="/api/studio/artists/conversations" data-shortlist-form class="studio-form"><input type="hidden" name="action" value="shortlist"/><input type="hidden" name="artist_profile_id" value={artist.id}/><label class="studio-field"><span>My project</span><select name="project_id" data-artist-help="project" required disabled={!canSubmit}>{projects.map(p=><option value={p.id} selected={p.id===projectId}>{p.name}</option>)}</select></label><label class="studio-field"><span>Private shortlist note</span><input name="note" maxlength="1200" data-artist-help="shortlist"/></label><button class="studio-text-button" disabled data-conversation-submit type="submit">Save private shortlist note</button><p data-conversation-status role="status"/></form>
<details><summary>Prepare an introduction to {artist.professional_name}</summary><form method="post" action="/api/studio/artists/conversations" data-introduction-form class="studio-form"><fieldset disabled={!canSubmit}><input type="hidden" name="action" value="request"/><input type="hidden" name="expected_artist_name" value={artist.professional_name}/><input type="hidden" name="artist_profile_id" value={artist.id}/><label class="studio-field"><span>Project to name in the brief</span><select name="project_id" data-artist-help="project" required>{projects.map(p=><option value={p.id} selected={p.id===projectId}>{p.name}</option>)}</select></label><label class="studio-field"><span>My collaboration brief</span><textarea name="brief" minlength="50" maxlength="5000" required data-artist-help="brief" rows="5"/></label><details><summary>Add only an excerpt I choose, optional</summary><label class="studio-field"><span>Selected excerpt</span><textarea name="selected_excerpt" maxlength="2000" data-artist-help="excerpt" rows="3"/></label><p>Paste only words you want this artist to receive. Nothing is copied automatically.</p></details><label class="studio-field"><span>Timeline</span><input name="timeline" maxlength="800" data-artist-help="timeline"/></label><label class="studio-field"><span>Budget context</span><input name="budget_context" maxlength="800" data-artist-help="budget"/></label><p><strong>Recipient:</strong> {artist.professional_name}. This person receives the named project, exact brief/excerpt, timeline and budget context. They do not receive your whole project or private journal.</p><p><strong>Your contact after acceptance:</strong> {Astro.locals.user?.email}. Neither person's contact is released before the intended artist explicitly accepts.</p><button type="button" class="studio-button studio-button--secondary" data-preview-introduction>Preview exactly what I will share</button><div data-introduction-preview hidden role="region" aria-label="Introduction preview"/><label class="studio-check"><input type="checkbox" name="preview_confirmed" required/><span>I reviewed this exact brief for this artist.</span></label><label class="studio-check"><input type="checkbox" name="contact_share_confirmed" required/><span>I consent to mutual contact release only if this artist accepts.</span></label><label class="studio-check"><input type="checkbox" name="direct_contract_confirmed" required/><span>Contracts and payments remain directly between us.</span></label><button class="studio-button" type="submit" disabled data-conversation-submit>Submit introduction request</button><p data-conversation-status role="status"/></fieldset></form></details></>}
{store&&!artist&&<><h2>My shortlists and introductions</h2><p>Only your own shortlist notes and requests involving you appear here. No automatic email, booking or commission is created. Withdrawal stops future contact display here but cannot recall details already seen.</p><div data-conversation-records/><p data-conversation-load-status role="status"/></>}
</section>
<script>import {initArtistConversations} from '../../scripts/artistConversations';document.querySelectorAll<HTMLElement>('[data-artist-conversations]').forEach(initArtistConversations);</script>
<style>.artist-conversations{padding-block:1rem;border-top:1px solid #cec9c1}.artist-conversations :global(.studio-field){display:grid;gap:.45rem;margin-block:1rem}.artist-conversations :global(textarea){min-height:6rem}.artist-conversations :global(.studio-check){display:flex;gap:.6rem;align-items:start;margin-block:.8rem}.artist-conversations :global(.studio-check input){flex:none;width:1.1rem;height:1.1rem;margin-top:.25rem}.artist-conversations :global([data-introduction-preview]){white-space:pre-wrap;padding:1rem;background:#f4f0e7;border:1px solid #cec9c1;overflow-wrap:anywhere}.artist-conversations :global(.introduction-record){padding:1rem 0;border-bottom:1px solid #cec9c1;overflow-wrap:anywhere}.artist-conversations :global(.introduction-record p){white-space:pre-wrap}.artist-conversations :global(.response-actions){display:flex;gap:.5rem;flex-wrap:wrap}</style>
