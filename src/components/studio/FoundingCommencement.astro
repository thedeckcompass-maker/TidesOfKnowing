---
const {member,access,preview,enabled=false,values={},uncertain=false,saved=null}=Astro.props;
const retryKey=values.key||crypto.randomUUID();
const ownerAdmin=Astro.locals.user?.id==='7e3224e7-b303-4150-a45e-dd9a12efdb68'&&Astro.locals.profile?.id===Astro.locals.user?.id&&Astro.locals.profile?.role==='admin'&&Astro.locals.profile?.status==='active';
---
{ownerAdmin&&member&&(access||values.key)&&<section class="founding-commencement" aria-labelledby="commencement-heading"><h2 id="commencement-heading">Founding collaboration commencement</h2><p>{member.display_name} — {member.email||member.id}</p><p>Leilia confirms commencement only after the agreement, payment confirmation and start date are settled. Both introductory sessions carry no obligation to proceed.</p>{saved?.receipt&&<p role="status">Saved commencement: {saved.receipt.collaborationStarts}. Personal support ends {saved.receipt.supportEnds}; founding platform period ends {saved.receipt.platformEnds}.</p>}<form method="post"><input type="hidden" name="userId" value={member.id}/><input type="hidden" name="key" value={retryKey}/><input type="hidden" name="version" value={values.version||access?.updated_at||''}/><input type="hidden" name="agreement" value="founder"/><label>Explicitly agreed collaboration start date<input name="collaborationStarts" type="date" value={values.collaborationStarts||""} required/></label><label><input type="checkbox" name="agreementConfirmed" checked={values.agreementConfirmed==='on'} required/> The founding collaboration agreement is confirmed.</label><label><input type="checkbox" name="paymentVerified" checked={values.paymentVerified==='on'} required/> Payment has been independently confirmed.</label><label>Interface onboarding completed (with timezone)<input name="onboardingCompleted" value={values.onboardingCompleted||''} placeholder="YYYY-MM-DDTHH:mm:ssZ" required={enabled}/></label><label>Personal setup completed (with timezone)<input name="setupCompleted" value={values.setupCompleted||''} placeholder="YYYY-MM-DDTHH:mm:ssZ" required={enabled}/></label><button class="studio-button studio-button--secondary" name="operation" value="founding-preview" type="submit" formnovalidate>Review entitlement dates</button><button class="studio-button" name="operation" value="founding-confirm" type="submit" disabled={!enabled||!access||uncertain||!!saved?.confirmation}>Confirm commencement</button>{uncertain&&<button class="studio-button studio-button--secondary" name="operation" value="founding-reconcile" type="submit" formnovalidate>Check saved commencement</button>}</form>{preview&&<><h3>Starts {preview.collaborationStarts}</h3><p>Personal support ends {preview.supportEnds}. Founding platform access ends {preview.platformEnds}. Dates use the member's recorded timezone, {access?.time_zone||'unavailable'}.</p></>}{!enabled&&<p id="commencement-disabled">Commencement is not available for this account in the current configuration. Reviewing dates does not change access.</p>}<p role="note">If a future confirmation cannot be verified, check its saved receipt and current access before retrying. An interrupted response does not establish whether access changed.</p></section>}
<style>.founding-commencement{max-width:75ch}.founding-commencement form{display:grid;gap:1rem}.founding-commencement label{display:grid;gap:.4rem}.founding-commencement input:not([type=checkbox]){min-height:44px;font:inherit;padding:.6rem}.founding-commencement button{min-height:44px;margin-top:1rem}.founding-commencement p{line-height:1.7}</style>

