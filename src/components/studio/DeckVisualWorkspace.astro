---
import {visualDefaults,cardSizePresets} from '../../lib/studio/visualDesign';
import {lockableKeys} from '../../lib/studio/deckDesign';
const {project,cards,card,mode='deck',canWrite=true}=Astro.props;
const sampleId=card?.id??cards[0]?.id??'sample';
const saved=project.settings?.visual_design_v1;
const originalRetention=(Astro.locals as any).studioOriginalMediaLocal===true;
const initial={originalRetention,originalRegistry:project.settings?.original_artwork_v1??{version:1,assets:[],bindings:{cards:{},commonBack:null,references:{}}},mode,readOnly:!canWrite,ownerId:project.owner_id,hasSavedBoard:!!saved,projectId:project.id,updatedAt:project.updated_at,cardId:card?.id??cards[0]?.id??'',cards:cards.map((c:any)=>({id:c.id,title:c.title,number:c.card_number})),board:saved??{defaults:{...visualDefaults,elements:'artwork'},cards:{},references:[],commonBack:'',notes:'',locked:[],deckConfigured:false}};
const typography=[['title','Title'],['number','Number']];
const positions=[['titleSize','Title size'],['titleX','Title left / right'],['titleY','Title up / down'],['numberSize','Number size'],['numberX','Number left / right'],['numberY','Number up / down'],['qrX','QR left / right'],['qrY','QR up / down'],['qrSize','QR size']];
const lockGroups=[{label:'Artwork responsibilities',keys:['elements']},{label:'Border and background',keys:['border','borderColor','background']},{label:'Title styling and position',keys:['titleFont','titleSize','titleColor','titleX','titleY']},{label:'Number styling and position',keys:['numberFont','numberSize','numberColor','numberX','numberY']},{label:'Back arrangement',keys:['backMode','symmetry']},{label:'QR position and size',keys:['qrX','qrY','qrSize']}];
---
<section class:list={['deck-visual',`deck-visual--${mode}`]} data-deck-visual>
<script type="application/json" data-initial set:html={JSON.stringify(initial).replaceAll('<','\\u003c')}/>
{mode==='deck'?<div class="deck-setup-intro"><p class="studio-panel__intro">Choose the size and shared look for your whole deck. Then add artwork beside each card’s writing. Physical card size is always shared.</p><label class="studio-field"><span>MakePlayingCards card size</span><select data-preset><option value="legacy" disabled>Existing size — choose a supported size</option>{cardSizePresets.map(p=><option value={p.id}>{p.name} · {p.width} × {p.height} in</option>)}</select></label><p data-sizing-notice role="status"></p></div>:<><h2>Card artwork</h2><p data-sizing-notice role="status"></p><p class="deck-working-note">Shared card size and locked components are set in <a href={`/studio/projects/${project.id}/journey/?chapter=visual-world&design=1`}>Deck design</a>.</p></>}
<div class="deck-viewer">
 <div class="deck-viewer__tools">{mode==='deck'?<label class="studio-field deck-sample"><span>Shared layout preview</span><select data-sample>{cards.length?cards.map((c:any)=><option value={c.id}>{c.card_number?`${c.card_number} · `:''}{c.title}</option>):<option value="sample">Sample card</option>}</select></label>:null}<div role="tablist" aria-label="Card side">{['front','back','both'].map((side,i)=><button type="button" role="tab" tabindex={i===0?0:-1} aria-controls={`visual-panel-${sampleId}`} aria-selected={i===0?'true':'false'} data-view={side}>{side[0].toUpperCase()+side.slice(1)}</button>)}</div><button type="button" data-expand-preview>View larger card</button><label>Zoom <input data-zoom type="range" min="40" max="200" value="100" step="10"/><output data-zoom-label>100%</output></label></div>
 <p data-dimensions class="studio-meta"></p><div id={`visual-panel-${sampleId}`} class="deck-preview-scroll" role="tabpanel" tabindex="0" aria-label="Full-card preview. Fit view shows the complete card."><div class="deck-preview-canvas" data-canvas>
 {['front','back'].map(side=><div class="deck-sheet" data-sheet={side}><div data-sample-art class="artwork-empty">Add {side} artwork using the image controls.</div><img data-art={side} alt={side==='front'?'Your card artwork':'Your card back'} hidden/><div class="deck-trim" data-trim={side}>{side==='front'?<><span data-title></span><span data-number></span><div data-qr></div></>:null}</div><div class="deck-trim-guide" data-trim-guide></div><div class="deck-safe-guide" data-safe-guide></div></div>)}
 </div></div><p data-preview-card-label></p><p data-guide-help></p>
 </div>
<div data-editable><details open={mode==='deck'}><summary>Artwork specifications</summary><pre class="artwork-instructions" data-production-spec></pre><button type="button" class="studio-link-button" data-artwork-instructions>Download artwork instructions</button></details><label class="studio-field"><span>Who supplies the card design elements?</span><select data-style="elements"><option value="artwork">Complete artwork: titles, numbers and borders are in my image</option><option value="studio">Studio adds titles, numbers and supported borders</option></select></label>
{mode==='card'?<><label class="studio-field"><span>Front artwork</span><input data-upload="front" type="file" accept="image/jpeg,image/png,image/webp"/></label><p>Use artwork or a reference image to explore the layout. Fit shows the whole image; Fill crops the edges. Your source file is unchanged. This working JPEG preview is up to 1,000 pixels and is not print-ready.</p></>:null}
<details open={mode==='deck'}><summary>{mode==='deck'?'Shared appearance':'Artwork layout'}</summary><div class="studio-form-grid">
<label class="studio-field" data-studio-elements><span>Border</span><select data-style="border"><option value="none">None</option><option value="full">Full</option><option value="bottom">Bottom only</option></select></label><label class="studio-field" data-studio-elements><span>Border color</span><input data-style="borderColor" type="color"/></label><label class="studio-field"><span>Background</span><input data-style="background" type="color"/></label><label class="studio-field"><span>Artwork fit</span><select data-style="fit"><option value="contain">Fit entire image</option><option value="cover">Fill</option></select></label>
<label class="studio-field"><span>Artwork left / right</span><input data-style="artX" type="range" min="0" max="100"/></label><label class="studio-field"><span>Artwork up / down</span><input data-style="artY" type="range" min="0" max="100"/></label><label class="studio-field"><span>Artwork enlargement</span><input data-style="artZoom" type="range" min="100" max="200" step="5"/></label><p>Position and enlarge the preview inside the card. Cropping does not change your original file.</p></div></details>
<details data-studio-elements><summary>Title and numbering</summary><p>These controls apply only when you choose Studio-managed elements. Your uploaded original is unchanged.</p><div class="studio-form-grid">{typography.map(([key,label])=><><label class="studio-field"><span>{label} font</span><select data-style={`${key}Font`}>{['Georgia','Arial','Verdana','Times New Roman'].map(f=><option value={f}>{f}</option>)}</select></label><label class="studio-field"><span>{label} color</span><input data-style={`${key}Color`} type="color"/></label></>)}{positions.slice(0,6).map(([key,label])=><label class="studio-field"><span>{label}</span><input data-style={key} type="range" min="0" max={key.endsWith('Size')?'18':'100'} step="1"/></label>)}</div></details>
<details><summary>Card backs</summary>{mode==='deck'?<><label class="studio-field"><span>Back arrangement</span><select data-style="backMode"><option value="common">Same back on every card</option><option value="individual">Different artwork on each back</option></select></label><label class="studio-field"><span>Shared back image</span><input data-upload="commonBack" type="file" accept="image/jpeg,image/png,image/webp"/></label><label class="deck-checkbox"><input data-style="symmetry" type="checkbox"/><span>I want the back to be symmetrical</span></label><p>This is a design preference for your artist, not an automatic image effect. Explain whether you want mirror symmetry or a back that matches after a half-turn.</p></>:<label class="studio-field"><span>Individual back image (when the deck uses different backs)</span><input data-upload="back" type="file" accept="image/jpeg,image/png,image/webp"/></label>}</details>
{mode==='deck'?<><fieldset><legend>Keep these components the same on every card</legend><p>Tick a group to lock it for the whole deck. Untick it here to allow individual styling later.</p>{lockGroups.map(g=><label class="deck-checkbox"><input type="checkbox" data-lock={g.keys.join(',')}/><span>{g.label}</span></label>)}</fieldset><details><summary>Private visual references</summary><label class="studio-field"><span>Add an image showing the look you have in mind</span><input data-upload="reference" type="file" accept="image/jpeg,image/png,image/webp"/></label><div data-references></div><label class="studio-field"><span>Visual intention and source notes</span><textarea data-notes rows="4"></textarea></label></details></>:<details><summary>Optional link and QR</summary><p>Add a link to music, a video or another webpage. We’ll turn it into a QR code. Before printing, scan a printed sample with your phone. Printed codes keep their original link; changing it needs a new code.</p><label class="studio-field"><span>Link</span><input data-media="url" type="url" placeholder="https://"/></label><label class="studio-field"><span>Where should the QR code appear?</span><select data-media="qrPlacement"><option value="guidebook">Guidebook only</option><option value="card">Card only</option><option value="both">Card and Guidebook</option><option value="neither">Neither</option></select></label><div data-qr-preview aria-label="Generated QR code preview"></div><label class="studio-field"><span>Link label (optional)</span><input data-media="mediaLabel" maxlength="200"/></label>{positions.slice(6).map(([key,label])=><label class="studio-field"><span>{label}</span><input data-style={key} type="range" min={key==='qrSize'?1:0} max="100"/></label>)}{[['destinationConfirmed','I checked that my readers can open the link'],['rightsConfirmed','I have permission to share the content'],['proofConfirmed','I scanned a printed sample and it opened the right content']].map(([key,label])=><label class="deck-checkbox"><input type="checkbox" data-media={key}/><span>{label}</span></label>)}<details class="studio-local-recovery"><summary>Recover unsaved work</summary><p>Keep a local copy of current editor state. Normal saved outputs are in Exports.</p><button class="studio-link-button" type="button" data-download-qr>Recover current QR (SVG)</button></details></details>}
<div data-resize-review hidden class="studio-notice" role="alert"><h3>Review the whole-deck size change</h3><p data-resize-impact></p><p>Artwork may crop differently and text, borders and QR codes need checking. Original files and the previous saved design stay in your history.</p><div class="studio-actions"><button class="studio-button" type="button" data-confirm-resize>Confirm and save deck design</button><button class="studio-link-button" type="button" data-cancel-resize>Cancel size change</button></div></div>
{originalRetention?<section data-original-tools><p>This local test saves the original and preview privately when you choose an image. Layout choices save separately. Keep backups private: originals may include camera or location metadata.</p><details><summary>Originals and image quality</summary><p data-original-resolution></p><p>Pixel information is advisory. Cropping and zoom change the pixels available at the chosen card size; no detail is invented by upscaling. Check color, permissions, supplier requirements and a physical proof separately.</p><ul data-original-history></ul></details><div data-original-pending hidden><p>This upload has not been confirmed. Keep the original file and use Retry image upload; it checks the same upload safely. Choose the file again if you reload.</p><button type="button" class="studio-link-button" data-original-retry>Retry image upload</button><button type="button" class="studio-link-button" data-original-download-pending>Download this unsaved original</button></div><p><a href={`/studio/projects/${project.id}/exports/`}>Open complete project backup with retained originals</a>. The visual draft download below contains previews and settings only.</p></section>:<p>Original files are not retained by this preview-only upload. Keep your source files separately.</p>}
<div class="studio-actions"><button class="studio-button" type="button" data-save>{mode==='deck'?'Save deck design':'Save card artwork'}</button><details class="studio-local-recovery"><summary>Recover unsaved work</summary><p>Keep a local copy of current editor state. Normal saved outputs are in Exports.</p><button class="studio-link-button" type="button" data-download>{originalRetention?'Download visual draft (previews)':'Download visual backup'}</button></details></div>
</div><p data-status role="status" aria-live="polite"></p>
<dialog class="deck-expanded" data-expanded-preview><button type="button" data-close-preview>Close larger view</button><div data-expanded-viewer></div></dialog></section>
<script>import {initDeckWorkspace} from '../../lib/studio/deckWorkspaceClient';document.querySelectorAll<HTMLElement>('[data-deck-visual]').forEach(initDeckWorkspace);</script>
<style>
.deck-visual{min-width:0}.deck-visual--deck{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 1.2rem}.deck-visual--deck>.deck-setup-intro{grid-column:1 / 9;grid-row:1}.deck-visual--deck>[data-editable]{grid-column:1 / 9;grid-row:2}.deck-visual--deck>.deck-viewer{grid-column:9 / 13;grid-row:1 / 4;position:sticky;top:1.25rem;align-self:start;margin-top:0}.deck-visual--deck>[data-status]{grid-column:1 / 9}.deck-sample{width:100%;margin-top:0!important}.deck-visual--deck .deck-preview-scroll{height:28rem}.deck-visual--deck .deck-viewer__tools{gap:.65rem}.deck-visual summary{cursor:pointer;font:400 1.3rem/1.4 var(--font-heading);color:var(--tok-deep-ocean)}.deck-visual details{padding:1rem 0;border-block-end:1px solid var(--tok-studio-rule)}.deck-visual details[open] summary{margin-bottom:1rem}.deck-visual p{line-height:1.6;color:var(--tok-studio-muted);font-size:.94rem}.deck-visual button{min-height:3rem;font:600 .92rem/1.4 var(--font-body);cursor:pointer}.deck-visual .studio-field{margin:1rem 0}.deck-visual input[type=color]{min-height:3rem}.deck-visual input[type=range]{padding:0;accent-color:var(--tok-studio-teal)}.deck-checkbox{display:grid;grid-template-columns:1.1rem minmax(0,1fr);gap:.65rem;align-items:start;margin:.8rem 0;cursor:pointer;line-height:1.55}.deck-checkbox input{width:1.1rem;height:1.1rem;padding:0;margin:.2rem 0 0;accent-color:var(--tok-studio-teal)}.deck-visual fieldset{margin:1.2rem 0;padding:1rem;border:1px solid var(--tok-studio-rule)}.deck-visual legend{font-family:var(--font-heading);font-size:1.2rem}.deck-visual .studio-actions{margin-top:1.2rem}.deck-visual .studio-link-button{background:var(--tok-studio-card)}.deck-visual :is(input,button,select,summary):focus-visible{outline:3px solid var(--tok-studio-gold-ink);outline-offset:3px}.deck-visual [data-status]:not(:empty){padding:1rem;background:var(--tok-studio-paper-soft);border-left:3px solid var(--tok-studio-gold-ink)}
.deck-viewer{margin:1rem 0 1.5rem}.deck-viewer__tools{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;justify-content:space-between}.deck-viewer__tools [role=tablist]{display:flex;gap:.35rem}.deck-viewer__tools button{padding:.45rem .75rem;border:1px solid var(--tok-studio-rule);border-radius:var(--radius-md);background:var(--tok-studio-card);color:var(--tok-deep-ocean)}.deck-viewer__tools button[aria-selected=true]{background:var(--tok-studio-gold);border-color:var(--tok-studio-gold)}.deck-viewer__tools label{display:flex;align-items:center;gap:.5rem}.deck-viewer__tools input{width:7rem}
.deck-preview-scroll{height:clamp(23rem,60vh,36rem);overflow:auto;border:1px solid var(--tok-studio-rule);border-radius:var(--radius-md);background:var(--tok-studio-paper-soft);padding:1.2rem;touch-action:pan-x pan-y}.deck-preview-canvas{display:flex;gap:24px;align-items:flex-start;width:max-content;min-width:100%;padding:1px}.deck-sheet{position:relative;flex:none;background:var(--tok-studio-card);box-shadow:var(--shadow-sm)}.deck-sheet[hidden]{display:none}.deck-trim{position:absolute;overflow:hidden;isolation:isolate;container-type:inline-size}.deck-sheet>img{position:absolute;inset:0;width:100%;height:100%}.deck-trim span{position:absolute;transform:translate(-50%,-50%);max-width:94%;text-align:center;line-height:1.15;z-index:2;overflow-wrap:anywhere}.deck-trim [data-qr]{position:absolute;z-index:3;aspect-ratio:1;background:white}.deck-trim svg{width:100%;height:100%;display:block}.deck-trim-guide,.deck-safe-guide{position:absolute;pointer-events:none;z-index:5;border:1px dashed var(--tok-studio-teal)}.deck-safe-guide{border-color:var(--tok-studio-gold-ink)}.deck-visual :global([data-references] figure){margin:1rem 0;padding:1rem;border:1px solid var(--tok-studio-rule)}.deck-visual :global([data-references] img){width:100%;max-height:180px;object-fit:contain}.deck-visual :global([data-references] textarea){width:100%;min-height:4rem;padding:.7rem;border:1px solid var(--tok-studio-rule);font:inherit}
@media(max-width:760px){.deck-visual--deck{display:block}.deck-visual--deck>.deck-viewer{position:static;margin:1.25rem 0}.deck-visual--deck .deck-preview-scroll{height:25rem}.deck-visual .studio-form-grid{grid-template-columns:minmax(0,1fr)}.deck-visual .studio-actions>*{width:100%}.deck-preview-scroll{height:28rem;padding:.75rem}}
</style>

<style>.deck-sheet{overflow:hidden}.deck-sheet>[data-sample-art]{position:absolute;inset:0;width:100%;height:100%}.deck-sheet>[data-sample-art][hidden]{display:none}.deck-visual .studio-button,.deck-visual .studio-link-button{box-sizing:border-box;min-height:3rem;padding:.7rem 1rem;display:inline-flex;align-items:center;justify-content:center}.deck-visual--card .deck-preview-scroll{height:34rem}.deck-visual--card .deck-preview-scroll{min-width:0}.deck-visual .studio-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.deck-visual--card .studio-form-grid{grid-template-columns:1fr}@media(max-width:760px){.deck-visual--card .deck-preview-scroll{height:30rem}}</style>

<style>.deck-working-note{font-size:.85rem!important;line-height:1.6;font-weight:400;text-transform:none;letter-spacing:normal}</style>

<style>.deck-visual--deck>[data-original-tools]{grid-column:1 / 9}[data-original-tools] li{margin:.6rem 0;overflow-wrap:anywhere}[data-original-pending] button{margin:.4rem .4rem .4rem 0}</style>




<style>.artwork-empty{display:flex;align-items:center;justify-content:center;padding:1rem;box-sizing:border-box;background:#f6f3eb;text-align:center;color:#42575a;font:14px/1.5 system-ui,sans-serif}</style>

<style>.deck-visual .artwork-instructions{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.6;max-width:72ch}.deck-expanded{width:min(95vw,1100px);max-height:94dvh;box-sizing:border-box;padding:1rem;border:1px solid var(--tok-studio-rule)}.deck-expanded::backdrop{background:#0009}.deck-visual .deck-expanded .deck-preview-scroll{height:70dvh;padding:.75rem}.deck-visual .deck-preview-scroll{box-sizing:border-box}.deck-visual [data-qr-preview]{width:9rem;max-width:100%;background:white}.deck-visual [data-qr-preview] :global(svg){width:100%;height:auto}.deck-visual [hidden]{display:none!important}</style>
