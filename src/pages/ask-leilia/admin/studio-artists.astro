---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudioHeader from '../../../components/studio/StudioHeader.astro';
import {isAdminProfile} from '../../../lib/community/auth';
import {artistPortfolioStore} from '../../../lib/studio/artistPortfolioProvider';
import '../../../styles/studio.css';
export const prerender=false;
if(!Astro.locals.user||Astro.locals.profile?.id!==Astro.locals.user.id||!isAdminProfile(Astro.locals.profile))return new Response('Not found.',{status:404});
const store=artistPortfolioStore(Astro.locals);let queue:any[]=[],unavailable=!store?.hosted;
if(!unavailable){try{queue=await store.reviewQueue(Astro.locals.user.id)}catch{unavailable=true}}
---
<BaseLayout description="Private artist portfolio review for Deck Creator Studio administrators." title="Artist portfolio review | Deck Creator Studio" studioWorkspace={true} tdcPlacement="none" metaRobots="noindex,nofollow"><main class="studio-page page-inner"><a href="/ask-leilia/admin/studio-services/">Return to DCS administration</a><StudioHeader title="Artist portfolio review" lede="Review submitted portfolios before they appear to eligible deck creators. Artist registration is managed separately."/>
{unavailable?<p role="status">Portfolio review is not connected yet.</p>:!queue.length?<p>No portfolios are awaiting review.</p>:queue.map(({profile:a,contact}:any)=><article class="studio-panel portfolio-review"><h2>{a.professional_name}</h2><p>{a.location} · {a.time_zone}</p><p>{a.biography}</p><p>{a.artistic_statement}</p><dl>{[['Mediums',a.mediums.join(', ')],['Techniques',a.techniques.join(', ')],['Styles',a.styles.join(', ')],['Subjects',a.subjects.join(', ')],['Languages',a.languages.join(', ')],['Creative process',a.process_disclosure],['Experience',a.publishing_experience],['Availability',a.availability],['Budget approach',a.budget_approach],['Licensing',a.licensing_preferences],['Collaboration',a.collaboration_models.join(', ')],['Private contact email',contact?.contact_email??'Not supplied'],['Private website',contact?.website_url??'']].map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><div class="portfolio-examples">{a.portfolio_examples.map((e:any)=><figure>{new URL(e.url).origin===Astro.url.origin&&new URL(e.url).pathname.startsWith('/api/artists/portfolio/')?<img src={e.url} alt={e.title} loading="lazy"/>:<a href={e.url} target="_blank" rel="noopener noreferrer">{e.title}</a>}<figcaption>{e.description}</figcaption></figure>)}</div><form data-portfolio-review><input type="hidden" name="id" value={a.id}/><input type="hidden" name="expected_updated_at" value={a.updated_at}/><label class="studio-field">Directory decision<select name="status" required><option value="">Choose a decision</option><option value="approved">Approve directory listing</option><option value="declined">Decline directory listing</option></select></label><button class="studio-button">Save review</button><p role="status"/></form></article>)}
</main></BaseLayout>
<script>document.querySelectorAll<HTMLFormElement>('[data-portfolio-review]').forEach(form=>{form.onsubmit=async e=>{e.preventDefault();const button=form.querySelector('button')!,status=form.querySelector('[role=status]')!;button.disabled=true;try{const r=await fetch('/api/studio/artists/review',{method:'POST',body:new FormData(form)}),data=await r.json();if(!r.ok)throw Error(data.error);status.textContent=data.message;form.querySelector('select')!.disabled=true;}catch(e){status.textContent=(e as Error).message;button.disabled=false}}});</script>
<style>.portfolio-review{margin-top:1.5rem}.portfolio-review p,.portfolio-review dd{max-width:70ch;white-space:pre-wrap;overflow-wrap:anywhere}.portfolio-review dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.portfolio-review dd{margin:.35rem 0}.portfolio-review dt{font-weight:600}.portfolio-examples{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.portfolio-examples figure{margin:0}.portfolio-examples img{max-width:100%;max-height:300px;object-fit:contain}.portfolio-review form{display:grid;gap:1rem;margin-top:1.5rem;justify-items:start}</style>
