---
import ArtistConversations from '../../../components/studio/ArtistConversations.astro';
import ArtistProfileCard from '../../../components/studio/ArtistProfileCard.astro';
import {artistDraftProfile,validateArtistDraft} from '../../../lib/studio/artistDraft';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudioHeader from '../../../components/studio/StudioHeader.astro';
import ArtistPortfolioUpload from '../../../components/studio/ArtistPortfolioUpload.astro';
import {artistRegistrationStore} from '../../../lib/studio/artistRegistrationProvider';
import {artistPortfolioStore} from '../../../lib/studio/artistPortfolioProvider';
import '../../../styles/studio.css';
export const prerender=false;
if(!Astro.locals.user)return Astro.redirect('/auth/login/?redirectTo=/artists/collaborate/',303);
if(Astro.locals.profile?.id!==Astro.locals.user.id||Astro.locals.profile.status!=='active')return new Response('Sign in with your active account.',{status:403});
const store=artistPortfolioStore(Astro.locals);let portfolioUnavailable=!store,profile:any=null,contact:any=null,mediaHeads:Record<string,string>={},published:any=null;try{if(store)({profile,contact,mediaHeads={},published=null}=await store.snapshot(Astro.locals.user.id))}catch{portfolioUnavailable=true}const examples=profile?.portfolio_examples??[];const registrationStore=artistRegistrationStore(Astro.locals);
let registration={role:'',revision:0},registrationUnavailable=!registrationStore;try{if(registrationStore)registration=await registrationStore.registration(Astro.locals.user.id);}catch{registrationUnavailable=true;}
let savedDraft:any=null;try{savedDraft=await store?.loadDraft?.(Astro.locals.user.id)}catch{}
const view=Astro.url.searchParams.get('view'),previewProfile=savedDraft?artistDraftProfile(validateArtistDraft(savedDraft.fields)):profile;const hasPublished=Boolean(published);
---
<BaseLayout description="Create and manage the portfolio that deck creators will see." title="My artist portfolio | Deck Creator Studio" studioWorkspace={true} tdcPlacement="none" metaRobots="noindex,nofollow" bodyClass="tok-body--studio"><main class="studio-page page-inner artist-workspace"><StudioHeader title="My artist portfolio" lede="Create and manage the portfolio that deck creators will see."/><div class="artist-columns"><section class="studio-panel"><h2>Your role in the Studio</h2>{registrationUnavailable&&<p role="status">Your artist registration could not be loaded. Existing registration has not been changed. Reload before saving your role.</p>}<p>Choose artist, deck creator or both for this account.</p><form class="studio-form artist-role-form" data-artist-registration data-revision={registration.revision}><label class="studio-field">I am joining as<select name="role" required><option value="">Choose your role</option><option value="artist" selected={registration.role==='artist'}>Submitting artist</option><option value="creator" selected={registration.role==='creator'}>Deck creator</option><option value="both" selected={registration.role==='both'}>Both</option></select></label><button class="studio-button" disabled={registrationUnavailable}>Save my role</button><p data-registration-status role="status"/></form><p><a href="/artists/visual-design-exchange/">View shared visual briefs</a> · <a href="/studio/community/">Section community</a> · <a href="/studio/">My deck projects</a></p></section><aside class="studio-panel"><h2>Working with deck creators</h2><p>Approved artists can be discovered and contacted directly by eligible deck creators.</p><p>You manage your own discussions and agreements. DCS does not arrange collaborations.</p><a href="/studio/artists/">Find artists</a></aside></div>
{(profile||savedDraft||hasPublished)&&<section class="studio-panel artist-status"><h2>{hasPublished?'Published profile: Approved':profile?.status==='submitted'?'Submitted':profile?.status==='declined'?'Declined':'Draft'}</h2><p>{hasPublished?((savedDraft&&!savedDraft.submitted_at)||profile?.status==='submitted'?'Changes in progress':'Your artist profile is published.'):profile?.status==='submitted'?'Your portfolio is awaiting review.':profile?.status==='declined'?'Your portfolio was not approved.':'Your portfolio is saved but not submitted.'}</p>{hasPublished&&<><p>Your approved profile remains visible while you prepare changes.</p><a class="studio-link-button" href="?view=published">View approved profile</a></>}<a class="studio-text-button" href="?view=edit">{hasPublished?'Edit profile':'Continue editing'}</a>{savedDraft?.fields?.professional_name&&<a class="studio-text-button" href="?view=preview">Preview</a>}</section>}
{view==='published'&&published?<section class="studio-panel"><ArtistProfileCard artist={published} preview={true}/><a href="?view=edit">Edit profile</a></section>:<div class="artist-columns artist-edit-columns"><section class="studio-panel"><h2>Build your artist portfolio</h2>{portfolioUnavailable&&<p role="alert">Your portfolio could not be loaded. Please try again.</p>}<fieldset disabled={portfolioUnavailable} class="artist-outer"><form data-artist-profile data-artist-steps data-preview-mode={view==='preview'} data-owner={Astro.locals.user.id} data-has-published={hasPublished} id="artist-application" class="studio-form" method="post" action="/api/artists/collaborate"><p data-step-progress aria-live="polite">Step 1 of 6 · Your professional details</p><p data-step-save role="status" aria-live="polite"></p><fieldset data-artist-step="0" class="artist-step"><legend>Your professional details</legend><label class="studio-field"><span>Professional name</span><input name="professional_name" required maxlength="120" value={profile?.professional_name ?? ""} /></label>
            <div class="studio-form-grid">
              <label class="studio-field"><span>Location</span><input name="location" maxlength="160" value={profile?.location ?? ""} /></label>
              <label class="studio-field"><span>Time zone</span><input name="time_zone" maxlength="80" value={profile?.time_zone ?? ""} /></label>
            </div>
            <label class="studio-field"><span>Languages, separated by commas</span><input name="languages" required value={profile?.languages.join(", ") ?? ""} /></label>
            </fieldset>
<fieldset data-artist-step="1" class="artist-step"><legend>About your work</legend><label class="studio-field"><span>Biography</span><textarea name="biography" required minlength="40" maxlength="3000">{profile?.biography ?? ""}</textarea></label>
            <label class="studio-field"><span>Artistic statement</span><textarea name="artistic_statement" required minlength="40" maxlength="3000">{profile?.artistic_statement ?? ""}</textarea></label>
            </fieldset>
<fieldset data-artist-step="2" class="artist-step"><legend>Your artistic practice</legend><div class="studio-form-grid">
              <label class="studio-field"><span>Mediums</span><input name="mediums" required value={profile?.mediums.join(", ") ?? ""} /></label>
              <label class="studio-field"><span>Techniques</span><input name="techniques" value={profile?.techniques.join(", ") ?? ""} /></label>
              <label class="studio-field"><span>Styles</span><input name="styles" required value={profile?.styles.join(", ") ?? ""} /></label>
              <label class="studio-field"><span>Subjects</span><input name="subjects" value={profile?.subjects.join(", ") ?? ""} /></label>
            </div>
            <label class="studio-field"><span>Creative-process disclosure</span><select name="process_disclosure" required>
              <option value="human_created" selected={profile?.process_disclosure === "human_created"}>Human-created physical practice</option>
              <option value="digital_non_generative" selected={profile?.process_disclosure === "digital_non_generative"}>Digital, without generative AI</option>
              <option value="ai_assisted" selected={profile?.process_disclosure === "ai_assisted"}>AI-assisted process</option>
              <option value="generative_ai" selected={profile?.process_disclosure === "generative_ai"}>Generative-AI process</option>
            </select></label>
            </fieldset>
<fieldset data-artist-step="3" class="artist-step"><legend>Experience & collaboration</legend><label class="studio-field"><span>Card, guidebook, packaging or campaign experience</span><textarea name="publishing_experience" maxlength="2000">{profile?.publishing_experience ?? ""}</textarea></label>
            <label class="studio-field"><span>Availability</span><textarea name="availability" required minlength="10" maxlength="1200">{profile?.availability ?? ""}</textarea></label>
            <label class="studio-field"><span>Budget approach</span><textarea name="budget_approach" required minlength="10" maxlength="1200">{profile?.budget_approach ?? ""}</textarea></label>
            <label class="studio-field"><span>Licensing preferences</span><textarea name="licensing_preferences" required minlength="10" maxlength="1200">{profile?.licensing_preferences ?? ""}</textarea></label>
            <label class="studio-field"><span>Collaboration models, separated by commas</span><input name="collaboration_models" required value={profile?.collaboration_models.join(", ") ?? ""} /></label>
            </fieldset>
<fieldset data-artist-step="4" class="artist-step"><legend>Portfolio examples</legend><ArtistPortfolioUpload enabled={!portfolioUnavailable}/><input type="hidden" name="media_heads" value={JSON.stringify(mediaHeads)}/><fieldset class="studio-fieldset"><legend>Your portfolio examples</legend><p class="artist-example-count" data-example-count>One to eight examples. Empty spaces can stay empty.</p>
              {Array.from({ length: 8 }, (_, index) => {
                const example = examples[index];
                const number = index + 1;
                return <details class="artist-example" data-example={number} open={false}><summary>{example?.url&&new URL(example.url).origin===Astro.url.origin&&new URL(example.url).pathname.startsWith('/api/artists/portfolio/')?<img src={example.url} alt=""/>:null}<span>{example?.title || `Example ${number}`}</span></summary><button type="button" class="studio-text-button" data-replace-example={number}>Replace example</button>
                  <label class="studio-field"><span>Example {number} image or portfolio URL</span><input type="url" name={`portfolio_url_${number}`} required={number === 1} value={example?.url ?? ""} /></label><p data-example-url-help></p>
                  <label class="studio-field"><span>Example {number} title</span><input name={`portfolio_title_${number}`} required={number === 1} maxlength="160" value={example?.title ?? ""} /></label>
                  <label class="studio-field"><span>Short description</span><input name={`portfolio_description_${number}`} maxlength="500" value={example?.description ?? ""} /></label><button type="button" class="studio-button studio-button--secondary" data-close-example>Close example</button>
                </details>;
              })}
            </fieldset>
            </fieldset>
<fieldset data-artist-step="5" class="artist-step"><legend>Preview & submit</legend><p>Not published — this is how your saved profile will appear after approval.</p>{previewProfile&&<ArtistProfileCard artist={previewProfile} preview={true}/>}<div class="studio-field"><span>Registered contact email</span><p>{Astro.locals.user.email}</p><input type="hidden" name="observed_email" value={Astro.locals.user.email}/></div><label class="studio-check studio-check--standalone"><input type="checkbox" name="contact_disclosure_confirmed" required/><span>I agree that, once my profile is approved, my verified registration email may be shared with eligible deck creators who choose to contact me.</span></label>
            <label class="studio-check studio-check--standalone"><input type="checkbox" name="display_rights_confirmed" required /><span>I confirm that I have the right to display the artwork and portfolio material included in this profile.</span></label>
            <div class="artist-final-actions"><button type="button" class="studio-button studio-button--secondary" data-artist-edit>Edit profile</button><button class="studio-button" type="submit">Submit for review</button><button type="button" class="studio-text-button" data-artist-draft>Download my application draft</button></div></fieldset><div class="artist-step-actions"><button type="button" class="studio-button studio-button--secondary" data-artist-back>Back</button><button type="button" class="studio-button" data-artist-next>Save &amp; Next</button><button type="button" class="studio-text-button" data-artist-retry hidden>Retry save</button></div><input type="hidden" name="expected_updated_at" value={profile?.updated_at??''}/></form></fieldset><p data-artist-save-status role="status" aria-live="polite"/></section><aside class="studio-panel artist-context"><h2>Your portfolio</h2><p data-step-help>Tell deck creators who you are and where you work.</p><p>Your draft is private until you submit it for review and it is approved.</p></aside></div>}<section class="studio-panel"><ArtistConversations/></section></main></BaseLayout>
<script>import '../../../scripts/studioFieldWisdom';import {initArtistSteps} from '../../../scripts/artistSteps';import {initArtistProfile} from '../../../scripts/artistProfile';initArtistSteps();initArtistProfile();</script>
<style>.artist-workspace{max-width:1200px;margin-inline:auto}.artist-columns{display:grid;grid-template-columns:minmax(0,65fr) minmax(0,35fr);gap:24px;align-items:start;margin-block:24px}.artist-columns>.studio-panel,.artist-status{margin:0;padding:clamp(24px,2.5vw,32px)}.artist-status{margin-block:24px}.artist-workspace p{max-width:70ch}.artist-outer,.artist-step{border:0;padding:0;margin:0;min-width:0}.artist-step{display:grid;gap:1rem}.artist-step[hidden]{display:none}.artist-step legend{font-size:1.35rem;font-weight:600;margin-bottom:1rem}.artist-step-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:24px}.artist-workspace :global(input:not([type=checkbox])),.artist-workspace :global(select){min-height:42px;box-sizing:border-box}.artist-example{padding:1rem;border:1px solid #cec9c1;border-radius:.4rem}.artist-example summary{display:flex;align-items:center;gap:.75rem;cursor:pointer}.artist-example summary img{width:72px;height:72px;object-fit:cover}.artist-example[open]{display:block}.artist-context{position:sticky;top:6rem}.artist-workspace :global(.studio-header){padding-block:1rem;margin-bottom:24px}@media(max-width:760px){.artist-columns{grid-template-columns:1fr}.artist-context{position:static}.artist-workspace :global(.studio-form-grid){grid-template-columns:1fr}.artist-step-actions button{min-height:44px}}</style>
<script>import {roleSavedMessage} from '../../../lib/studio/artistPresentation';const form=document.querySelector<HTMLFormElement>('[data-artist-registration]');if(form)form.onsubmit=async e=>{e.preventDefault();const status=form.querySelector('[data-registration-status]')!,button=form.querySelector('button')!;button.disabled=true;try{const r=await fetch('/api/artists/registration',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:new FormData(form).get('role'),revision:Number(form.dataset.revision)})}),v=await r.json();if(!r.ok)throw Error(v.error);form.dataset.revision=String(v.revision);status.textContent=roleSavedMessage(v.role ?? new FormData(form).get('role'))}catch(e){status.textContent=(e as Error).message}finally{button.disabled=false}};</script>
<style>[data-artist-step="4"] :global(.studio-fieldset){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}[data-artist-step="4"] :global(.studio-fieldset legend){grid-column:1/-1}.artist-example[hidden]{display:none}.artist-example[open]{grid-column:1/-1}@media(max-width:600px){[data-artist-step="4"] :global(.studio-fieldset){grid-template-columns:1fr}}</style>

<style>.artist-columns>.studio-panel{grid-column:auto}.artist-workspace [hidden]{display:none!important}.artist-workspace .studio-panel h2{font-size:clamp(1.5rem,2vw,2rem)}</style>

<style>[data-step-save]:empty{display:none}.artist-workspace input:not([type=checkbox]):not([type=hidden]),.artist-workspace select{height:44px;padding-block:8px}.artist-role-form+p{margin-top:24px}</style>

<style>.artist-status a{display:inline-block;margin-right:16px;margin-top:8px}.artist-final-actions{display:flex;gap:16px;flex-wrap:wrap}.artist-workspace .studio-check span{text-transform:none}</style>

<style>.artist-example-count{grid-column:1/-1}.artist-example summary{min-height:72px}.artist-example [data-example-url-help]{font-size:.9rem;line-height:1.5;margin-block:8px}.artist-example button{justify-self:start}</style>
