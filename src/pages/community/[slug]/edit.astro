---
import {dcsParticipationAccess} from '../../../lib/community/dcsParticipation';
import {isDcsHistoryPost,parkedCommonsResponse} from '../../../lib/community/practiceCommons';
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CommunityPostForm from "../../../components/community/CommunityPostForm.astro";
import { isAdminProfile } from "../../../lib/community/auth";
import { getCommunityPostBySlug, getCommunitySections } from "../../../lib/community/queries";
import { communityPostPath } from "../../../lib/community/slugs";

export const prerender = false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');

if (!Astro.locals.user) return Astro.redirect("/auth/register/", 303);

const slug = Astro.params.slug ?? "";
const post = Astro.locals.supabase ? await getCommunityPostBySlug(Astro.locals.supabase, slug) : null;
if (!post || !isDcsHistoryPost(post)) return parkedCommonsResponse();
const denied=await dcsParticipationAccess(Astro.locals);if(denied)return denied;

const canEdit = Astro.locals.user.id === post.author_id && post.status === "published";
if (!canEdit) return Astro.redirect(communityPostPath(post.slug), 302);


---

<BaseLayout
  title={`Edit ${post.title} | Studio community | Tides of Knowing`}
  description="Edit a Studio community post."
  metaRobots="noindex, nofollow"
>
  <main class="community-edit page-inner">
    <p class="community-edit__kicker">Studio community</p>
    <h1>Edit post</h1>
    <form method="post" action={`/api/community/posts/${post.id}`}>
      <input type="hidden" name="intent" value="edit" />
      <label>Title<input name="title" value={post.title} minlength="8" maxlength="140" required /></label>
      <label>Discussion<textarea name="body" minlength="20" maxlength="12000" required>{post.body}</textarea></label>
      <button type="submit">Save changes</button>
      <a href={communityPostPath(post.slug)}>Return to discussion</a>
    </form>
  </main>
</BaseLayout>

<style>
  .community-edit {
    max-width: 44rem;
    padding: clamp(1.25rem, 4vw, 3.5rem) 0 clamp(3rem, 8vw, 5rem);
  }

  .community-edit__kicker {
    margin: 0 0 0.5rem;
    font-size: var(--tok-type-meta);
    letter-spacing: var(--tok-letter-upper);
    text-transform: uppercase;
    color: var(--tok-gold-deep);
  }

  .community-edit h1 {
    margin: 0 0 1.25rem;
    font-family: var(--font-accent);
    font-size: clamp(2rem, 7vw, 3.5rem);
    font-weight: 400;
    color: var(--tok-water);
  }
</style>
