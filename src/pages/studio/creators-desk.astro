---
import {BRAINSTORM_FIELDS} from '../../lib/studio/brainstorm';
import {creatorDeskTiles,loadCreatorDesk} from '../../lib/studio/creatorDesk';
import {prepareLexiconEditorialDemo} from '../../lib/studio/lexiconEditorialDemo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {studioAccountAccessResponse,loadStudioGuidance} from '../../lib/studio/access';

import '../../styles/studio.css';
export const prerender=false;
if(!Astro.locals.user)return Astro.redirect('/auth/login/?redirectTo=%2Fstudio%2Fcreators-desk%2F');
const denied=await studioAccountAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase);if(denied)return denied;
const db=Astro.locals.supabase!,owner=Astro.locals.user.id;

const demonstration=await prepareLexiconEditorialDemo(Astro.locals,Astro.url.origin);
const serviceRecords=demonstration?.provider??(Astro.locals as any).studioServiceRecords;
const desk=await loadCreatorDesk(db,owner,serviceRecords,Astro.locals.serverRuntime?.env?.STUDIO_DEPLOYMENT_TARGET==='lexicon-preview'&&!serviceRecords);
const entries=desk.entries??[],projects=desk.projects??[],loadError=desk.inspirationState!=='ready'||desk.projects===null;
const guidance=await loadStudioGuidance(db,owner,Astro.locals.profile,projects.map((p:any)=>p.id));
const context=projects.find((p:any)=>p.id===Astro.url.searchParams.get('project'));
const tiles=creatorDeskTiles(context?.id,desk.editorialState);
const mode=Astro.url.searchParams.get('capture'),captureMode=['choose','inspiration','project','brainstorm'].includes(mode??'')?mode:null;
const initial=JSON.stringify({entries,projects}).replace(/</g,()=>String.fromCharCode(92)+'u003c'),bookmark=new URL('/studio/creators-desk/',Astro.url.origin).href;
---
<BaseLayout title="Creator’s Desk | Deck Creator Studio" studioWorkspace={true} tdcPlacement="none" metaRobots="noindex, nofollow" description="Manage your private deck creation projects and Studio workspace.">
<main class="studio-page page-inner account-desk" data-account-desk data-owner={owner}>
<nav class="studio-breadcrumbs" aria-label="Breadcrumb"><a href="/studio/?orientation=skip">Studio</a><span aria-hidden="true"> / </span><span>Creator’s Desk</span></nav>
<header><p class="studio-eyebrow">Your private creative space</p><h1>Creator’s Desk</h1><p>Choose what you want to work on. Your ideas and projects stay private until you choose to share.</p></header>
<nav class="desk-tiles" aria-label="Start working">{tiles.map(tile=><a href={tile.href} data-capture-open={tile.label==='Capture an idea'?'choose':undefined}><strong>{tile.label}</strong><span>{tile.description}</span></a>)}</nav>
{desk.editorialState==='unavailable'&&<p role="status">Editorial programme details could not be checked. <a href="/studio/editorial-support/">Open Editorial Support</a> to check your recorded support.</p>}
{desk.editorialState==='disabled-preview'&&<p role="status">Editorial services are disabled for this private demonstration. Programme details have not been checked; the temporary demonstration grant does not include sessions or service delivery. <a href="/studio/editorial-support/">Editorial Support</a> remains available for guidance.</p>}
{demonstration&&<p role="note">Editorial Support contains labelled, read-only Develop demonstration activity. No real consultation, group booking or programme entitlement has been created.</p>}
{desk.projects===null&&<p role="alert">Your projects could not be loaded. Existing projects and captures have not been changed.</p>}
{loadError?<p role="alert">{desk.inspirationState==='missing-contract'?'Saved inspiration is not connected in this preview yet. Capturing is unavailable until its storage is installed; your existing project work has not been changed.':desk.inspirationState!=='ready'?'Your saved inspiration could not be loaded. Keep any unsaved writing locally and retry before capturing.':'Capturing is unavailable while your project list cannot be checked. Your saved inspiration has not been changed.'}</p>:<>
{guidance==='studio'?<p>Your active Studio access supports your creative workspace. Continue your projects or review your programme in Editorial Support.</p>:<p>Continue your authorised projects and private ideas here. Project tools follow your current access; <a href="/studio/exports/">Exports</a> shows the work available to download.</p>}<section id="capture" class="studio-panel account-capture" data-capture-panel data-mode={captureMode??'choose'} hidden={!captureMode}><h2 tabindex="-1" data-capture-title>Capture an idea</h2><nav aria-label="Capture intention" class="capture-choices"><a href="?capture=inspiration#capture" data-capture-open="inspiration">Independent inspiration</a><a href="?capture=project#capture" data-capture-open="project">For a project or card</a><a href="?capture=brainstorm#capture" data-capture-open="brainstorm">Brainstorm an idea</a></nav><p data-capture-intro>Choose how you want to keep this idea. Brainstorming does not create a project.</p>
<form data-account-capture hidden={captureMode==='choose'}><button type="button" class="studio-text-button" data-discard-capture>Discard unsaved capture</button>
<fieldset class="capture-choices" hidden><legend class="studio-help-sr-only">Capture destination</legend><label><input type="radio" name="path" value="inspiration" checked/> Capture inspiration</label><label><input type="radio" name="path" value="project"/> Write for a project or card</label></fieldset>
<div data-destination hidden><div data-destination-controls>
<label class="studio-field">Project<select name="project"><option value="">Choose a project</option>{projects.map(p=><option value={p.id}>{p.name}</option>)}</select></label>
<label class="studio-field" data-card-choice hidden>Keep this idea with<select name="scope"><option value="project">Project only</option><option value="card">An existing card</option></select></label>
<label class="studio-field" data-card-field hidden>Card<select name="card"><option value="">Choose a card</option></select></label>
<label class="studio-field" data-section-field hidden>Writing section<select name="section"><option value="">Choose a section</option></select></label>
<p data-template-message hidden/><button type="button" class="studio-button studio-button--secondary" data-use-destination>Use this destination</button></div>
<p data-destination-summary hidden><span/> <button type="button" class="studio-text-button" data-change-destination>Change</button></p></div>
<div data-writing><fieldset data-brainstorm hidden={captureMode!=='brainstorm'}><legend>Explore a possible deck</legend><p>Use any prompts that help. Each save keeps a new private inspiration entry; reopen it below to continue exploring. No project is created.</p>{BRAINSTORM_FIELDS.map(([key,label])=><label class="studio-field">{label}<textarea name={'brain_'+key} rows="3" maxlength="3000"/></label>)}</fieldset><label data-simple-writing class="studio-field" hidden={captureMode==='brainstorm'}>Your idea<textarea name="text" rows="5" maxlength="20000"/></label>
<details class="account-image"><summary>Add an image</summary><label class="studio-field">Artwork or photograph<input name="image" type="file" accept="image/jpeg,image/png"/></label><img data-image-preview hidden alt="Selected inspiration image"/><p data-image-note hidden>A working preview is saved. Keep your original file separately.</p></details>
<button type="submit" class="studio-button" data-save>Save inspiration</button></div><p role="status" data-status/></form></section>
<details class="desk-bookmark"><summary>Bookmark your Creator’s Desk</summary><p><a href={bookmark}>Your permanent Desk link</a>. On desktop, use Ctrl+D or Cmd+D. On mobile, use your browser’s Bookmark or Add to Home Screen option when available. Saving requires an internet connection.</p></details>
<section class="studio-panel account-recent"><h2>Recent inspiration</h2><div data-recent/><p data-empty>Your latest ideas will appear here, ready to revisit.</p></section>
</>}
<details class="desk-related"><summary>Desk help and related work</summary><a href="/studio/?orientation=skip">My projects and existing project captures</a><a href="/studio/welcome/?from=%2Fstudio%2Fcreators-desk%2F">Welcome to the Studio</a>{context&&<a href={`/studio/projects/${context.id}/?view=project`}>Existing captures in {context.name}</a>}</details>
<script type="application/json" data-account-initial set:html={initial}/>
</main></BaseLayout>
<script>import '../../scripts/accountCreatorDesk';</script>
<style>.account-desk{padding-top:1.25rem}.account-desk header{margin:.75rem 0 1rem}.account-desk h1{font-size:clamp(1.7rem,3vw,2.4rem);margin:.25rem 0}.account-desk h2{font-size:clamp(1.3rem,2vw,1.65rem);margin:.2rem 0 .8rem}.account-capture{background:#eee8f1;border-top:4px solid #c6a85a;padding:1.25rem clamp(1.25rem,2.4vw,1.75rem)}.capture-choices{display:flex;flex-wrap:wrap;gap:.7rem 1.5rem;border:0;padding:0;margin:0 0 1rem}.capture-choices label{display:flex;align-items:center;gap:.5rem;min-height:2.5rem}.capture-choices input{width:auto}.account-desk textarea{width:100%;box-sizing:border-box;min-height:8rem;max-width:80ch}.account-desk [data-writing]{display:grid;gap:.65rem}.account-desk [data-save]{justify-self:start}.account-desk [data-destination-controls]{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;background:#edf0e7;padding:1.1rem;margin:.5rem 0 1rem}.account-desk [data-destination-summary]{padding:.6rem 0}.account-desk [data-template-message]{grid-column:1/-1}.account-desk :global([hidden]){display:none!important}.account-image img{max-width:160px;max-height:170px}.account-image summary,.desk-bookmark summary{cursor:pointer;min-height:2.2rem}.desk-bookmark p{max-width:65ch}.account-recent{margin-top:1.25rem}.account-recent :global(article){padding:1rem 0;border-top:1px solid var(--tok-studio-rule)}.account-recent :global(p){white-space:pre-wrap;max-width:65ch;overflow-wrap:anywhere}.account-recent :global(img){max-width:160px;max-height:170px}.account-recent :global(button),.account-recent :global(a){margin-right:1rem}.desk-related{display:flex;flex-wrap:wrap;gap:.8rem 1.25rem;margin:1.25rem 0}.account-desk input,.account-desk select{min-width:0;box-sizing:border-box}.account-desk :global(.studio-field-wisdom>summary){min-height:1.8rem;max-height:1.8rem}.account-desk [role=status]{margin:.5rem 0;max-width:65ch}@media(min-width:1000px){.account-capture{max-width:1000px}.account-recent{max-width:1000px}}@media(max-width:600px){.account-desk{padding-top:.8rem}.capture-choices{gap:.2rem}.account-desk textarea{height:8rem}.account-capture{padding:1rem 1.25rem}}</style>

<style>.account-desk [data-destination-controls]{display:flex;flex-wrap:wrap;align-items:flex-start;gap:1rem 1.25rem}.account-desk [data-destination-controls]>:global(.studio-field-help-wrap),.account-desk [data-destination-controls]>.studio-field{flex:1 1 22rem;min-width:0;max-width:100%}.account-desk [data-destination-controls]>:global(.studio-field-help-wrap:has(>[hidden])){display:none!important}.account-desk [data-destination-controls]>button{flex:0 0 auto;align-self:flex-end;margin-right:auto;max-width:100%}.account-desk [data-template-message]{flex-basis:100%}.account-desk [data-destination-controls] select{width:100%;padding-right:2.5rem}</style>

<style>.desk-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.desk-tiles a{display:grid;gap:.6rem;padding:1.3rem;border:1px solid var(--tok-studio-rule,#cec9c1);border-top:4px solid #c6a85a;border-radius:5px;background:#faf8f3;text-decoration:none;color:inherit;min-height:7rem}.desk-tiles strong{font:500 1.4rem Georgia,serif}.desk-tiles span{line-height:1.6}.desk-tiles a:focus-visible,.capture-choices a:focus-visible{outline:3px solid #065e73;outline-offset:3px}.account-desk fieldset[data-brainstorm]{border:0;padding:0;display:grid;gap:.8rem}.account-desk [data-brainstorm] textarea{min-height:5rem}.account-desk [data-brainstorm] legend{font-size:1.3rem}.desk-related[open]{display:block}.desk-related a{display:inline-block;margin:1rem 1rem 0 0}@media(max-width:900px){.desk-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.desk-tiles{grid-template-columns:1fr}.desk-tiles a{min-height:0}}</style>
