---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {CREATIVE_CHAPTERS} from '../../lib/studio/communityChapters';
import {COMMUNITY_TOPICS} from '../../lib/studio/communityTopics';
import '../../styles/studio.css';

export const prerender=false;

if (!['localhost','127.0.0.1'].includes(Astro.url.hostname.toLowerCase())) {
  return new Response('Not found',{status:404});
}

Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');

const chapters=CREATIVE_CHAPTERS.map(c=>({id:c.id,name:c.name}));
const topics=COMMUNITY_TOPICS.map(t=>({id:t.id,label:t.label}));
---

<BaseLayout title="Interactive Community Preview | Deck Creator Studio"
 description="Local-only Community interaction demonstration."
 metaRobots="noindex, nofollow" memberWorkspace={false}>
<main class="studio-page page-inner community-lab" data-community-lab>

  <div class="lab-page-header">
  <div>
    <h1 class="community-heading-sr-only">Community</h1>
    
  </div>
  
</div>


  <div class="lab-switch" aria-label="Community selection">
    <button type="button" data-audience="general_community"
  aria-pressed="true" class="lab-community-destination">
  <svg viewBox="0 0 24 24" width="24" height="24"
    fill="none" stroke="currentColor" stroke-width="1.7"
    stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true">
    <circle cx="9" cy="8" r="3"/>
    <path d="M3 19v-2a6 6 0 0 1 12 0v2"/>
    <path d="M16 5a3 3 0 0 1 0 6"/>
    <path d="M18 14a5 5 0 0 1 3 5"/>
  </svg>
  <span>General Community</span>
</button>
    
  </div>

  <section class="lab-chapter-section" aria-labelledby="lab-chapters-heading">
    <div class="lab-section-heading">
      <h2 id="lab-chapters-heading">Explore the eight Creative Chapters</h2>
      <p>Choose the stage of creation your question relates to.</p>
    </div>
    <nav class="lab-chapters" aria-label="Creative Chapters">

      {chapters.map((c,i)=>
        <button type="button" data-chapter={c.id} aria-pressed="false" class="lab-chapter-card">
          <span class="lab-chapter-number">{String(i+1).padStart(2,'0')}</span>
          <span class="lab-chapter-copy">
            <strong>{c.name}</strong>
            <small>{[
              'Ideas and originality',
              'Purpose and readers',
              'Systems and relationships',
              'Writing and interpretation',
              'Art and design',
              'Guidebooks and use',
              'Materials and production',
              'Publishing and launch'
            ][i]}</small>
          </span>
          <span aria-hidden="true" class="lab-chapter-arrow">›</span>
        </button>
      )}
    </nav>
  </section>

  <div class="lab-conversation-heading" id="community-conversations">
    <h2 data-conversation-heading>Recent conversations</h2>
    <button type="button" data-chapter="all" aria-pressed="true" class="lab-browse-all">
      Browse all conversations
    </button>
  </div>
  <div class="lab-filters">
    <label>Search conversations
      <input data-search type="search" placeholder="Search questions and responses"/>
    </label>
    <label>Topic
      <select data-topic>
        <option value="all">All topics</option>
        {topics.map(t=><option value={t.id}>{t.label}</option>)}
      </select>
    </label>
    <label>Sort by
      <select data-sort>
        <option value="activity">Recently active</option>
        <option value="newest">Newest</option>
        <option value="discussed">Most discussed</option>
      </select>
    </label>
    <label class="lab-check"><input type="checkbox" data-mine/> My Conversations</label>
    <label class="lab-check"><input type="checkbox" data-unread/> Unread only</label>
  </div>

  <div class="lab-toolbar">
    <p data-results role="status"></p>
    
  </div>

  <section data-list aria-label="Conversation index"></section>
  <section data-detail hidden aria-label="Selected conversation"></section>
  <section data-compose hidden aria-label="New discussion"></section>
</main>
</BaseLayout>
<style>
.lab-conversation-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin:1.5rem 0 .75rem;scroll-margin-top:2rem}
.lab-conversation-heading h2{font-size:1.4rem;margin:0}
.lab-browse-all{font:inherit;font-size:.9rem;font-weight:600;color:#294d43;background:#fffdf9;border:1px solid #aebfb2;border-radius:.45rem;padding:.55rem .85rem;cursor:pointer}
.lab-filters{display:grid;grid-template-columns:minmax(0,2fr) minmax(10rem,1fr) minmax(10rem,1fr);gap:.75rem;align-items:end;background:transparent;padding:0;margin:1rem 0}
.lab-filters label:first-child{grid-column:1/-1}
.lab-filters input[type=search]{font-size:1rem;min-height:48px;border:1px solid #9baaa0;border-radius:.45rem;background:#fff}
.lab-check{align-self:center;padding:0;font-weight:500!important}
.lab-chapters .lab-chapter-card[aria-pressed=true]{border:2px solid #496c57;background:#dce9df;box-shadow:0 0 0 2px #dce9df}
.lab-chapters .lab-chapter-card:focus-visible,.lab-browse-all:focus-visible{outline:3px solid #b88b37;outline-offset:3px}
@media(max-width:750px){.lab-filters{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.lab-filters{grid-template-columns:1fr}.lab-filters label:first-child{grid-column:auto}}
</style>

<script>
  import '../../scripts/studioCommunityLab';
</script>

<style>
.lab-page-header{display:flex;justify-content:space-between;align-items:center;gap:2rem;margin:1rem 0 1.5rem}
.lab-page-header h1{margin:0;font-size:clamp(2rem,3vw,2.7rem)}
.lab-page-header p{margin:.55rem 0 0;max-width:38rem;line-height:1.5}
.lab-primary-action{flex-shrink:0;min-height:48px;font-weight:700}
.lab-chapter-section{margin:1.7rem 0}
.lab-section-heading h2{font-size:1.35rem;margin:0}
.lab-section-heading p{margin:.4rem 0 1rem;color:#50615d}
.lab-chapters{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem!important;margin:.8rem 0 1.5rem!important}
.lab-chapters .lab-chapter-card{display:flex;align-items:center;gap:.8rem;text-align:left;min-height:78px;padding:1rem!important;border-radius:.65rem;background:#fffdf9}
.lab-chapters .lab-chapter-card:hover{border-color:#58705b;background:#f2f6f1}
.lab-chapter-number{color:#6b766d;font-size:.85rem}
.lab-chapter-copy{display:grid;gap:.2rem;flex:1}
.lab-chapter-copy strong{font-size:1rem}
.lab-chapter-copy small{font-size:.82rem;color:#5c6863;font-weight:400}
.lab-chapter-arrow{font-size:1.5rem;color:#6b766d}
.lab-chapters .lab-all-chapters{grid-column:1/-1;justify-self:start}
.lab-filters{background:#f2f0e9;border-radius:.65rem;padding:1rem}
@media(max-width:650px){
  .lab-page-header{align-items:stretch;flex-direction:column;gap:1rem}
  .lab-primary-action{align-self:start}
  .lab-chapters{grid-template-columns:1fr}
  .lab-chapters .lab-chapter-card{min-height:66px}
}
</style>
<style>
.community-lab{max-width:78rem}
.lab-notice{background:#f2ebdc;padding:.85rem 1rem;border-left:3px solid #8a6a1f;font-size:.92rem}
.lab-switch,.lab-chapters{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}
.lab-chapters button,.lab-switch button{font:inherit;font-size:.88rem;border:1px solid #c8c3b6;border-radius:.5rem;background:#fffdf7;padding:.55rem .8rem;cursor:pointer}
.lab-chapters [aria-pressed=true],.lab-switch [aria-pressed=true]{background:#dbe8e0;border-color:#496c57;font-weight:700}
.lab-filters{display:grid;grid-template-columns:2fr 1fr 1fr auto auto;gap:.8rem;align-items:end;margin:1.2rem 0}
.lab-filters label{font-size:.85rem;font-weight:600}
.lab-filters input:not([type=checkbox]),.lab-filters select{display:block;width:100%;padding:.65rem;margin-top:.3rem;box-sizing:border-box;font:inherit}
.lab-check{display:flex;align-items:center;gap:.4rem;padding-bottom:.7rem;white-space:nowrap}
.lab-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem}
[data-list] article{border:1px solid #d5dcd5;border-left:3px solid #58705b;background:#fffdf9;border-radius:.5rem;margin:.7rem 0;padding:.9rem 1rem}
[data-list] article button{border:0;background:none;padding:0;color:#204c4b;font:inherit;font-weight:700;font-size:1.05rem;text-align:left;cursor:pointer}
[data-list] article p{font-size:.9rem;margin:.4rem 0;overflow-wrap:anywhere}
[data-list] article small{color:#546662}
[data-detail] button,[data-compose] button{cursor:pointer}
[data-detail] .lab-reply{padding:.7rem .9rem;border-left:2px solid #9cb4a4;margin:.5rem 0;background:#f1f5f2}
[data-detail] .lab-child{margin-left:1.5rem;background:#f8f9f5}
[data-detail] textarea,[data-compose] textarea,[data-compose] select{width:100%;box-sizing:border-box;padding:.6rem;font:inherit}
@media(max-width:850px){.lab-filters{grid-template-columns:1fr 1fr}.lab-filters label:first-child{grid-column:1/-1}}
@media(max-width:500px){.lab-filters{grid-template-columns:1fr}.lab-filters label:first-child{grid-column:auto}.lab-chapters{flex-wrap:nowrap;overflow-x:auto}.lab-chapters button{flex-shrink:0}}
</style>







<style>
.community-heading-sr-only {
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip-path:inset(50%);
  white-space:nowrap;
}
.community-lab .lab-page-header {
  margin:0!important;
  min-height:0;
  padding:0;
}
.community-lab .lab-switch {
  margin:.6rem 0 1.2rem;
}
.community-lab .lab-chapter-section {
  margin-top:.9rem;
}
</style>
