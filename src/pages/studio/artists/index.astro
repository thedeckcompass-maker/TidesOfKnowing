---
import ArtistConversations from '../../../components/studio/ArtistConversations.astro';
import ArtistProfileCard from '../../../components/studio/ArtistProfileCard.astro';
import {newestPublishedFirst} from '../../../lib/studio/artistPresentation';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudioHeader from '../../../components/studio/StudioHeader.astro';
import {artistPortfolioStore} from '../../../lib/studio/artistPortfolioProvider';
import {studioArtistProcessLabel} from '../../../lib/studio/types';
import '../../../styles/studio.css';
export const prerender=false;
if(!Astro.locals.user)return Astro.redirect('/auth/login/?redirectTo=/studio/artists/',303);
if(Astro.locals.profile?.id!==Astro.locals.user.id||Astro.locals.profile.status!=='active')return new Response('Sign in with your active account.',{status:403,headers:{'Cache-Control':'private,no-store'}});
const projectContext=Astro.url.searchParams.get('project')??'';
let ownedProject:any=null;
if(projectContext){const {data,error}=await Astro.locals.supabase!.from('studio_projects').select('id,name').eq('id',projectContext).eq('owner_id',Astro.locals.user.id).maybeSingle();if(error||!data)return new Response('Project not found.',{status:404,headers:{'Cache-Control':'private,no-store'}});ownedProject=data;}
const directoryHref=ownedProject?'/studio/artists/?project='+encodeURIComponent(ownedProject.id):'/studio/artists/';
const store=artistPortfolioStore(Astro.locals);let directoryUnavailable=!store,listed:any[]=[];if(store){try{if(!(await store.canCreator(Astro.locals.user.id)))return new Response('Artist browsing is not available for this account. You can manage your portfolio at /artists/collaborate/.',{status:403,headers:{'Cache-Control':'private,no-store'}});const result=await store.directory(Astro.locals.user.id);if(!Array.isArray(result))throw new Error("Invalid artist directory response");listed=result;}catch{directoryUnavailable=true}}
const selectedId=Astro.url.searchParams.get('profile');let selected:any=null;if(selectedId&&store&&!directoryUnavailable){try{selected=await store.directoryProfile?.(Astro.locals.user.id,selectedId)}catch{directoryUnavailable=true}}
const search=(Astro.url.searchParams.get('q')??'').trim().toLowerCase(),process=Astro.url.searchParams.get('process')??'',artists=newestPublishedFirst(listed).filter((a:any)=>(!search||[a.professional_name,a.location,a.biography,...a.mediums,...a.styles,...a.subjects].join(' ').toLowerCase().includes(search))&&(!process||a.process_disclosure===process));
---
<BaseLayout title="Artist directory | Deck Creator Studio" description="Discover approved artist portfolios and choose how to discuss your project." metaRobots="noindex,nofollow" tdcPlacement="none" studioWorkspace={true} bodyClass="tok-body--studio"><main class="studio-page page-inner artist-workspace"><StudioHeader title="Find artists" lede="Discover artist portfolios and find work that fits your deck." />{directoryUnavailable&&<p role="status" class="studio-notice">Artist portfolios could not be loaded. Please try again shortly.</p>}
{selectedId?<section class="studio-panel"><a href={directoryHref}>Back to artists</a>{selected?<><ArtistProfileCard artist={selected}/><ArtistConversations artist={selected} projectId={ownedProject?.id}/></>:<p>This artist profile is not available.</p>}</section>:<section class="studio-panel"><p class="studio-eyebrow">Newest portfolios first</p><form class="studio-form artist-search" method="get">{ownedProject&&<input type="hidden" name="project" value={ownedProject.id}/>}<label class="studio-field"><span>Search artists</span><input type="search" name="q" value={search} data-artist-help="search"/></label><label class="studio-field"><span>Creative process</span><select name="process" data-artist-help="process"><option value="">All disclosed processes</option>{Object.entries(studioArtistProcessLabel).map(([value,label])=><option value={value} selected={process===value}>{label}</option>)}</select></label><button class="studio-button" type="submit">Search artists</button><a href={directoryHref}>Clear filters</a></form>
<div class="artist-directory-grid">{artists.map((artist:any)=><article class="studio-card" data-directory-artist>{artist.portfolio_examples?.[0]?.url&&new URL(artist.portfolio_examples[0].url,Astro.url.origin).origin===Astro.url.origin&&new URL(artist.portfolio_examples[0].url,Astro.url.origin).pathname.startsWith('/api/artists/portfolio/')&&<img class="artist-representative" src={artist.portfolio_examples[0].url} alt={artist.portfolio_examples[0].title} loading="lazy"/>}<h2>{artist.professional_name}</h2><p>{artist.location}</p><p>{artist.mediums?.slice(0,3).join(', ')}{artist.styles?.length?' · '+artist.styles.slice(0,2).join(', '):''}</p><p class="artist-excerpt">{artist.artistic_statement}</p><a class="studio-link-button" href={directoryHref+(ownedProject?'&':'?')+'profile='+encodeURIComponent(artist.id)}>View profile</a></article>)}</div>{!directoryUnavailable&&!artists.length&&<p>No listed artists match your search. Try another term or clear the filters.</p>}</section>}<section class="studio-panel"><ArtistConversations/></section>{ownedProject&&<p><a href={`/studio/projects/${ownedProject.id}/journey/?chapter=visual-world`}>Return to {ownedProject.name}: Visual Direction</a> · <a href={`/studio/projects/${ownedProject.id}/visual-exchange/`}>My Visual Design Exchange</a></p>}<aside class="studio-panel artist-directory-support"><h2>Working together</h2><p>Artist Studio is a growing registry and a meeting place for creators and artists. You choose whom to contact. Decisions, agreements and payments remain directly between you and the artist. A profile or an enquiry is not a recommendation, a commission or an agreement.</p><p>If your plan includes personal editorial support, Leilia can help you consider which artist’s work best fits your deck’s vision.</p><h3>My artist portfolio</h3><a href="/artists/collaborate/">Manage my artist portfolio</a></aside></main></BaseLayout>

<style>.artist-workspace :global(.studio-header h1){font-size:clamp(2rem,3.2vw,3rem);line-height:1.12}.artist-workspace :global(.studio-panel--side h2){font-size:1.55rem;line-height:1.3}.artist-workspace :global(.studio-panel--side){align-self:start}.artist-workspace :global(.studio-header){padding-block:1rem;margin-bottom:1.5rem}.artist-workspace :global(button:disabled){color:#565e5b;background:#e8e5dd;border:1px solid #aaa79e;opacity:1}</style>

<style>.artist-workspace{max-width:1200px;margin-inline:auto}.artist-directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:24px}.artist-directory-grid :global(.studio-card){margin:0;padding:24px;min-width:0}.artist-directory-grid h2{font-size:1.5rem}.artist-representative{width:100%;height:190px;object-fit:cover}.artist-excerpt{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.artist-directory-support{margin-top:24px;max-width:75ch}@media(max-width:1000px){.artist-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.artist-directory-grid{grid-template-columns:1fr}}</style>
