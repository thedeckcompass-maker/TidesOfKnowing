---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioHeader from "../../components/studio/StudioHeader.astro";
import { studioAccessResponse } from "../../lib/studio/access";
import { getStudioProjects } from "../../lib/studio/queries";
import { studioDeckTypeLabel, studioPathwayLabel } from "../../lib/studio/types";
import "../../styles/studio.css";

export const prerender = false;

const accessResponse = studioAccessResponse(Astro.locals.user, Astro.locals.profile, "/studio/", Astro.locals.studioEntitlement);
if (accessResponse) return accessResponse;

let projects: Awaited<ReturnType<typeof getStudioProjects>> = [];
let databaseReady = Boolean(Astro.locals.supabase);
if (Astro.locals.supabase) {
  try {
    projects = await getStudioProjects(Astro.locals.supabase);
  } catch (queryError) {
    databaseReady = false;
    console.error("Deck Creator Studio schema is not ready:", queryError);
  }
}
const created = Astro.url.searchParams.get("created") === "1";
const error = Astro.url.searchParams.get("error");
const readOnly = Astro.locals.studioEntitlement?.access_mode === "read_only";
---

<BaseLayout
  title="Deck Creator Studio | Tides of Knowing"
  description="Private Deck Creator Studio build workspace."
  metaRobots="noindex, nofollow"
  tdcPlacement="none"
  memberWorkspace={false}
  bodyClass="tok-body--studio"
>
  <main class="studio-page page-inner">
    <StudioHeader
      title="Deck Creator Studio"
      lede="A private working environment for shaping your deck, card system and guidebook from first idea to publication."
    />

    {created ? <p class="studio-notice" role="status">Your project workspace is ready.</p> : null}
    {error ? <p class="studio-notice" role="alert">{error}</p> : null}
    {readOnly ? <p class="studio-notice" role="status">Your Studio is read-only. Project viewing and exports remain available, but editing is paused.</p> : null}
    {!databaseReady ? <p class="studio-notice" role="status">The private project workspace is being prepared. No project data has been changed.</p> : null}

    <div class="studio-grid">
      <section class="studio-panel studio-panel--wide" aria-labelledby="projects-heading">
        <p class="studio-kicker">Your work</p>
        <h2 id="projects-heading">Deck projects</h2>
        {projects.length ? (
          <ul class="studio-list">
            {projects.map((project) => (
              <li class="studio-card">
                <div class="studio-card__row">
                  <div>
                    <p class="studio-meta">
                      {studioDeckTypeLabel[project.deck_type]} · {studioPathwayLabel[project.pathway]}
                    </p>
                    <h3>{project.name}</h3>
                    <p>{project.next_action || project.purpose || "Define the next useful step for this deck."}</p>
                  </div>
                  <div>
                    <span class="studio-status">{project.status}</span>
                    <p><a class="studio-link-button" href={`/studio/projects/${project.id}/`}>Open project</a></p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="studio-empty">No projects yet. Create the first working space for your deck.</p>
        )}
      </section>

      <section class="studio-panel studio-panel--side" aria-labelledby="create-project-heading">
        <p class="studio-kicker">Start here</p>
        <h2 id="create-project-heading">Create a project</h2>
        <p class="studio-panel__intro">Choose the structure that fits the deck. You can change these settings later.</p>
        {databaseReady && !readOnly ? <form class="studio-form" method="post" action="/api/studio/projects">
          <label class="studio-field">
            <span>Project name</span>
            <input name="name" required maxlength="120" autocomplete="off" />
          </label>
          <label class="studio-field">
            <span>Deck type</span>
            <select name="deck_type" required>
              <option value="oracle">Oracle</option>
              <option value="tarot">Tarot</option>
              <option value="hybrid">Hybrid</option>
            </select>
          </label>
          <label class="studio-field">
            <span>Creator pathway</span>
            <select name="pathway" required>
              <option value="personal">Personal or gift edition</option>
              <option value="independent">Independent publication</option>
              <option value="commercial">Commercial or crowdfunded launch</option>
            </select>
          </label>
          <label class="studio-field">
            <span>Planned deck size</span>
            <input name="deck_size" type="number" min="1" max="240" inputmode="numeric" />
          </label>
          <label class="studio-field">
            <span>What is this deck for?</span>
            <textarea name="purpose" maxlength="1200"></textarea>
          </label>
          <button class="studio-button" type="submit">Create project</button>
        </form> : <p class="studio-empty">{readOnly ? "Project creation is unavailable while access is read-only." : "Project creation will appear when the private Studio schema is ready."}</p>}
      </section>
    </div>
  </main>
</BaseLayout>
