---
import FoundingJourney from '../../components/studio/FoundingJourney.astro';
import {loadFoundingWorkspace} from '../../lib/studio/foundingWorkspace';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ORIENTATION_SECTIONS,ORIENTATION_CHAPTERS,WELCOME_OPENING,WELCOME_DRAFT,WHY_BEGIN,MAP_INTRO,localOrientation,orientationActor,mapContext,ownedMapContext} from '../../lib/studio/orientation';
import {supportCapabilities} from '../../lib/studio/supportCapabilities';
import '../../styles/studio.css';
const foundingRecord=await loadFoundingWorkspace(Astro.locals,Astro.url,import.meta.env.DEV);
export const prerender=false;
if(!orientationActor(Astro.locals))return new Response('Sign in with your existing account.',{status:401});
const store=localOrientation(Astro.locals);
const context=await ownedMapContext(Astro.locals,mapContext(Astro.url.searchParams.get('from'))),state=store?store.get(Astro.locals.user!.id):{position:0,revision:0},base=context.projectId?'/studio/projects/'+context.projectId:null;
const returnTo=context.returnTo==='/studio/'?'/studio/?orientation=skip':context.returnTo;
const mapHref='/studio/journey-map/?from='+encodeURIComponent('/studio/welcome/')+'&work='+encodeURIComponent(context.returnTo);
const capabilities=await supportCapabilities(Astro.locals);
---
<BaseLayout title="Welcome to the Studio" description="Why the creative journey begins with you." studioWorkspace={true} studioProjectId={context.projectId??undefined} tdcPlacement="none" metaRobots="noindex, nofollow">
<main class="studio-page page-inner welcome-page" data-orientation data-server-progress={store?'true':'false'} data-owner={Astro.locals.user!.id} data-return={returnTo}>
<FoundingJourney record={foundingRecord}/>
<script type="application/json" data-orientation-initial set:html={JSON.stringify(state).replaceAll('<','\\u003c')}/>
<div class="welcome-columns"><div class="welcome-main"><header class="welcome-heading" tabindex="-1"><p class="studio-eyebrow">How to use Deck Creator Studio</p><h1>Welcome to the Studio</h1><p>Read this introduction to learn where to find your cards, guidebook, production plans and support. You can return to your project at any time.</p><a href="/studio/?orientation=skip" data-orientation-exit="dismiss">Return to Studio overview</a>{context.projectId&&<p><a href={returnTo} data-orientation-exit="dismiss">Return to {context.label}</a></p>}</header>
<article class="studio-panel welcome-reading">
<section class="welcome-panel" data-welcome-panel="0" id="personal-welcome"><figure class="welcome-portrait"><img src="/images/about/leigh-spencer-profile.png" width="723" height="1024" alt="Leilia Spencer"/><figcaption>Leilia Spencer</figcaption></figure><p class="studio-eyebrow">A personal welcome from Leilia</p><h2>Why I created this space for your deck</h2><p>{WELCOME_DRAFT}</p><h3>Start with the work you want to do</h3><p>{WELCOME_OPENING}</p></section>
<section class="welcome-panel" data-welcome-panel="1" hidden><h2>Why begin with creative direction?</h2><p>Your creative direction gives you a point of reference for decisions about writing, imagery and presentation.</p><p>If your deck is already well developed, consider what makes it distinctive, whether every card contributes to the experience you intend, and whether the language consistently reflects your approach.</p><p>Once your direction and shared card-entry template are established, use the Studio’s eight Sections as your work needs them. They are areas of activity, not the chapters of your guidebook.</p></section>
<section class="welcome-panel" data-welcome-panel="2" hidden><p class="studio-eyebrow">Keep the whole in view</p><h2>Download your Studio journey map.</h2><p>{MAP_INTRO}</p><div class="welcome-actions"><a class="studio-button" href="/studio-reference/studio-journey-map-a3.pdf" download>Download large map — landscape PDF</a><a class="studio-button studio-button--secondary" href="/studio-reference/studio-journey-map-a4.pdf" download>Download printable journey reference</a></div><p><a href={mapHref} target="_blank" rel="noopener noreferrer">Explore the interactive map (opens a new tab)</a></p><p>The PDF is a static reference with no account or project content. The interactive map marks where you came from with a named “You are here” location.</p><h3>Return whenever an idea develops</h3><p>Writing can change what an image needs to say. Imagery can uncover a relationship. A companion entry can reveal that a card needs clearer language. Expression, Visual World and Companion are connected parts of the work, rather than a sequence of approvals you must pass.</p></section>
<section class="welcome-panel" data-welcome-panel="3" id="chapters" hidden><p class="studio-eyebrow">The eight Sections</p><h2>What you can develop in each Section</h2><p>Each Section helps you develop a specific part of your deck. Open a Section below to see what it covers and where its work is saved.</p>{ORIENTATION_CHAPTERS.map(c=><details class="welcome-chapter" style={`border-left-color:${c.colour}`}><summary>{c.number}. {c.name}<span>{c.output}</span></summary><h3>{c.question}</h3><p>{c.how}</p></details>)}</section>
<section class="welcome-panel" data-welcome-panel="4" hidden><p class="studio-eyebrow">Your project tools and support</p><h2>Find saved work, keep notes and ask for help</h2><h3>My Project Workbook</h3><p>Your Project Workbook brings together your saved work from all eight Sections. Open a section to review it, then follow its edit link to continue working.</p><h3>A private journal, from the beginning</h3><p>Keep sketches, photographs, observations, decisions and questions as the work develops. The journal remains private. A later launch story uses only material you explicitly choose and review; the rest is not copied automatically.</p><h3>Help with a field or decision</h3><p>Question marks beside fields offer thoughtful prompts. Where useful, Personal explores intention or meaning; Practical explains what to enter and how it will be used. Use the prompts when they help; you can leave optional questions unanswered.</p><h3>Conversation and confidential feedback are different</h3><p>All pathways share the Studio Community, where members bring questions and help choose topics for collective responses. Confidential editorial requests are separate: selected material and a version snapshot go to the private review channel, not to a community.</p><p>Each request is reviewed as it comes in. Guidance written into the Studio is not a personal reply. The support options available to you are listed below.</p><div class="welcome-capabilities">{capabilities.filter(c=>c.eligible).map(c=><details><summary>{c.title}</summary><p>{c.description}</p><p>{c.eligible?'Open the relevant support option to prepare your question.':c.reason}</p></details>)}</div><h3>Artists and your visual direction</h3><p>You can develop a private visual direction for your own clarity. When the relevant sharing tools are available, you choose the excerpt and examples an artist will see. General Section community is available to all members. Sharing, contact introductions, contracts and payments are not automatic.</p></section>
<section class="welcome-panel" data-welcome-panel="5" hidden><h2>Begin with your creative direction</h2><p>Define the purpose, audience, vision and voice of your deck, then choose the shared sections for your card entries. Capture ideas in Creator’s Desk, or open My cards to work on your deck.</p><a class="studio-button" href={base?base+'/creative-direction/':'/studio/?orientation=skip#create-project-heading'} data-orientation-exit="finish">Begin creative direction</a></section>
<nav class="welcome-actions" aria-label="Continue the welcome"><button type="button" class="studio-button studio-button--secondary" data-welcome-back>Back</button><button type="button" class="studio-button" data-welcome-next>Continue</button></nav><p data-welcome-status role="status" aria-live="polite"></p>
</article></div><aside class="welcome-rail"><p class="studio-eyebrow">Find your bearings</p><nav aria-label="Welcome sections">{ORIENTATION_SECTIONS.map((name,i)=><button type="button" data-welcome-position={i}>{i+1}. {name}</button>)}</nav><section><h3>People and support</h3><p>Connect with other creators, find artists or see the support available to your account.</p><p><a href="/studio/community/">Community</a></p><p><a href="/studio/artists/">Find artists</a></p><p><a href="/studio/account/">My support and services</a></p></section><section><h3>Keep the map beside you.</h3><p>Download it as a reference while you read. You can reopen this welcome and the map from Studio menu.</p><a href="/studio-reference/studio-journey-map-a3.pdf" download>Large landscape map</a><br/><a href="/studio-reference/studio-journey-map-a4.pdf" download>Printable journey reference</a></section></aside></div>
<noscript><style>.welcome-panel[hidden]{display:block!important}.welcome-actions button,.welcome-rail nav{display:none}</style><p>All sections are shown when JavaScript is unavailable; reading-place saving is optional.</p></noscript>
</main></BaseLayout>
<script>import '../../scripts/studioWelcome';</script>
<style>.welcome-heading{margin:0 0 1.25rem;scroll-margin-top:7rem;outline:none}.welcome-main{min-width:0}.welcome-heading h1{font:clamp(2.3rem,4vw,3.7rem)/1.1 'Playfair Display',Georgia,serif}.welcome-heading>p:not(.studio-eyebrow){max-width:65ch;line-height:1.7}.welcome-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:1.7rem;align-items:start}.welcome-reading{grid-column:auto;min-width:0;padding:clamp(1.1rem,3vw,2.4rem)}.welcome-reading h2{font:clamp(1.8rem,3vw,2.5rem)/1.2 'Playfair Display',Georgia,serif}.welcome-reading h3{font:1.3rem/1.3 Georgia,serif;margin-top:1.5rem}.welcome-reading p,.welcome-reading blockquote{font-size:1.04rem;line-height:1.85}.welcome-portrait{float:right;width:32%;max-width:210px;margin:0 0 1rem 1.5rem}.welcome-portrait img{display:block;width:100%;height:auto;border-radius:4px}.welcome-portrait figcaption{font-size:.8rem;margin-top:.35rem}.welcome-draft{clear:both;border-top:1px solid #d0c8bb;padding-top:1rem}.welcome-draft>p{font-size:.82rem;background:#eee8dc;padding:.7rem}.welcome-draft blockquote{margin:1rem 0;padding-left:1rem;border-left:2px solid #b29552;font-family:Georgia,serif}.welcome-rail{min-width:0;position:sticky;top:1rem;display:grid;gap:.6rem}.welcome-rail>.studio-eyebrow{margin:0}.welcome-rail nav{padding:1rem;background:var(--tok-studio-paper-soft,#e8e3db);border-radius:4px;display:grid;gap:.3rem}.welcome-rail nav button{font:inherit;text-align:left;padding:.7rem .5rem;min-height:44px;background:transparent;border:0;border-left:3px solid transparent;color:#263432;cursor:pointer}.welcome-rail nav button[aria-current]{border-left-color:#526f7b;font-weight:700;background:#fbf8f1}.welcome-rail section{padding:1.25rem;background:var(--tok-studio-paper-soft,#e8e3db);line-height:1.7}.welcome-rail h3{font:1.3rem Georgia,serif}.welcome-actions,.welcome-starts{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.5rem 0}.welcome-starts{display:grid}.welcome-chapter{padding:1rem;border:1px solid #d0c8bb;border-left-width:6px;margin:1rem 0}.welcome-chapter summary{font:600 1.1rem/1.5 Georgia,serif;cursor:pointer}.welcome-chapter summary span{display:block;font:400 .88rem/1.6 Inter,system-ui,sans-serif}.welcome-capabilities details{border-top:1px solid #d0c8bb;padding:.8rem 0}.welcome-capabilities summary{cursor:pointer;font-weight:600}.welcome-page button:focus-visible,.welcome-page a:focus-visible,.welcome-page summary:focus-visible{outline:3px solid #065e73;outline-offset:3px}.welcome-page [hidden]{display:none!important}@media(max-width:760px){.welcome-columns{grid-template-columns:1fr}.welcome-rail{position:static}.welcome-portrait{float:none;width:180px;margin:0 auto 1.2rem}.welcome-actions>.studio-button{flex:1}.welcome-rail nav{grid-template-columns:repeat(2,minmax(0,1fr));font-size:.86rem}}</style>

<style>.welcome-panel h2{scroll-margin-top:var(--studio-header-offset,7rem);outline:none}.welcome-heading h1{font-size:clamp(2rem,3.2vw,3rem);text-wrap:balance}.welcome-rail section:last-child{display:none}.welcome-actions{align-items:start}.welcome-actions a{flex:1 1 15rem}.welcome-reading{padding:clamp(1rem,2vw,1.6rem)}</style>
