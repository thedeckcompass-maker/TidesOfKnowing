---
import StudioFormFeedback from "../../../../../components/studio/StudioFormFeedback.astro";
import JournalDraftRecovery from "../../../../../components/studio/JournalDraftRecovery.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import StudioHeader from "../../../../../components/studio/StudioHeader.astro";
import { studioAccountAccessResponse as studioAccessResponse, studioProjectWriteAccessResponse } from "../../../../../lib/studio/access";
import { getStudioJournalEntries, getStudioProjectWorkspace } from "../../../../../lib/studio/queries";
import { STUDIO_JOURNAL_TAGS } from "../../../../../lib/studio/types";
import "../../../../../styles/studio.css";

export const prerender = false;

const projectId = Astro.params.id;
const accessResponse = await studioAccessResponse(Astro.locals.user, Astro.locals.profile, Astro.locals.supabase);
if (accessResponse) return accessResponse;
if (!projectId || !Astro.locals.supabase) return new Response(null, { status: 404 });

const [workspace, entries] = await Promise.all([
  getStudioProjectWorkspace(Astro.locals.supabase, projectId),
  getStudioJournalEntries(Astro.locals.supabase, projectId),
]);
if (!workspace.project || workspace.project.owner_id!==Astro.locals.user?.id) return new Response(null, { status: 404 });
const canWrite=!await studioProjectWriteAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase,projectId);

const { project, cards, guidebook } = workspace;
const processEntries = entries.filter((entry) => entry.selected_for_process);
const cardById = new Map(cards.map((card) => [card.id, card]));
const sectionById = new Map(guidebook.map((section) => [section.id, section]));
const error = Astro.url.searchParams.get("error");
const label = (value: string) => value.replaceAll("_", " ");
---

<BaseLayout title={`Creator Journal | ${project.name}`} description="Private Deck Creator Studio journal and process board." metaRobots="noindex, nofollow" tdcPlacement="none" memberWorkspace={false} bodyClass="tok-body--studio">
  <main class="studio-page page-inner">
    <StudioHeader eyebrow={`${project.name} · Private workspace`} title="Creator Journal" lede="Record your ideas, discoveries and progress as you create your deck. These entries can help you reflect on your work and later prepare social posts or a crowdfunding campaign. All journal entries are private." projectId={projectId} photographsHref="#journal-entries" />
    {error ? <p class="studio-notice" role="alert">{error}</p> : null}

    <div class="studio-grid studio-journal-overview">
<section class="studio-panel studio-panel--wide studio-panel--compact" aria-labelledby="process-heading">
        <p class="studio-kicker">Private selection</p>
        <h2 id="process-heading">Project highlights</h2>
        <p class="studio-panel__intro">Highlight entries you may want to draw on for social posts or a crowdfunding campaign. Your highlights stay private.</p>
        {processEntries.length ? (
          <ul class="studio-list">
            {processEntries.map((entry) => (
              <li class="studio-card">
                <div class="studio-card__row">
                  <div>
                    <p class="studio-meta">{label(entry.entry_kind)} · {new Date(entry.updated_at).toLocaleDateString("en-NZ", { dateStyle: "medium" })}</p>
                    <h3>{entry.title}</h3>
                    {entry.tags.length ? <div class="studio-tags" aria-label="Journal tags">{entry.tags.map((tag) => <span>{tag}</span>)}</div> : null}
                  </div>
                  <a class="studio-link-button" href={`/studio/projects/${projectId}/journal/${entry.id}/`}>Open entry</a>
                </div>
              </li>
            ))}
          </ul>
        ) : <p class="studio-empty">No journal entries are highlighted yet. Select useful entries to find them quickly here.</p>}
      </section>
<section class="studio-panel studio-panel--side studio-panel--compact" aria-labelledby="journal-stats-heading">
        <p class="studio-kicker">Project record</p>
        <h2 id="journal-stats-heading">Journal summary</h2>
        <div class="studio-stats studio-stats--journal">
          <div class="studio-stat"><strong>{entries.length}</strong> entries</div>
          <div class="studio-stat"><strong>{processEntries.length}</strong> highlighted entries</div>
        </div>
      </section>
{canWrite&&<section class="studio-panel studio-panel--full" aria-labelledby="new-entry-heading">
        <p class="studio-kicker">New reflection</p>
        <h2 id="new-entry-heading">Add an entry</h2><p>Save your writing, then add photographs in the entry editor.</p>
        <form id="studio-journal-create" class="studio-form" method="post" action={`/api/studio/projects/${projectId}/journal`}>
          <label class="studio-field"><span>Title</span><input name="title" required maxlength="160" /></label>
          <label class="studio-field"><span>Entry type</span><select name="entry_kind"><option value="reflection">Reflection</option><option value="decision">Decision</option><option value="milestone">Milestone</option></select></label>
          <label class="studio-field"><span>Linked card</span><select name="linked_card_id"><option value="">No linked card</option>{cards.map((card) => <option value={card.id}>{card.card_number ? `${card.card_number} · ` : ""}{card.title}</option>)}</select></label>
          <label class="studio-field"><span>Linked guidebook section</span><select name="linked_section_id"><option value="">No linked section</option>{guidebook.map((section) => <option value={section.id}>{section.title}</option>)}</select></label>
          <fieldset class="studio-field studio-fieldset"><legend>Tags</legend><div class="studio-check-grid">{STUDIO_JOURNAL_TAGS.map((tag) => <label class="studio-check"><input type="checkbox" name="tags" value={tag} /> <span>{tag}</span></label>)}</div></fieldset>
          <label class="studio-field"><span>Journal entry</span><textarea name="body_markdown" maxlength="50000"></textarea></label>
          <label class="studio-check studio-check--standalone"><input type="checkbox" name="selected_for_process" /> <span>Add to Project highlights</span></label>
          <small>Highlighting keeps this entry easy to find in this project. It remains private.</small><button class="studio-button" type="submit">Save entry and add photos</button>
        </form>
        
        <JournalDraftRecovery formId="studio-journal-create" ownerId={project.owner_id} projectId={projectId}/>
      </section>}
<section class="studio-panel studio-panel--full" aria-labelledby="journal-entries">
        <p id="journal-export"><a href={`/studio/projects/${projectId}/exports/#private-exports`}>Choose journal entries and download from Exports</a></p><p class="studio-kicker">Private record</p>
        <h2 id="journal-entries">All journal entries</h2><p>{entries.length ? (canWrite?"Open an entry to edit your writing or add photographs.":"Open an entry to read your saved writing.") : (canWrite?"Save your first entry above. Its editor includes Add photos.":"No journal entries are available.")}</p>
        {entries.length ? (
          <ul class="studio-list">
            {entries.map((entry) => (
              <li class="studio-card">
                <div class="studio-card__row">
                  <div>
                    <p class="studio-meta">{label(entry.entry_kind)} · updated {new Date(entry.updated_at).toLocaleDateString("en-NZ", { dateStyle: "medium" })}</p>
                    <h3><a href={`/studio/projects/${projectId}/journal/${entry.id}/`}>{entry.title}</a></h3>
                    {entry.linked_card_id && cardById.get(entry.linked_card_id) ? <p class="studio-relationship">Card: {cardById.get(entry.linked_card_id)?.title}</p> : null}
                    {entry.linked_section_id && sectionById.get(entry.linked_section_id) ? <p class="studio-relationship">Guidebook: {sectionById.get(entry.linked_section_id)?.title}</p> : null}
                    {entry.tags.length ? <div class="studio-tags" aria-label="Journal tags">{entry.tags.map((tag) => <span>{tag}</span>)}</div> : null}
                  </div>
                  <a class="studio-link-button" href={`/studio/projects/${projectId}/journal/${entry.id}/`}>Open entry</a> <a class="studio-link-button" href={`/studio/projects/${projectId}/journal/${entry.id}/#journal-photographs`}>Photographs</a>
                </div>
              </li>
            ))}
          </ul>
        ) : <p class="studio-empty">No journal entries yet.</p>}
      </section>
    </div>
  </main>
</BaseLayout>
