---
import StudioCardSearch from '../../../../../components/studio/StudioCardSearch.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import {studioAccountAccessResponse,studioProjectWriteAccessResponse} from '../../../../../lib/studio/access';
import {getStudioProjectWorkspace} from '../../../../../lib/studio/queries';
import {guidebookOutline,outlineSlots} from '../../../../../lib/studio/guidebookOutline';
import {finalSelection} from '../../../../../lib/studio/finalSelection';
import {CREATIVE_CHAPTERS} from '../../../../../lib/studio/creatorJourney';
import '../../../../../styles/studio.css';
export const prerender=false;
const access=await studioAccountAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase);if(access)return access;
if(!Astro.locals.supabase||!Astro.params.id)return new Response(null,{status:404});
const {project,cards,guidebook,families}=await getStudioProjectWorkspace(Astro.locals.supabase,Astro.params.id);if(!project)return new Response(null,{status:404});
if(project.owner_id!==Astro.locals.user?.id)return new Response(null,{status:404});
const canWrite=!await studioProjectWriteAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase,project.id);
const deletedCards:{id:string;title:string}[]=[];
for(let offset=0;;offset+=500){const removed=await Astro.locals.supabase.from('studio_cards').select('id,title').eq('project_id',project.id).not('deleted_at','is',null).order('id').range(offset,offset+499);if(removed.error)return new Response('Deleted cards could not be checked. Your work is unchanged.',{status:503});deletedCards.push(...(removed.data??[]));if((removed.data??[]).length<500)break;}
const lifecycleError=Astro.url.searchParams.get('error');
const base='/studio/projects/'+project.id,s=(project.settings??{}) as Record<string, any>,outline=guidebookOutline(s),selection=finalSelection(s,cards,deletedCards.map(card=>card.id)),board=s.visual_design_v1;
const text=(value:unknown)=>typeof value==='string'?value.trim():'';
const short=(value:unknown)=>{const v=text(value);return v.length>240?v.slice(0,240)+'…':v};
const vision=[{label:'Purpose',value:text(s.creative_north_star_v1?.northStar?.idea)||text(s.creative_north_star_v1?.responses?.heart),chapter:'spark'},{label:'Audience',value:text(s.creative_brief_v1?.output?.people)||text(s.creative_brief_v1?.responses?.people),chapter:'foundation'},{label:'Voice',value:text(s.creative_brief_v1?.output?.voice)||text(s.creative_north_star_v1?.responses?.expression),chapter:'foundation'}];
const preview=(card:any)=>{const value=board?.cards?.[card.id]?.front;return typeof value==='string'&&/^data:image\/(jpeg|png|webp);base64,/.test(value)?value:null};
const decisions=s.production_book_v1?.fields??{},launch=s.publication_book_v1?.fields??{};
const packageFields=[['guidebookDelivery','Guidebook'],['packagingType','Packaging'],['bookPlacement','Book placement'],['plannedCardCount','Planned card count']] as const;
const friendly:Record<string,string>={digital:'Digital',printed:'Printed',both:'Digital and printed','cards-only':'Cards only',tuck:'Tuck box',sleeve:'Sleeve',rigid:'Rigid box',other:'Other','boxed-with-cards':'Inside the card box',separate:'Separate','not-applicable':'Not applicable'};
const recurring=cards.flatMap(card=>outlineSlots(outline,card.id).filter(slot=>text(slot.text)).map(slot=>({card,slot}))),sections=guidebook.filter(g=>text(g.body_markdown));
---
<BaseLayout title={`My cards | ${project.name}`} description="Your saved deck taking shape." metaRobots="noindex, nofollow" tdcPlacement="none" memberWorkspace={false} bodyClass="tok-body--studio">
<main class="studio-page page-inner deck-overview" data-studio-card-workspace data-project-id={project.id} data-owner-id={project.owner_id}>
 <header><p class="studio-eyebrow">Your project</p><h1>{project.name}</h1><p>Find a card to continue writing or working on its artwork.</p></header>
 {lifecycleError&&<p class="studio-notice" role="alert">{lifecycleError}</p>}
 
 <div>
 <section id="cards" class="deck-section"><div class="deck-section-title"><div><h2>Your cards</h2><p>{cards.length} saved {cards.length===1?'card':'cards'} · inclusion and sequence can still evolve</p>{!canWrite&&<p>Your current access allows you to view available work. Editing requires an eligible project or a current paid entitlement.</p>}</div>{canWrite&&<a class="studio-button" href={base+'/cards/new/'}>Add a card</a>}</div>
 <StudioCardSearch/><div class="deck-cards">{cards.map(card=><article id={'card-'+card.id} data-card-id={card.id} data-card-search-text={[card.title,card.card_number,families.find(f=>f.id===card.family_id)?.name].filter(Boolean).join(' ')}><a class="deck-card-image" href={base+'/cards/'+card.id+'/?task=artwork'} aria-label={'Work on '+card.title}>{preview(card)?<img src={preview(card)!} alt={'Saved working artwork for '+card.title}/>:<div class="deck-placeholder"><span>Add artwork</span></div>}</a><p class="deck-note">{card.card_number?'Printed label '+card.card_number:'No printed number'} · {selection.entries.find(e=>e.cardId===card.id)?.decision==='aside'?'Set aside — work retained':selection.entries.find(e=>e.cardId===card.id)?.decision==='included'?'Selected for deck':'Final selection undecided'}</p><h3><a href={base+'/cards/'+card.id+'/'}>{card.title}</a></h3><p class="deck-excerpt">{short(card.content?.meaning)||'Open this card to add writing.'}</p><a href={base+'/cards/'+card.id+'/'}>Work on this card</a></article>)}</div>
 {canWrite&&cards.length>0&&<details><summary>Remove a card from your active deck</summary><p>Deleting a card frees a space. Its writing, artwork and version history remain available to restore.</p>{cards.map(card=><details><summary>{card.title}</summary><form method="post" action={`/api/studio/cards/${card.id}/lifecycle`}><input type="hidden" name="project_id" value={project.id}/><input type="hidden" name="action" value="delete"/><input type="hidden" name="confirm" value="yes"/><button type="submit">Confirm delete {card.title}</button></form></details>)}</details>}
 {canWrite&&deletedCards.length>0&&<details><summary>Deleted cards</summary><p>Restore a card when a space is available.</p>{deletedCards.map(card=><form method="post" action={`/api/studio/cards/${card.id}/lifecycle`}><input type="hidden" name="project_id" value={project.id}/><input type="hidden" name="action" value="restore"/><input type="hidden" name="confirm" value="yes"/><button type="submit">Restore {card.title}</button></form>)}</details>}
 {!cards.length&&<p class="deck-empty">Your deck has room for its first idea. Add a card now; numbering and final sequence can wait.</p>}
 <p><a href={base+'/journey/?chapter=expression'}>Explore writing prompts and connections (The Expression)</a> · <a href={base+'/final-selection/'}>Review final selection and sequence</a></p>
 </section>
</div><details class="deck-more"><summary>Guidebook and project plans</summary><div class="deck-columns"><div> <section id="guidebook" class="deck-section"><h2>Your guidebook</h2><p>Saved recurring card writing and one-off manuscript sections. These excerpts are working text, not an approved final export.</p>
 {recurring.length>0&&<div><h3>Recurring card entries</h3>{recurring.slice(0,3).map(({card,slot})=><article class="deck-reading"><p class="deck-note">{card.title} · {slot.label}</p><p>{short(slot.text)}</p><a href={base+'/cards/'+card.id+'/'}>Continue this entry</a></article>)}{recurring.length>3&&<p>{recurring.length} saved recurring sections in total. Open the card editors to read all entries.</p>}</div>}
 {sections.slice(0,2).map(section=><article class="deck-reading"><h3>{section.title}</h3><p>{short(section.body_markdown)}</p><a href={base+'/companion/'+section.id+'/'}>Continue this section</a></article>)}
 {!recurring.length&&!sections.length&&<p class="deck-empty">Your guidebook is taking shape. {outline.sections.filter(x=>!x.archived).length?'Recurring headings are saved; their writing can grow card by card.':'No guidebook writing is saved yet. Start with an outline, a card entry or an introduction when it helps.'}</p>}
 <p><a href={base+'/guidebook-outline/'}>Design your guidebook</a> <a href={`/studio/projects/${project.id}/project-book/?book=manuscript`}>View Guidebook</a> · <a href={base+'/journey/?chapter=companion'}>Develop your guidebook (The Companion)</a></p></section>
 </div><aside>
 <section id="vision" class="deck-section deck-vision"><h2>Your purpose, audience and voice</h2>{vision.map(v=><div><h3>{v.label}</h3><p>{short(v.value)||'Still taking shape — no saved statement here yet.'}</p><a href={base+'/journey/?chapter='+v.chapter}>Develop {v.label.toLowerCase()}</a></div>)}</section>
 <section id="package" class="deck-section"><h2>The finished package</h2><p>Recorded intentions, not printer approval.</p><dl>{packageFields.map(([key,label])=><div><dt>{label}</dt><dd>{friendly[text(decisions[key])]||text(decisions[key])||'Undecided'}</dd></div>)}</dl><p>{short(decisions.fitNotes)||'Fit, stock, book thickness and supplier confirmation can be considered later.'}</p><a href={base+'/journey/?chapter=making&moment=1'}>Plan printing and packaging (The Making)</a></section>
 <section id="launch" class="deck-section"><h2>Your launch plan</h2><h3>Your idea of success</h3><p>{short(launch.success)||'No launch intention saved yet. It is fine to develop the deck first.'}</p><h3>Who you hope to reach</h3><p>{short(launch.audience)||'Still taking shape.'}</p><a href={base+'/journey/?chapter=into-the-world'}>Open launch preparation</a></section>
 </aside></div>
</details> <details class="deck-path"><summary>Develop your project through the eight Sections</summary><p>Use the Sections to develop your ideas, write and design your cards, prepare the guidebook, and plan production and release. You can open any Section and return here to review the results.</p><nav aria-label="Guided Sections">{CREATIVE_CHAPTERS.map(c=><a href={base+'/journey/?chapter='+c.id}>{c.name}</a>)}</nav><p><a href={base+'/project-book/'}>Read all saved Section outputs in My Project Workbook</a></p></details>
</main></BaseLayout>
<style>.deck-overview{color:#253638}.deck-overview header{max-width:100%;margin-bottom:1.5rem}.deck-overview h1{margin:.4rem 0;font:clamp(1.7rem,2.7vw,2.4rem)/1.15 var(--tok-font-heading, "Playfair Display"),serif}.deck-overview h2{font:500 1.8rem/1.2 Georgia,serif}.deck-overview h3{font:500 1.2rem/1.35 Georgia,serif}.deck-overview p{line-height:1.65}.deck-jumps{display:flex;gap:1.3rem;flex-wrap:wrap;border-block:1px solid #cec9c1;padding:1rem 0;margin-bottom:2rem}.deck-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(270px,1fr);gap:2rem;align-items:start}.deck-columns>*{min-width:0}.deck-section{margin-bottom:2rem;padding:1.4rem;background:#faf8f3;border:1px solid #cec9c1;border-radius:4px;scroll-margin-top:6rem}.deck-vision{background:#e9e4d9}.deck-section-title{display:flex;align-items:center;justify-content:space-between;gap:1rem}.deck-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.deck-cards article{min-width:0;border-top:1px solid #cec9c1;padding-top:1rem;scroll-margin-top:6rem}.deck-card-image{display:block;background:#eee8dc;border-radius:4px;padding:.7rem}.deck-card-image img{display:block;width:100%;height:230px;object-fit:contain}.deck-placeholder{height:230px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:1rem;padding:1rem;box-sizing:border-box;border:1px dashed #a6997a;color:#5a625c}.deck-note,.deck-placeholder small{font-size:.8rem;color:#52605e}.deck-excerpt,.deck-reading p{white-space:pre-wrap;overflow-wrap:anywhere}.deck-empty{padding:1rem;background:#eee8dc}.deck-reading{border-top:1px solid #cec9c1;padding:.7rem 0}.deck-overview dl>div{padding:.5rem 0}.deck-overview dt{font-weight:600}.deck-overview dd{margin:.2rem 0}.deck-path{border-top:1px solid #cec9c1;padding:1.5rem 0}.deck-path nav{display:flex;gap:1rem;flex-wrap:wrap}.deck-overview a:focus-visible{outline:3px solid #065e73;outline-offset:4px}@media(max-width:760px){.deck-columns{grid-template-columns:1fr}.deck-section{padding:1rem}.deck-section-title{align-items:flex-start;flex-direction:column}.deck-cards{grid-template-columns:1fr}.deck-card-image img,.deck-placeholder{height:220px}.deck-jumps{gap:.8rem}}.deck-more,.deck-path{margin:1.5rem 0}.deck-more>summary,.deck-path>summary{cursor:pointer;padding:1rem 0;font-weight:600}.deck-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.deck-cards [hidden]{display:none!important}@media(max-width:1000px){.deck-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.deck-cards{grid-template-columns:1fr}}</style>
