---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import StudioHeader from '../../../../components/studio/StudioHeader.astro';
import {studioAccountAccessResponse as studioAccessResponse,studioProjectWriteAccessResponse} from '../../../../lib/studio/access';
import {getStudioProjectWorkspace} from '../../../../lib/studio/queries';
import {creativeSetupValues,CREATIVE_SETUP_FIELDS} from '../../../../lib/studio/creativeSetup';
import '../../../../styles/studio.css';
export const prerender=false;
const denied=await studioAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase);if(denied)return denied;
const {project}=await getStudioProjectWorkspace(Astro.locals.supabase!,Astro.params.id!);if(!project||project.owner_id!==Astro.locals.user?.id)return new Response(null,{status:404});const values=creativeSetupValues(project.settings??{});
if(await studioProjectWriteAccessResponse(Astro.locals.user,Astro.locals.profile,Astro.locals.supabase,project.id))return Astro.redirect('/studio/projects/'+project.id+'/project-book/',303);
---
<BaseLayout title="Define Creative Direction" studioWorkspace={true} studioProjectId={project.id} tdcPlacement="none" metaRobots="noindex,nofollow" description="Define the distinctive creative direction of your deck."><main class="studio-page page-inner creative-direction-page"><StudioHeader title="Define Creative Direction" projectId={project.id} lede="Consider the ideas, people and experiences that will shape your deck. These answers become part of your Author’s Creative Concept."/><div class="creative-setup-layout"><section class="studio-panel"><form data-creative-setup data-project={project.id} data-owner={project.owner_id} data-stamp={project.updated_at}>{CREATIVE_SETUP_FIELDS.map(([key,label,help])=><label class="studio-field"><span>{label}</span><small>{help}</small><textarea name={key} rows="4" maxlength="40000">{values[key]}</textarea></label>)}<button class="studio-button" type="submit">Save creative direction and continue</button><p role="status" data-setup-status/></form></section><aside class="studio-panel"><h2>What will this deck help people explore or do?</h2><p>You may have a new idea, a collection of notes or a nearly finished deck. Consider what makes it distinctive, who it serves and whether its language consistently reflects your approach.</p><p>Your answers stay editable in The Spark and The Foundation. They remain separate from your reader-facing manuscript.</p><h3>Next: your card entries</h3><p>Choose one shared writing template for the deck. You can add sections and reorder them later while keeping your writing.</p><a href={`/studio/projects/${project.id}/project-book/?book=concept`}>Read Creative Concept and Setup</a></aside></div></main></BaseLayout>
<script>import '../../../../scripts/creativeSetup';</script>
<style>.creative-direction-page{padding-top:clamp(1rem,3vw,2.4rem)}.creative-direction-page :global(.studio-header){margin-bottom:1.5rem}.creative-direction-page :global(.studio-header h1){font-size:clamp(2rem,3.6vw,3.25rem);max-width:none}.creative-direction-page :global(.studio-header>div){min-width:0}.creative-setup-layout h2{line-height:1.25}.creative-setup-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:1.5rem;align-items:start}.creative-setup-layout .studio-panel{grid-column:auto}.creative-setup-layout p{max-width:65ch;line-height:1.65}.creative-setup-layout form{display:grid;gap:1rem}.creative-setup-layout small{font-weight:400}.creative-setup-layout textarea{width:100%;box-sizing:border-box}.creative-setup-layout button{justify-self:start}@media(max-width:760px){.creative-setup-layout{grid-template-columns:1fr}}</style>
