---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import StudioHeader from "../../../../../components/studio/StudioHeader.astro";
import { studioAccessResponse } from "../../../../../lib/studio/access";
import { getStudioCard, getStudioCardVersions, getStudioProjectWorkspace } from "../../../../../lib/studio/queries";
import "../../../../../styles/studio.css";

export const prerender = false;
const projectId = Astro.params.id;
const cardId = Astro.params.cardId;
const accessResponse = studioAccessResponse(
  Astro.locals.user,
  Astro.locals.profile,
  projectId && cardId ? `/studio/projects/${projectId}/cards/${cardId}/` : "/studio/",
);
if (accessResponse) return accessResponse;
if (!projectId || !cardId || !Astro.locals.supabase) return new Response(null, { status: 404 });
const [workspace, card, versions] = await Promise.all([
  getStudioProjectWorkspace(Astro.locals.supabase, projectId),
  getStudioCard(Astro.locals.supabase, projectId, cardId),
  getStudioCardVersions(Astro.locals.supabase, projectId, cardId),
]);
if (!workspace.project || !card) return new Response(null, { status: 404 });
const content = card.content ?? {};
const contentText = (key: string) => typeof content[key] === "string" ? content[key] as string : "";
const saved = Astro.url.searchParams.get("saved") === "1";
const created = Astro.url.searchParams.get("created") === "1";
const restored = Astro.url.searchParams.get("restored") === "1";
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title={`${card.title} | Deck Creator Studio`} description="Private card-writing workspace." metaRobots="noindex, nofollow" tdcPlacement="none" memberWorkspace={false} bodyClass="tok-body--studio">
  <main class="studio-page page-inner">
    <StudioHeader eyebrow={`${workspace.project.name} · Card ${card.sort_order}`} title={card.title} lede={`Structured card writing · version ${card.version_number}`} projectId={projectId} />
    {created ? <p class="studio-notice" role="status">Card created. Its first version has been recorded.</p> : null}
    {saved ? <p class="studio-notice" role="status">Card saved as a new version.</p> : null}
    {restored ? <p class="studio-notice" role="status">Earlier content restored as a new current version.</p> : null}
    {error ? <p class="studio-notice" role="alert">{error}</p> : null}
    <section class="studio-panel">
      <form class="studio-form studio-form--two" method="post" action={`/api/studio/cards/${card.id}`}>
        <input type="hidden" name="project_id" value={projectId} />
        <label class="studio-field"><span>Card title</span><input name="title" required maxlength="120" value={card.title} /></label>
        <label class="studio-field"><span>Card number or label</span><input name="card_number" maxlength="30" value={card.card_number} /></label>
        <label class="studio-field"><span>Order</span><input name="sort_order" type="number" min="0" max="999" value={card.sort_order} required /></label>
        <label class="studio-field"><span>Status</span><select name="status"><option value="outline" selected={card.status === "outline"}>Outline</option><option value="draft" selected={card.status === "draft"}>Draft</option><option value="review" selected={card.status === "review"}>Review</option><option value="complete" selected={card.status === "complete"}>Complete</option></select></label>
        <label class="studio-field studio-field--full"><span>Family</span><select name="family_id"><option value="">No family</option>{workspace.families.map((family) => <option value={family.id} selected={card.family_id === family.id}>{family.name}</option>)}</select></label>
        <label class="studio-field studio-field--full"><span>Core meaning</span><textarea name="meaning">{contentText("meaning")}</textarea></label>
        <label class="studio-field studio-field--full"><span>Shadow or cautionary meaning</span><textarea name="shadow_meaning">{contentText("shadow_meaning")}</textarea></label>
        <label class="studio-field"><span>Keywords</span><textarea name="keywords">{contentText("keywords")}</textarea></label>
        <label class="studio-field"><span>Cautions</span><textarea name="cautions">{contentText("cautions")}</textarea></label>
        <label class="studio-field"><span>Symbolism</span><textarea name="symbolism">{contentText("symbolism")}</textarea></label>
        <label class="studio-field"><span>Correspondences</span><textarea name="correspondences">{contentText("correspondences")}</textarea></label>
        <label class="studio-field studio-field--full"><span>Prompts or questions</span><textarea name="prompts">{contentText("prompts")}</textarea></label>
        <label class="studio-field studio-field--full"><span>Private research notes</span><textarea name="research_notes">{contentText("research_notes")}</textarea></label>
        <label class="studio-field"><span>Sources and attribution</span><textarea name="sources">{contentText("sources")}</textarea></label>
        <label class="studio-field"><span>Cultural context</span><textarea name="cultural_context">{contentText("cultural_context")}</textarea></label>
        <label class="studio-field studio-field--full"><span>Permissions and unresolved rights</span><textarea name="permissions">{contentText("permissions")}</textarea></label>
        <label class="studio-field studio-field--full"><span>Artwork brief</span><textarea name="artwork_brief">{contentText("artwork_brief")}</textarea></label>
        <label class="studio-field"><span>Artwork rights status</span><textarea name="rights_status">{contentText("rights_status")}</textarea></label>
        <label class="studio-field"><span>Production notes</span><textarea name="production_notes">{contentText("production_notes")}</textarea></label>
        <div class="studio-field--full"><button class="studio-button" type="submit">Save new version</button></div>
      </form>
    </section>
    <section class="studio-panel" aria-labelledby="card-history-heading">
      <p class="studio-kicker">Recoverable history</p>
      <h2 id="card-history-heading">Card versions</h2>
      <ul class="studio-list">
        {versions.map((version, index) => (
          <li class="studio-card">
            <div class="studio-card__row">
              <div><h3>Version {version.version_number}</h3><p>{new Date(version.created_at).toLocaleString("en-NZ", { dateStyle: "medium", timeStyle: "short" })}</p></div>
              {index > 0 ? (
                <form method="post" action={`/api/studio/cards/${card.id}/restore`}>
                  <input type="hidden" name="project_id" value={projectId} />
                  <input type="hidden" name="version_id" value={version.id} />
                  <button class="studio-link-button" type="submit">Restore this version</button>
                </form>
              ) : <span class="studio-status">Current</span>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
