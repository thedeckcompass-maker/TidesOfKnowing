---
import {workbookCardDestination} from '../../../../../lib/studio/navigation';
import SymbolVisualDesk from '../../../../../components/studio/SymbolVisualDesk.astro';
import CardWritingDesk from "../../../../../components/studio/CardWritingDesk.astro";
import DeckVisualWorkspace from "../../../../../components/studio/DeckVisualWorkspace.astro";
import { rightsReadingText } from '../../../../../lib/studio/readingText';
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import LocalCardArtwork from "../../../../../components/studio/LocalCardArtwork.astro";
import StudioHeader from "../../../../../components/studio/StudioHeader.astro";
import StudioEditorialSaveBar from "../../../../../components/studio/StudioEditorialSaveBar.astro";
import StudioVersionHistory from "../../../../../components/studio/StudioVersionHistory.astro";
import { studioReadAccessResponse, studioProjectWriteAccessResponse } from "../../../../../lib/studio/access";
import { getStudioCard, getStudioCardVersions, getStudioProjectWorkspace } from "../../../../../lib/studio/queries";
import "../../../../../styles/studio.css";

export const prerender = false;
const projectId = Astro.params.id;
const cardId = Astro.params.cardId;
const accessResponse = await studioReadAccessResponse(Astro.locals.user, Astro.locals.profile, Astro.locals.supabase);
if (accessResponse) return accessResponse;
const canWrite = !await studioProjectWriteAccessResponse(Astro.locals.user, Astro.locals.profile, Astro.locals.supabase, projectId);
if (!projectId || !cardId || !Astro.locals.supabase) return new Response(null, { status: 404 });
const [workspace, card, versions] = await Promise.all([
  getStudioProjectWorkspace(Astro.locals.supabase, projectId),
  getStudioCard(Astro.locals.supabase, projectId, cardId),
  getStudioCardVersions(Astro.locals.supabase, projectId, cardId),
]);
if (!workspace.project || workspace.project.owner_id !== Astro.locals.user?.id || !card) return new Response(null, { status: 404 });
const content = card.content ?? {};
const contentText = (key: string) => typeof content[key] === "string" ? content[key] as string : "";
const linkedGuidebookSections = workspace.guidebook.filter((section) => section.card_id === card.id);
const saved = Astro.url.searchParams.get("saved") === "1";
const created = Astro.url.searchParams.get("created") === "1";
const restored = Astro.url.searchParams.get("restored") === "1";
const restoredFrom = Astro.url.searchParams.get("restoredFrom");
const restoredVersion = Astro.url.searchParams.get("version");
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title={`${card.title} | Deck Creator Studio`} description="Private card-writing workspace." metaRobots="noindex, nofollow" tdcPlacement="none" memberWorkspace={false} bodyClass="tok-body--studio">
  <main class:list={["studio-page", "page-inner", { "studio-page--editing": canWrite }]}>
    <StudioHeader eyebrow={`${workspace.project.name} · ${card.card_number?'Card '+card.card_number:'Card writing'}`} title={card.title} lede={`Structured card writing · version ${card.version_number}`} projectId={projectId} />
<p><a href={`/studio/projects/${projectId}/my-deck/`}>Back to my cards</a></p><nav class="card-task-tabs" aria-label="Work on this card"><button type="button" data-card-task="writing" aria-pressed="true">Writing</button><button type="button" data-card-task="artwork" aria-pressed="false">Artwork</button></nav>
    {created ? <p class="studio-notice" role="status">Card created. Its first version has been recorded.</p> : null}
    {Astro.url.searchParams.get("unchanged") === "1" ? <p class="studio-notice" role="status">No changes to save. Your existing version is unchanged.</p> : null}
    {saved ? <p class="studio-notice" role="status">Card saved as a new version.</p> : null}
    {restoredFrom && restoredVersion && /^\d+$/.test(restoredFrom) && /^\d+$/.test(restoredVersion)
      ? <p class="studio-notice" role="status">Restored Version {restoredFrom} as Version {restoredVersion}. The previous version remains in history.</p>
      : restored ? <p class="studio-notice" role="status">Earlier content restored as a new current version.</p> : null}
    {error ? <p class="studio-notice" role="alert">{error}</p> : null}
    {!canWrite ? <p class="studio-notice" role="status">This card is available to read. Editing is paused while Studio access is read-only.</p> : null}
    <div class="card-expression-layout"><section class="studio-panel" data-card-task-panel="writing"><CardWritingDesk project={workspace.project} card={card} families={workspace.families} canWrite={canWrite} error={Boolean(error)}/></section><aside class="studio-panel" data-card-task-panel="artwork" hidden>{(Astro.locals as {studioLocalFolderIntegration?:boolean}).studioLocalFolderIntegration&&canWrite?<LocalCardArtwork project={workspace.project} card={card}/>:<>{!(workspace.project.settings as Record<string, any>)?.visual_design_v1?.deckConfigured?<><h2>Set your shared card size</h2><p>Choose the size once for this deck, then continue with this card’s artwork. You can refine the design later.</p><DeckVisualWorkspace mode="deck" project={workspace.project} cards={workspace.cards} card={card} canWrite={canWrite}/><a class="studio-button studio-button--secondary" data-artwork-continue hidden href={`/studio/projects/${projectId}/cards/${card.id}/?task=artwork`}>Continue to this card’s artwork</a></>:<DeckVisualWorkspace mode="card" project={workspace.project} cards={workspace.cards} card={card} canWrite={canWrite}/>}</>}<details><summary>Take an editorial pause</summary><p>What is the one thing you most want someone to understand? Which phrase sounds most like you?</p><a href={`/studio/projects/${projectId}/journey/`}>Revisit your Project Foundations</a></details></aside></div>
    <details class="studio-panel"><summary>Connected manuscript sections</summary><section aria-labelledby="card-guidebook-heading">
      <p class="studio-kicker">Connected manuscript</p>
      <h2 id="card-guidebook-heading">Guidebook writing for this card</h2>
      {linkedGuidebookSections.length ? (
        <ul class="studio-list">
          {linkedGuidebookSections.map((section) => (
            <li class="studio-card">
              <div class="studio-card__row">
                <div><p class="studio-meta">{section.section_type.replaceAll("_", " ")} · version {section.version_number}</p><h3>{section.title}</h3></div>
                <a class="studio-link-button" href={`/studio/projects/${projectId}/guidebook/${section.id}/`}>Open manuscript</a>
              </div>
            </li>
          ))}
        </ul>
      ) : <p class="studio-empty">No guidebook sections are linked to this card yet.</p>}
    </section>
    </details><p><a class="studio-link-button" href={workbookCardDestination(workspace.project.id,card.id)}>Review this card in the Project Workbook</a></p>
    <details class="studio-panel"><summary>Visual planning and card history</summary><SymbolVisualDesk project={workspace.project} cards={workspace.cards} cardId={card.id}/><StudioVersionHistory kind="card" versions={versions} projectId={projectId} resourceId={card.id} canWrite={canWrite} references={{ families: Object.fromEntries(workspace.families.map((family) => [family.id, family.name])) }} /></details>
  </main>
</BaseLayout>

<style>.card-expression-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:1.5rem;align-items:start}.card-expression-layout>section,.card-expression-layout>aside{min-width:0;grid-column:auto}.card-expression-layout>aside{position:sticky;top:1rem}.card-expression-layout aside details{margin-top:1.2rem}.card-expression-layout aside summary{cursor:pointer}@media(max-width:760px){.card-expression-layout{grid-template-columns:1fr}.card-expression-layout>aside{position:static}}</style>

<script>import "../../../../../scripts/cardTaskNavigation";</script>
<style>.card-expression-layout{display:block}.card-expression-layout>aside{position:static}.card-expression-layout>[hidden]{display:none!important}.card-task-tabs{display:flex;gap:1rem;margin:1rem 0}.card-task-tabs button{font:inherit;min-height:44px;padding:.6rem 1rem;background:#faf8f3;border:1px solid #8a6a1f}.card-task-tabs button[aria-pressed=true]{background:#d4b773}.card-task-tabs button:focus-visible{outline:3px solid #065e73;outline-offset:3px}</style>
