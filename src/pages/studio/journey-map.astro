---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ORIENTATION_CHAPTERS,MAP_TOOLS,localOrientation,orientationActor,mapContext,ownedMapContext,mapChapterHref,mapToolHref} from '../../lib/studio/orientation';
import {journeyMapSvg} from '../../lib/studio/journeyMap';
import '../../styles/studio.css';
export const prerender=false;
if(!orientationActor(Astro.locals))return new Response('Sign in with your existing account.',{status:401});

const context=await ownedMapContext(Astro.locals,mapContext(Astro.url.searchParams.get('from'),Astro.url.searchParams.get('chapter'),Astro.url.searchParams.get('tool')));
const work=Astro.url.searchParams.get('work');const returnContext=work?await ownedMapContext(Astro.locals,mapContext(work)):context;
---
<BaseLayout title="Your Studio journey map" description="Find your current Section and open another part of your project." studioWorkspace={true} tdcPlacement="none" metaRobots="noindex, nofollow" studioProjectId={context.projectId??undefined}>
<main class="studio-page page-inner journey-map-page"><p class="studio-eyebrow">Find a Section or project tool</p><h1>Your Studio journey map</h1><p class="studio-methodology-intro"><strong>The Eight Pillars</strong> brings together the Studio’s eight Sections below. Explore their questions, purpose and outputs as a reference; you can move between them as your creative work needs.</p><p class="map-location" role="status"><strong>You are here:</strong> {context.label}.</p><p><a class="studio-button studio-button--secondary" href={returnContext.returnTo}>Return to {returnContext.label}</a> <a href={"/studio/welcome/?from="+encodeURIComponent(returnContext.returnTo)}>Read the Studio welcome again</a></p><p>If you opened this map from your writing, its original tab stays open. Switch back to that tab to continue an unsaved draft; the return link here opens the saved page.</p><p>Select a Section to open its workspace. You can move between Sections at any time. The list below has the same links as the diagram.</p>
<div class="map-downloads"><a href="/studio-reference/studio-journey-map-a3.pdf" download>Download large map — landscape PDF</a><a href="/studio-reference/studio-journey-map-a4.pdf" download>Download printable journey reference — two pages</a><p>These are static reference copies, with no account or project content. Your live location is shown here, not updated inside the PDF.</p></div>
<p class="map-pan-help">On smaller screens, scroll the diagram sideways or use the complete list below.</p><div class="map-diagram" tabindex="0" role="region" aria-label="Journey diagram; scroll sideways to explore" set:html={journeyMapSvg(context)}/>
<section aria-labelledby="map-list-title"><h2 id="map-list-title">Follow the journey as a list</h2><ol class="map-list map-list--chapters">{ORIENTATION_CHAPTERS.map(c=><li aria-current={context.node===c.id?'location':undefined}><h3><a href={mapChapterHref(c.id,context.projectId)}>{c.number}. {c.name}</a>{context.node===c.id&&<span> — You are here</span>}</h3><p>{c.question}</p><p>{c.why}</p><p><strong>Your output:</strong> {c.output}.</p></li>)}</ol><h2>Tools for your cards, saved work, notes and support</h2><ul class="map-list">{MAP_TOOLS.map(t=><li aria-current={context.node===t.id?'location':undefined}><h3><a href={mapToolHref(t.id,context)}>{t.name}</a>{context.node===t.id&&<span> — You are here</span>}</h3><p>{t.text}</p></li>)}</ul></section>
</main></BaseLayout>
<style>.journey-map-page h1,.journey-map-page h2{font-family:'Playfair Display',Georgia,serif}.map-location{padding:1rem;background:#e3ebea;border-left:4px solid #496975;line-height:1.7}.map-location span{font-size:.9rem}.map-diagram{overflow:auto;margin:1.5rem 0;border:1px solid #cbc7bb;border-radius:5px}.map-diagram :global(svg){display:block;width:100%;min-width:880px;max-width:none;height:auto}.map-diagram :global(a:focus-visible){outline:5px solid #065e73;outline-offset:3px}.map-downloads{padding:1rem;background:#f0e9dc;display:flex;flex-wrap:wrap;gap:1rem}.map-downloads p{flex-basis:100%;margin:0;font-size:.85rem}.map-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding-left:1.5rem}.map-list--chapters{list-style:none}.map-list li{padding:1rem;border:1px solid #c8c6b9;border-radius:4px;background:#fbf8f0;line-height:1.6}.map-list li[aria-current]{border:3px solid #496975}.map-list h3{font-family:Georgia,serif;font-size:1.2rem}.map-list h3 a{text-decoration:underline;text-underline-offset:.2em}.map-list h3 span{display:block;font:600 .9rem/1.6 Inter,system-ui,sans-serif}@media(max-width:700px){.map-list{grid-template-columns:1fr}.map-location span{display:block}.map-downloads>a{flex-basis:100%}}</style>
