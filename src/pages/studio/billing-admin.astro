---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioHeader from '../../components/studio/StudioHeader.astro';
import '../../styles/studio.css';
if(!Astro.locals.user||Astro.locals.profile?.id!==Astro.locals.user.id||Astro.locals.profile.status!=='active'||Astro.locals.profile.role!=='admin')return new Response('Not found',{status:404});
Astro.response.headers.set('Cache-Control','private, no-store');
const key=crypto.randomUUID();
---
<BaseLayout title="Studio billing agreements | Tides of Knowing" description="Private billing administration." metaRobots="noindex, nofollow"><main class="studio-page page-inner"><StudioHeader title="Billing agreements"/><p><a href="/studio/account/#billing">Return to account</a></p>
<section><h2>Existing Create upgrade</h2><p>First verify the pending editorial purchase and preview unused prepaid Create value. Then record the explicit credit or refund choice. The final prorated value is verified at successful enrollment; no amount is taken from browser input.</p>
<form class="studio-form" data-billing-admin method="post" action="/api/studio/billing-admin"><input type="hidden" name="action" value="upgrade-preview"/><input type="hidden" name="key" value={key}/><label class="studio-field">Creator account ID <input name="ownerId" required/></label><label class="studio-field">Pending purchase reference <input name="purchaseId" required/></label><button class="studio-button" type="submit">Preview prepaid adjustment</button><p role="status" tabindex="-1"></p></form>
<form class="studio-form" data-billing-admin method="post" action="/api/studio/billing-admin"><input type="hidden" name="action" value="upgrade-approve"/><input type="hidden" name="key" value={key}/><label class="studio-field">Creator account ID <input name="ownerId" required/></label><label class="studio-field">Pending purchase reference <input name="purchaseId" required/></label><label class="studio-field">Verified quote reference <input name="quoteKey" required/></label><label class="studio-field">Agreement reference <input name="reference" maxlength="300" required/></label><label class="studio-field">Agreed adjustment <select name="adjustment" required><option value="">Choose the agreed method</option><option value="credit">Credit</option><option value="refund">Refund</option></select></label><label class="studio-check"><input type="checkbox" name="settlementProration" value="yes" required/>The creator's unused prepaid value will be preserved using verified proration at successful enrollment, with this agreed method.</label><button class="studio-button" type="submit">Record upgrade agreement</button><p role="status" tabindex="-1"></p></form></section>
<section><h2>Approved programme refund</h2><p>Record the agreement for an existing provider refund. This form does not issue a refund or calculate the later deferred cancellation policy. Access changes follow verified settlement.</p>
<form class="studio-form" data-billing-admin method="post" action="/api/studio/billing-admin"><input type="hidden" name="action" value="refund-record"/><input type="hidden" name="key" value={key}/><label class="studio-field">Creator account ID <input name="ownerId" required/></label><label class="studio-field">Original purchase reference <input name="purchaseId" required/></label><label class="studio-field">Provider refund reference <input name="refundId" required/></label><label class="studio-field">Agreement reference <input name="reference" maxlength="300" required/></label><label class="studio-field">Agreement kind <select name="kind" required><option value="">Choose the approved agreement</option><option value="full">Full refund</option><option value="partial">Partial refund</option></select></label><p>For partial refunds, enter every agreed retained allocation and a UTC access expiry. Completed work must be preserved.</p><label class="studio-field">Retained Create end (UTC ISO timestamp) <input name="createEndsAt"/></label><label class="studio-field">Total retained consultations <input name="consultations" type="number" min="0"/></label><label class="studio-field">Total retained written reviews <input name="reviews" type="number" min="0"/></label><label class="studio-field">Total retained groups <input name="groups" type="number" min="0"/></label><button class="studio-button" type="submit">Record refund agreement</button><p role="status" tabindex="-1"></p></form></section></main></BaseLayout>
<script>
for(const form of document.querySelectorAll<HTMLFormElement>('form[data-billing-admin]'))form.addEventListener('submit',async event=>{event.preventDefault();const output=form.querySelector<HTMLElement>('[role=status]')!,button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;try{const response=await fetch(form.getAttribute('action')!,{method:'POST',body:new FormData(form)}),result=await response.json();if(!response.ok)throw Error(result.error);output.textContent=result.quoteKey?`Verified preview: US$${(result.amountMinor/100).toFixed(2)}. Quote reference: ${result.quoteKey}.`:'Agreement recorded. Any payment/access change still requires verified provider completion.';}catch(error){output.textContent=error instanceof Error?error.message:'Agreement verification failed.';button.disabled=false;}});
</script>

<style>form[data-billing-admin],form[data-account-billing]{max-width:44rem;margin-block:1.5rem}form button{justify-self:start}form [role=status]{overflow-wrap:anywhere}</style>
