---
import {chooseAuthPersistence} from '../../lib/community/authPersistence';
import {authOrigin} from '../../lib/community/authOrigin';
import '../../styles/dcs-auth.css';
import { usernameError } from "../../lib/community/usernameRules";
import DcsPublicLayout from "../../layouts/DcsPublicLayout.astro";
import { json } from "../../lib/community/api";
import { cleanDisplayName } from "../../lib/community/auth";
import { safeAuthCallbackRedirect } from "../../lib/community/authCallback";
import { runAuthOtpRegisterFlow } from "../../lib/community/authOtpRegister";
import {
  createAuthOtpSubmissionId,
  normalizeAuthOtpClaimMode,
} from "../../lib/community/otpIdempotency";
import { authRedirect } from "../../lib/community/supabaseServer";
import { validateDisplayName } from "../../lib/community/validation";

export const prerender = false;

const returning = Astro.url.searchParams.get('mode') === 'sign-in';
if(returning && Astro.request.method==='GET' && Astro.url.searchParams.get('method')!=='link') return Astro.redirect('/auth/login/?redirectTo='+encodeURIComponent(safeAuthCallbackRedirect(Astro.url.searchParams.get('redirectTo')??'/community/account/')),303);
const title = (returning ? 'Sign in' : 'Create an account') + ' | Tides of Knowing';
const description = "Create your Deck Creator Studio account with your email and password.";
const GENERIC_SEND_ERROR = "Unable to complete this request right now. Please try again, or use Sign in if you already have an account.";

let error = "";
let errorReference = "";
const redirectTo = safeAuthCallbackRedirect(Astro.url.searchParams.get('redirectTo') ?? (returning ? '/community/account/' : '/studio/'));
const joinSubmissionId = createAuthOtpSubmissionId();

function prefersJsonResponse(request: Request): boolean {
  const accept = request.headers.get("accept") ?? "";
  return accept.includes("application/json");
}

function authErrorDetails(error: unknown) {
  if (!error || typeof error !== "object") {
    return {
      name: "UnknownAuthError",
      message: String(error),
      status: null,
      code: null,
    };
  }

  const authError = error as {
    name?: unknown;
    message?: unknown;
    status?: unknown;
    code?: unknown;
    error_code?: unknown;
    errorCode?: unknown;
  };
  const code = authError.code ?? authError.error_code ?? authError.errorCode;

  return {
    name: typeof authError.name === "string" ? authError.name : "AuthError",
    message: typeof authError.message === "string" ? authError.message : "No message returned.",
    status: typeof authError.status === "number" ? authError.status : null,
    code: typeof code === "string" ? code : null,
  };
}

function isExpectedReturningMemberPrivacyError(error: unknown): boolean {
  const details = authErrorDetails(error);
  const normalized = details.message.toLowerCase();
  const code = details.code?.toLowerCase() ?? "";

  return (
    code.includes("user_not_found") ||
    code.includes("signup") ||
    normalized.includes("user not found") ||
    normalized.includes("signup") ||
    normalized.includes("signups not allowed")
  );
}

function checkEmailRedirect(
  email: string,
  displayName: string,
  next: string,
  includeDisplayName: boolean,
) {
  const checkEmailUrl = new URL("/auth/check-email/", Astro.url);
  checkEmailUrl.searchParams.set("email", email);

  checkEmailUrl.searchParams.set("redirectTo", next);
  return authRedirect(checkEmailUrl.pathname + checkEmailUrl.search, Astro.cookies);
}

if (Astro.request.method === "POST") {
  const prefersJson = prefersJsonResponse(Astro.request);
  if(Astro.request.headers.get("origin")!==Astro.url.origin) return new Response("Invalid request origin",{status:403});
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  const authModeRaw = String(form.get("authMode") ?? "join");
  if(!['join','sign-in'].includes(authModeRaw))return json({ok:false,error:'Choose account creation or sign in. Use the confirmation page to request another confirmation email.'},400);
  const claimMode = normalizeAuthOtpClaimMode(authModeRaw);
  const isReturningMemberSignIn = claimMode === "sign-in";
  const desiredUsername = String(form.get("communityUsername") ?? "").trim();
  const requestedUsernameError = claimMode === "join" ? usernameError(desiredUsername) : null;
  const firstName=String(form.get('firstName')??'').trim(), lastName=String(form.get('lastName')??'').trim();
  const combinedName=[firstName,lastName].filter(Boolean).join(' ');
  const password=String(form.get('password')??'');
  const passwordError=claimMode==='join'?(!firstName||!lastName||firstName.length>60||lastName.length>60?'Enter your first and last name, up to 60 characters each.':password.length<12||password.length>128?'Use a password between 12 and 128 characters.':password!==String(form.get('confirmPassword')??'')?'The passwords do not match.':null):null;
  const displayName=cleanDisplayName(combinedName);
  const displayNameValidation = claimMode === "join"
    ? validateDisplayName(combinedName)
    : ({ ok: true, value: { displayName: "" } } as const);
  const next = safeAuthCallbackRedirect(String(form.get('redirectTo') ?? '/community/account/'));
  const submissionId = String(form.get("submissionId") ?? "").trim();
  const headerSubmissionId = Astro.request.headers.get("x-auth-submission-id")?.trim() ?? "";

  if (!Astro.locals.supabase) {
    if (prefersJson) {
      return json({ ok: false, error: "Account sign-in is temporarily unavailable." }, 503);
    }
    error = "Account sign-in is temporarily unavailable.";
  } else if(passwordError){
    if(prefersJson)return json({ok:false,error:passwordError},400);
    error=passwordError;
  } else if (requestedUsernameError) {
    if(prefersJson) return json({ok:false,error:requestedUsernameError},400);
    error=requestedUsernameError;
  } else if (!displayNameValidation.ok) {
    if (prefersJson) {
      return json({ ok: false, error: displayNameValidation.error }, 400);
    }
    error = displayNameValidation.error;
  } else if (!email || !email.includes("@")) {
    if (prefersJson) {
      return json({ ok: false, error: "Please enter a valid email address." }, 400);
    }
    error = "Please enter a valid email address.";
  } else {
    chooseAuthPersistence(Astro.cookies,Astro.request,form.get("rememberMe")==="on");
    const emailRedirectTo = new URL(
      `/auth/callback/?redirectTo=${encodeURIComponent(next)}`,
      authOrigin(Astro.locals,Astro.url),
    ).href;

    const flow = await runAuthOtpRegisterFlow(
      {
        submissionId,
        headerSubmissionId,
        authMode: claimMode,
        email,
        displayName,
        emailRedirectTo,
      },
      {
        locals: Astro.locals,
        isExpectedReturningMemberPrivacyError,
        signInWithOtp: async ({ email: otpEmail, emailRedirectTo: redirect, shouldCreateUser, displayName: otpDisplayName }) => {
          if(claimMode==='join'){
            const result=await Astro.locals.supabase!.auth.signUp({email:otpEmail,password,options:{emailRedirectTo:redirect,data:{first_name:firstName,last_name:lastName,display_name:otpDisplayName,requested_community_username:desiredUsername}}});
            return {error:result.error};
          }
          const result = await Astro.locals.supabase!.auth.signInWithOtp({
            email: otpEmail,
            options: {
              emailRedirectTo: redirect,
              shouldCreateUser: false,
              ...(otpDisplayName ? { data: { display_name: otpDisplayName, ...(shouldCreateUser ? {requested_community_username: desiredUsername} : {}) } } : {}),
            },
          });
          return { error: result.error };
        },
      },
    );

    if (flow.outcome === "accepted") {
      // JS clients need a readable same-origin body; browsers make 303 Location
      // opaque under fetch redirect:"manual". Non-JS keeps the redirect fallback.
      if (prefersJson) {
        return json({ ok: true });
      }
      return checkEmailRedirect(
        email,
        displayName,
        next,
        !isReturningMemberSignIn && Boolean(displayName),
      );
    }

    if (prefersJson) {
      const status =
        flow.reason === "missing_submission"
          ? 400
          : flow.reason === "claim_unavailable"
            ? 503
            : 500;
      return json(
        { ok: false, error: GENERIC_SEND_ERROR, reference: flow.invocationId },
        status,
      );
    }

    errorReference = flow.invocationId;
    if (flow.reason === "missing_submission") {
      error = "Unable to send a sign-in link right now. Please try again from the sign-in form.";
    } else if (flow.reason === "claim_unavailable") {
      error = GENERIC_SEND_ERROR;
    } else {
      error = GENERIC_SEND_ERROR;
    }
  }
}
---

<DcsPublicLayout page="checkout" title={title} description={description} metaRobots="noindex, nofollow">
  <div class="auth-page page-inner dcs-auth">
    <section class="auth-card" aria-labelledby="auth-heading">
      <div data-auth-entry>
        <p class="auth-kicker">Tides of Knowing · Deck Creator Studio</p>
        <h1 id="auth-heading">{returning ? "Email sign-in link" : "Create your Studio account"}</h1>
        <p>{returning ? <span>New here? <a href={"/auth/register/?redirectTo="+encodeURIComponent(redirectTo)}>Create an account</a></span> : <span>Already have an account? <a href={"/auth/login/?redirectTo="+encodeURIComponent(redirectTo)}>Sign in</a></span>}</p>
        <p>Secure email links remain available for your existing account. You can also set a password and sign in directly. If you cannot access that email address, contact hello@tidesofknowing.com.</p>
        <p class="auth-lede">
          {returning ? "Enter the email address you used to create your account. We'll send a secure sign-in link if an account exists." : "Create one account for Tides of Knowing and Deck Creator Studio. Your name stays private; your username appears in the community. Confirm your email to finish setting up your account."}
        </p>

        {
          error ? (
            <div class="auth-notice auth-notice--error">
              <p>{error}</p>
              {errorReference ? <p>Reference: {errorReference}</p> : null}
            </div>
          ) : null
        }

        <form method="post" action={returning ? `/auth/register/?mode=sign-in&method=link&redirectTo=${encodeURIComponent(redirectTo)}` : `/auth/register/?mode=join&redirectTo=${encodeURIComponent(redirectTo)}`} class="auth-form" data-auth-register-form data-auth-purpose={returning?'link':'signup'}>
          <input type="hidden" name="authMode" value={returning ? "sign-in" : "join"} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <input type="hidden" name="submissionId" value={joinSubmissionId} />
          <label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required />
          {!returning && <>
          <fieldset class="register-name"><legend>Name</legend><div><label>First name<input name="firstName" autocomplete="given-name" maxlength="60" required /></label><label>Last name<input name="lastName" autocomplete="family-name" maxlength="60" required /></label></div></fieldset>
          <label for="communityUsername">Username</label><input id="communityUsername" name="communityUsername" type="text" minlength="3" maxlength="24" pattern="[A-Za-z][A-Za-z0-9]{2,23}" autocomplete="username" required aria-describedby="register-username-help"/><p id="register-username-help">Letters and numbers only, starting with a letter. Your name is not shown publicly.</p>
          {['password','confirmPassword'].map(name=><div class="register-password"><label for={name}>{name==='password'?'Password':'Confirm password'}</label><div><input id={name} name={name} type="password" autocomplete="new-password" minlength="12" maxlength="128" required/><button type="button" data-register-password={name} aria-controls={name} aria-pressed="false" aria-label={name==='password'?'Show password':'Show confirmation password'} hidden>Show password</button></div></div>)}
          <p>Use a unique password of 12–128 characters.</p></>}
          <label class="remember-choice"><input type="checkbox" name="rememberMe"/> Keep me signed in on this browser</label>
          <button
            type="submit"
            data-auth-register-submit
            data-sending-text={returning?'Requesting sign-in link…':'Creating your account…'}
          >
            {returning?'Request sign-in link':'Create account'}
          </button>
          <p class="auth-submit-status" data-auth-register-status hidden>
            Please wait while we process your request.
          </p>
        </form>
      </div>
      <div class="auth-confirmation" data-auth-confirmation hidden>
        <h2>✓ Check your email</h2>
        <p>
          Check your email for {returning?'a sign-in link':'your account confirmation'}:
          <strong data-auth-confirmation-email></strong>
        </p>
        <p>Open the email to confirm your address and return to Deck Creator Studio. This screen does not confirm delivery.</p>
        <p>If it doesn't arrive within a minute or two, check your Spam or Promotions folder.</p>
        <p><a href="/auth/confirm-email/">Request another confirmation email</a> or <a href="/auth/login/?redirectTo=%2Fstudio%2F">sign in</a>.</p>
      </div>
    </section>
  </div>
</DcsPublicLayout>

<script>
  import { bindAuthRegisterForms } from "../../lib/community/authRegisterForm";

  const password=document.querySelector<HTMLInputElement>('#password'), confirmation=document.querySelector<HTMLInputElement>('#confirmPassword');
  const validatePasswords=()=>confirmation?.setCustomValidity(confirmation.value!==password?.value?'The passwords do not match.':'');
  password?.addEventListener('input',validatePasswords);confirmation?.addEventListener('input',validatePasswords);
  for(const button of document.querySelectorAll<HTMLButtonElement>('[data-register-password]')){
    const input=document.getElementById(button.dataset.registerPassword??'');if(!(input instanceof HTMLInputElement))continue;
    button.hidden=false;button.addEventListener('pointerdown',e=>{if(document.activeElement===input)e.preventDefault();});
    button.addEventListener('click',()=>{const start=input.selectionStart,end=input.selectionEnd,show=input.type==='password';input.type=show?'text':'password';if(start!==null&&end!==null)requestAnimationFrame(()=>{if(document.activeElement===input)input.setSelectionRange(start,end)});button.textContent=show?'Hide password':'Show password';button.setAttribute('aria-pressed',String(show));button.setAttribute('aria-label',(show?'Hide ':'Show ')+(input.name==='confirmPassword'?'confirmation password':'password'));});
  }
  bindAuthRegisterForms({
    cardSelector: ".auth-card",
    confirmedClass: "auth-card--confirmed",
    defaultButtonText: document.querySelector<HTMLFormElement>('[data-auth-register-form]')?.dataset.authPurpose==='signup'?'Create account':'Request sign-in link',
  });
</script>

<style>
  .auth-page {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--tok-header-height));
    padding: clamp(0.9rem, 3vw, 2rem) 0 clamp(3rem, 8vw, 5rem);
  }

  .auth-page::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: "";
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--tok-deep-ocean) 8%, transparent),
        transparent 55%
      ),
      url("/images/community/compass-feather-hourglass.png") right top / min(48vw, 36rem) auto no-repeat;
    opacity: 0.12;
    pointer-events: none;
  }

  .auth-page::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--tok-surface-reading) 82%, transparent),
      color-mix(in srgb, var(--tok-surface-reading) 58%, transparent)
    );
    pointer-events: none;
  }

  .auth-card {
    max-width: 34rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--tok-gold) 35%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--tok-surface-reading) 82%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .auth-kicker {
    margin: 0 0 0.5rem;
    font-size: var(--tok-type-meta);
    letter-spacing: var(--tok-letter-upper);
    text-transform: uppercase;
    color: var(--tok-gold-deep);
  }

  .auth-card h1 {
    margin: 0 0 0.45rem;
    font-family: var(--font-accent);
    font-size: clamp(2rem, 6vw, 2.8rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--tok-water);
  }

  .auth-lede,
  .auth-alt,
  .auth-confirmation p {
    color: var(--tok-text-muted);
    line-height: 1.55;
  }

  .auth-form {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .auth-form[hidden] {
    display: none;
  }

  [data-auth-entry][hidden] {
    display: none;
  }

  .auth-card--confirmed [data-auth-entry] {
    display: none !important;
  }

  .auth-card--confirmed .auth-confirmation {
    margin-top: 0;
  }

  .auth-form label {
    font-size: var(--tok-type-label);
    font-weight: 700;
  }

  .auth-form label span,
  .auth-help {
    color: var(--tok-text-muted);
    font-weight: 400;
  }

  .auth-help {
    margin: -0.35rem 0 0.25rem;
    font-size: var(--tok-type-meta);
    line-height: 1.5;
  }

  .auth-form input {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--tok-border-light);
    border-radius: var(--radius-control);
    background: var(--tok-surface-reading);
    color: var(--tok-text-dark);
  }

  .auth-form button {
    justify-self: start;
    padding: var(--tok-ui-btn-pad-y) var(--tok-ui-btn-pad-x);
    border: 0;
    border-radius: var(--radius-control);
    background: var(--tok-btn-filled-bg);
    color: var(--tok-btn-filled-fg);
    font-weight: var(--tok-ui-btn-font-weight);
    cursor: pointer;
  }

  .auth-submit-status {
    margin: -0.35rem 0 0;
    color: var(--tok-text-muted);
    font-size: var(--tok-type-meta);
    line-height: 1.5;
  }

  .auth-confirmation {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--tok-teal) 34%, transparent);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--tok-teal) 7%, var(--tok-surface-reading) 93%);
  }

  .auth-confirmation[hidden] {
    display: none;
  }

  .auth-confirmation h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    letter-spacing: normal;
    text-transform: none;
    color: var(--tok-water);
  }

  .auth-confirmation p {
    margin: 0;
  }

  .auth-confirmation strong {
    display: block;
    margin-top: 0.2rem;
    color: var(--tok-text-dark);
    font-weight: 800;
  }

  .auth-confirmation button {
    justify-self: start;
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--tok-gold) 42%, transparent);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--tok-water);
    font-weight: var(--tok-ui-btn-font-weight);
    cursor: pointer;
  }

  .auth-notice {
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-control);
    line-height: 1.6;
  }

  .auth-notice p {
    margin: 0;
  }

  .auth-notice p + p {
    margin-top: 0.35rem;
  }

  .auth-notice--error {
    border: 1px solid color-mix(in srgb, #b42318 45%, transparent);
  }
</style>

<style>.register-name{border:0;padding:0;margin:0;min-width:0}.register-name>div{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.register-name label,.register-password{display:grid;gap:.4rem}.register-password>div{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap}.register-password input{flex:1 1 12rem;min-width:0}.register-password button{padding:.45rem .7rem;min-height:2.75rem;font-size:.9rem}.register-password button[hidden]{display:none}@media(max-width:420px){.register-name>div{grid-template-columns:1fr}}</style>

<style>.remember-choice{display:flex;align-items:center;gap:.6rem}.remember-choice input{width:auto;min-width:1rem}</style>
