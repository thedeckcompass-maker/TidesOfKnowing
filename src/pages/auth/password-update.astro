---
import PasswordAuth from '../../components/PasswordAuth.astro';
export const prerender=false;
const mode='update';


import {authOrigin} from '../../lib/community/authOrigin';
import {passwordAction} from '../../lib/community/passwordAuth';
import {safeAuthCallbackRedirect} from '../../lib/community/authCallback';
import {authRedirect} from '../../lib/community/supabaseServer';

const next=safeAuthCallbackRedirect(Astro.url.searchParams.get('redirectTo')??'/studio/');
const heading=mode==='forgot'?'Set or reset your password':mode==='update'?'Choose your password':'Sign in';
let error='',message='';
if(Astro.request.method==='POST') {
 if(Astro.request.headers.get('origin')!==Astro.url.origin){Astro.response.status=403;error='Invalid request. Please reload this page.';}
 else if(!Astro.locals.supabase){Astro.response.status=503;error='Sign-in is temporarily unavailable.';}
 else {const result=await passwordAction(Astro.locals.supabase.auth,mode,await Astro.request.formData(),authOrigin(Astro.locals,Astro.url));error=result.error??'';message=result.message??'';if(result.success)message='Password updated successfully';if(error)Astro.response.status=400;}
}
if(mode==='update'&&!error){const result=await Astro.locals.supabase?.auth.getUser();if(!result?.data.user){error='Open your reset email or sign in with a secure link before choosing a password.';Astro.response.status=401;}}
---
<PasswordAuth mode={mode} next={next} error={error} message={message}/>
