    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/markdown-remark": "7.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "astro": "7.4.4",
    "pg": "^8.23.1",
    "resend": "6.37.0",
    "stripe": "^22.2.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "14.3.3",
    "puppeteer": "25.16.0",
    "sharp": "0.35.5",
    "wrangler": "4.156.0"
  }
