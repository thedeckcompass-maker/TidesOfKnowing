    "audit:rcm-integrity": "node scripts/audit-rcm-integrity.mjs",
    "test:rcm-eof-normalise": "node scripts/normalise-rcm-eof.test.mjs",
    "test:ask-leilia-reviews": "node scripts/ask-leilia-reviews.test.mjs",
    "test:ask-leilia-admin": "node scripts/ask-leilia-admin.test.mjs",
    "test:ask-leilia-payment-validation": "node scripts/ask-leilia-payment-validation.test.mjs",
    "test:compass-cohorts": "node scripts/compass-cohorts.test.mjs",
    "test:compass-fulfilment": "node scripts/compass-fulfilment.test.mjs",
    "test:member-workspace-nav": "node scripts/member-workspace-nav.test.mjs",
    "test:studio-access": "node scripts/studio-access.test.mjs",
    "test:studio-foundation": "node scripts/studio-project-foundation.test.mjs",
    "test:bird-oracle-import": "node scripts/bird-oracle-import.test.mjs",
    "studio:import-bird-oracle": "node scripts/import-aotearoa-bird-oracle.mjs",
    "test:reading-library": "node scripts/reading-library.test.mjs",
